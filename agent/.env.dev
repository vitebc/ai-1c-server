# Dev-окружение: копия в .env (cp .env.dev .env) перед docker compose up.
# Отличия от prod: порт 8001, PG 5435, JWT выключен (Basic auth), fake-эмбеддинги.
# LLM, базы 1С, агрегатор — те же что в prod.

# --- LLM: локальная (GPU-сервер) ---
LLM_BASE_URL=http://192.168.170.105:12600/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b-1C

# --- Агентская петля ---
AGENT_MAX_ROUNDS=15
AGENT_MAX_CONSECUTIVE_ERRORS=3

# --- Postgres (dev: отдельный volume, порт 5435) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agentdb
POSTGRES_PORT=5435
POSTGRES_DATA_DIR=dev-postgres-data
BACKEND_PORT=8001
BACKEND_IMAGE=1c-ai-agent-backend:dev
# Внутри compose бэкенд ходит на postgres:5432 (переопределяется compose),
# но ВНЕ compose (alembic, scripts/ingest_kb.py с хоста) нужен явный адрес —
# иначе сработает дефолт на 5432 и скрипт ударит по prod-БД.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5435/agentdb

# --- Эмбеддинги: llama.cpp-server с Qwen3-Embedding-4B (2560 измерений) ---
EMBEDDINGS_PROVIDER=llamacpp
EMBEDDINGS_BASE_URL=http://192.168.60.105:12700/v1
EMBEDDINGS_MODEL=qwen3

# --- 1С: live (ходим в живые базы под mock-пользователем agent) ---
ONEC_MODE=live
ONEC_USERNAME=agent
ONEC_PASSWORD=agent007
# Per-user RLS выключен: JWT_SECRET пуст → Basic auth под ONEC_USERNAME.
JWT_SECRET=
# Мапа баз (те же что в prod).
ONEC_BASES=doc3_test=http://192.168.0.69:81/doc3_test;ai_base=http://192.168.60.9/ai_base;ca2_otchet_zhvv=http://192.168.0.49/ca2_otchet
ONEC_BASES_FILE=

# --- Агрегирующий MCP (тот же что в prod) ---
AGG_MCP_URL=http://192.168.60.39:9224/api/mcp-aggregated/mcp
AGG_MCP_TOKEN=
AGG_MCP_CACHE_TTL=300

# Порог авто-матчинга скила (llamacpp): по замерам верные матчи 0.77+, шум <0.64.
SKILL_MATCH_THRESHOLD=0.70
