#Область ПрограммныйИнтерфейс

// Единая точка настройки адреса gateway OpenCode.
// Все функции модуля вызывают эту функцию вместо хардкода.
Функция АдресСервераПоУмолчанию() Экспорт

	Возврат "http://192.168.60.39:9020";

КонецФункции

// Точка входа фонового задания (ФоновыеЗадания.Выполнить требует метод общего
// модуля — вызов из модуля формы платформа отклоняет).
// Обмен с сервером OpenCode (v2 API, Basic auth):
//   - ИдСессииСтрокой пусто  -> POST /api/session {title, agent, model} (новая сессия);
//   - ИдСессииСтрокой задан  -> POST /api/session/{sid}/prompt {text}.
// prompt возвращает только квитанцию о приёме сообщения пользователя; ответ
// модели приходит асинхронно. Поэтому: ждём idle (POST .../wait), затем читаем
// GET /api/session/{sid}/message и собираем из него текст, модель и токены.
// Возвращает структуру результата; платформа сама кладёт её во временное
// хранилище, адрес доступен как ФоновоеЗадание.АдресРезультата.
Функция ВыполнитьЗапрос(Знач ТекстПромпта, Знач АдресСервера, Знач ИдСессииСтрокой = "", Знач АгентСтрокой = "assistant") Экспорт

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = АдресСервераПоУмолчанию();
	КонецЕсли;

	ПараметрыАдреса = РазобратьАдресСервера(Адрес);

	СообщитьПрогрессБСП(10, НСтр("ru = 'Размышляю...'"));

	// Новая сессия: модель и агент задаются при создании (в prompt сервер их
	// игнорирует). Без явной модели запрос уходит на free-провайдер OpenCode
	// (flint-40b-free) и падает 429 provider.free-limit.
	Если ПустаяСтрока(ИдСессииСтрокой) Тогда
		НоваяСессия = СоздатьСессию(ПараметрыАдреса, Адрес, АгентСтрокой, ТекстПромпта);
		Если НоваяСессия.ЭтоОшибка Тогда
			Возврат НовыйРезультат(Истина, НоваяСессия.ТекстОшибки, "");
		КонецЕсли;
		ИдСессииСтрокой = НоваяСессия.ИдентификаторСессии;
		СообщитьПрогрессБСП(40, НСтр("ru = 'Формирование ответа...'"));
	КонецЕсли;

	// Вопрос в сессию: сервер принимает сообщение и запускает цикл агента,
	// ответ возвращается квитанцией (тип "user"). Ожидание и разбор ответа — ниже.
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("text", ТекстПромпта);
	СтрокаJSON = ЗаписатьСтрокуJSON(ТелоЗапроса);

	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/session/" + ИдСессииСтрокой + "/prompt", СтрокаJSON);
	Исключение
		Возврат НовыйРезультат(Истина, ТекстОшибкиСоединения(), "");
	КонецПопытки;

	// 404 — сессия исчезла (например, после перезапуска сервера). Прозрачно
	// создаём новую и повторяем отправку один раз.
	Если ОтветHTTP.КодСостояния = 404 И Не ПустаяСтрока(ИдСессииСтрокой) Тогда
		НоваяСессия = СоздатьСессию(ПараметрыАдреса, Адрес, АгентСтрокой, ТекстПромпта);
		Если НоваяСессия.ЭтоОшибка Тогда
			Возврат НовыйРезультат(Истина, НоваяСессия.ТекстОшибки, "");
		КонецЕсли;
		ИдСессииСтрокой = НоваяСессия.ИдентификаторСессии;

		Попытка
			ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/session/" + ИдСессииСтрокой + "/prompt", СтрокаJSON);
		Исключение
			Возврат НовыйРезультат(Истина, ТекстОшибкиСоединения(), "");
		КонецПопытки;
	КонецЕсли;

	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат НовыйРезультат(Истина, ТекстОшибкиСервера(ОтветHTTP.КодСостояния, ТелоОтвета(ОтветHTTP)), "");
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Тогда
		Возврат НовыйРезультат(Истина, НСтр("ru = 'Сервер OpenCode вернул некорректный ответ.'"), "");
	КонецЕсли;

	// Квитанция: время создания пользовательского сообщения (часы сервера) —
	// по нему отбираем сообщения ответа, созданные после нашего запроса.
	ВремяНачала = 0;
	Попытка
		Если Данные.data.Свойство("time") И Данные.data.time.Свойство("created") Тогда
			ВремяНачала = Число(Данные.data.time.created);
		КонецЕсли;
	Исключение
	КонецПопытки;

	СообщитьПрогрессБСП(50, НСтр("ru = 'Ожидание ответа...'"));

	// Ждём, пока цикл агента не станет idle (включая все итерации tool-calls).
	// Таймаут соединения 300 с — при превышении платформа прервёт ожидание.
	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/experimental/session/" + ИдСессииСтрокой + "/wait", "");
	Исключение
		ПрерватьСессию(ПараметрыАдреса, ИдСессииСтрокой);
		Возврат НовыйРезультат(Истина, НСтр("ru = 'Сервер не ответил за 5 минут. Запрос прерван — попробуйте ещё раз.'"), "");
	КонецПопытки;

	Если ОтветHTTP.КодСостояния <> 204 Тогда
		ПрерватьСессию(ПараметрыАдреса, ИдСессииСтрокой);
		Возврат НовыйРезультат(Истина, ТекстОшибкиСервера(ОтветHTTP.КодСостояния, ТелоОтвета(ОтветHTTP)), "");
	КонецЕсли;

	СообщитьПрогрессБСП(90, НСтр("ru = 'Формирование ответа...'"));

	// Ответ модели — из списка сообщений сессии (новые первыми).
	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "GET", "/api/session/" + ИдСессииСтрокой + "/message?order=desc&limit=30", "");
	Исключение
		Возврат НовыйРезультат(Истина, ТекстОшибкиСоединения(), "");
	КонецПопытки;

	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат НовыйРезультат(Истина, ТекстОшибкиСервера(ОтветHTTP.КодСостояния, ТелоОтвета(ОтветHTTP)), "");
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Тогда
		Возврат НовыйРезультат(Истина, НСтр("ru = 'Сервер OpenCode вернул некорректный ответ.'"), "");
	КонецЕсли;

	ОтветАссистента = СобратьОтветАссистента(Данные.data, ВремяНачала);
	Если ОтветАссистента.ЭтоОшибка Тогда
		Возврат НовыйРезультат(Истина, ОтветАссистента.ТекстОшибки, "");
	КонецЕсли;

	РезультатФона = НовыйРезультат(Ложь, "", ОтветАссистента.Текст);
	РезультатФона.Вставить("ИдентификаторСессии", ИдСессииСтрокой);
	РезультатФона.МодельОтвета = ОтветАссистента.Модель;
	РезультатФона.ВсегоТокенов = ОтветАссистента.Токены;
	РезультатФона.ВремяОтветаСекунд = ОтветАссистента.Секунды;
	Возврат РезультатФона;

КонецФункции

// Заголовок сессии для списка OpenCode: «1С: [Фамилия И.] <20 символов промпта> (ДД.ММ ЧЧ:ММ)».
// Позволяет различать сессии из формы в UI сервера.
Функция СформироватьЗаголовокСессии(Знач ТекстПромпта)

	ИмяПользователя = "";
	Попытка
		Наименование = Пользователи.ТекущийПользователь().Наименование;
		// Ожидаем формат «Фамилия Имя Отчество» — берём Фамилию и инициал имени.
		НаименованиеСокр = СокрЛП(Наименование);
		ПозицияПробела = СтрНайти(НаименованиеСокр, " ");
		Если ПозицияПробела > 1 Тогда
			Фамилия = Лев(НаименованиеСокр, ПозицияПробела - 1);
			Имя = СокрЛП(Сред(НаименованиеСокр, ПозицияПробела + 1));
			Если Не ПустаяСтрока(Имя) Тогда
				ИмяПользователя = Фамилия + " " + Лев(Имя, 1) + ".";
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Пользователь не определён — заголовок без имени.
	КонецПопытки;

	ФрагментПромпта = СокрЛП(СтрЗаменить(СокрЛП(ТекстПромпта), Символы.ПС, " "));
	Если СтрДлина(ФрагментПромпта) > 20 Тогда
		ФрагментПромпта = Лев(ФрагментПромпта, 20) + "…";
	КонецЕсли;

	ВремяСоздания = Формат(ТекущаяДата(), "ДФ=""дд.ММ ЧЧ:мм""");

	Если ПустаяСтрока(ИмяПользователя) Тогда
		Возврат СтрШаблон("1С: %1 (%2)", ФрагментПромпта, ВремяСоздания);
	КонецЕсли;

	Возврат СтрШаблон("1С: [%1] %2 (%3)", ИмяПользователя, ФрагментПромпта, ВремяСоздания);

КонецФункции

// Создание сессии OpenCode (POST /api/session). Возвращает структуру
// {ЭтоОшибка, ТекстОшибки, ИдентификаторСессии}. Модель и агент задаются при
// создании — в prompt сервер их игнорирует.
Функция СоздатьСессию(Знач ПараметрыАдреса, Знач АдресСервера, Знач АгентСтрокой, Знач ТекстПромпта = "")

	Модель = ПолучитьМодельПоУмолчанию(АдресСервера);
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("title", СформироватьЗаголовокСессии(ТекстПромпта));
	Если ЗначениеЗаполнено(АгентСтрокой) Тогда
		ТелоЗапроса.Вставить("agent", АгентСтрокой);
	КонецЕсли;
	Если Модель <> Неопределено Тогда
		МодельJSON = Новый Структура;
		МодельJSON.Вставить("providerID", Модель.ProviderID);
		МодельJSON.Вставить("id", Модель.ModelID);
		ТелоЗапроса.Вставить("model", МодельJSON);
	КонецЕсли;

	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/session", ЗаписатьСтрокуJSON(ТелоЗапроса));
	Исключение
		Возврат НовыйРезультат(Истина, ТекстОшибкиСоединения(), "");
	КонецПопытки;

	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат НовыйРезультат(Истина, ТекстОшибкиСервера(ОтветHTTP.КодСостояния, ТелоОтвета(ОтветHTTP)), "");
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Тогда
		Возврат НовыйРезультат(Истина, НСтр("ru = 'Сервер OpenCode вернул некорректный ответ на создание сессии.'"), "");
	КонецЕсли;

	Результат = НовыйРезультат(Ложь, "", "");
	Результат.Вставить("ИдентификаторСессии", Данные.data.id);
	Возврат Результат;

КонецФункции

// Сборка ответа ассистента из списка сообщений сессии (GET /message, desc).
// Берём сообщения type="assistant" с time.created >= ВремяНачала, склеиваем
// текстовые части. Служебные типы (compaction, idle) игнорируются.
// Возвращает структуру {ЭтоОшибка, ТекстОшибки, Текст, Модель, Токены, Секунды}.
Функция СобратьОтветАссистента(Знач МассивСообщений, Знач ВремяНачала)

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Текст", "");
	Результат.Вставить("Модель", "");
	Результат.Вставить("Токены", 0);
	Результат.Вставить("Секунды", 0);

	Если ТипЗнч(МассивСообщений) <> Тип("Массив") Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Сервер OpenCode вернул некорректный список сообщений.'");
		Возврат Результат;
	КонецЕсли;

	// Список приходит новыми первыми — переворачиваем для склейки по порядку.
	СообщенияАссистента = Новый Массив;
	Для Каждого Сообщение Из МассивСообщений Цикл
		Попытка
			Если Не Сообщение.Свойство("type") Или Сообщение.type <> "assistant" Тогда
				Продолжить;
			КонецЕсли;
			ВремяСоздания = 0;
			Если Сообщение.Свойство("time") И Сообщение.time.Свойство("created") Тогда
				ВремяСоздания = Число(Сообщение.time.created);
			КонецЕсли;
			Если ВремяНачала > 0 И ВремяСоздания < ВремяНачала Тогда
				Продолжить;
			КонецЕсли;
			СообщенияАссистента.Добавить(Сообщение);
		Исключение
		КонецПопытки;
	КонецЦикла;

	// Переворот: старые сообщения первыми (для склейки текста).
	ОбратныйМассив = Новый Массив;
	Индекс = СообщенияАссистента.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ОбратныйМассив.Добавить(СообщенияАссистента[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

	ТекстОтвета = "";
	ТекстОшибкиМодели = "";
	Для Каждого Сообщение Из ОбратныйМассив Цикл
		Попытка
			// Ошибка модели/провайдера (finish="error" / error.message).
			Если Сообщение.Свойство("error") И Сообщение.error <> Неопределено Тогда
				Попытка
					Если Сообщение.error.Свойство("message") И ЗначениеЗаполнено(Сообщение.error.message) Тогда
						ТекстОшибкиМодели = СокрЛП(Сообщение.error.message);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			// Текстовые части (content[].type="text").
			Если Сообщение.Свойство("content") И ТипЗнч(Сообщение.content) = Тип("Массив") Тогда
				Для Каждого Часть Из Сообщение.content Цикл
					Попытка
						Если Часть.Свойство("type") И Часть.type = "text"
							И Часть.Свойство("text") И ЗначениеЗаполнено(Часть.text) Тогда
							ТекстОтвета = ТекстОтвета + Часть.text;
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;

			// Токены суммируются по всем сообщениям ответа.
			Если Сообщение.Свойство("tokens") И Сообщение.tokens <> Неопределено Тогда
				Попытка
					Результат.Токены = Результат.Токены + Число(Сообщение.tokens.input) + Число(Сообщение.tokens.output);
				Исключение
				КонецПопытки;
			КонецЕсли;

			// Модель берём из последнего сообщения (по времени создания).
			Если Сообщение.Свойство("model") И Сообщение.model <> Неопределено Тогда
				Попытка
					Если Сообщение.model.Свойство("id") И ЗначениеЗаполнено(Сообщение.model.id) Тогда
						Результат.Модель = Сообщение.model.id;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			// Время окончания — из последнего сообщения с completed.
			Если Сообщение.Свойство("time") И Сообщение.time.Свойство("completed") Тогда
				Попытка
					ВремяОкончания = Число(Сообщение.time.completed);
					Если ВремяНачала > 0 И ВремяОкончания > ВремяНачала Тогда
						Результат.Секунды = (ВремяОкончания - ВремяНачала) / 1000;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		Исключение
		// Ошибка разбора сообщения — пропускаем.
		КонецПопытки;
	КонецЦикла;

	Результат.Текст = ТекстОтвета;

	// Модель дала ошибку — показываем её, даже если текст есть.
	Если Не ПустаяСтрока(ТекстОшибкиМодели) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ТекстОшибкиМодели;
		Возврат Результат;
	КонецЕсли;

	// Ни одного сообщения ассистента — цикл не дал ответа (например, только
	// служебные шаги: скиллы, компакция). Понятный текст вместо пустой строки.
	Если СообщенияАссистента.Количество() = 0 Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Модель не вернула текстового ответа (только служебные шаги). Попробуйте ещё раз.'");
		Возврат Результат;
	КонецЕсли;

	// Сообщения были, но текста нет — тоже сообщаем явно.
	Если ПустаяСтрока(ТекстОтвета) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Модель выполнила действия, но не сформулировала текстовый ответ. Попробуйте ещё раз.'");
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Мягкое прерывание цикла агента при таймауте/ошибке ожидания (best effort).
Процедура ПрерватьСессию(Знач ПараметрыАдреса, Знач ИдСессии)

	Если ПустаяСтрока(ИдСессии) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/session/" + ИдСессии + "/interrupt", "");
	Исключение
		// Не критично — сессия и так станет idle или будет убита таймаутом.
	КонецПопытки;

КонецПроцедуры

// Прерывание хода по адресу сервера (вызывается из формы: она знает только
// строку адреса, а не разобранные параметры соединения).
Процедура ПрерватьСессиюПоАдресу(Знач АдресСервера, Знач ИдСессииСтрокой) Экспорт

	Если ПустаяСтрока(ИдСессииСтрокой) Тогда
		Возврат;
	КонецЕсли;

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = АдресСервераПоУмолчанию();
	КонецЕсли;

	ПрерватьСессию(РазобратьАдресСервера(Адрес), ИдСессииСтрокой);

КонецПроцедуры

// Текст ошибки соединения (таймаут, сетевой сбой) без стека.
Функция ТекстОшибкиСоединения()

	Возврат НСтр("ru = 'Не удалось связаться с сервером OpenCode (таймаут или сетевая ошибка). Попробуйте ещё раз.'");

КонецФункции

// Список агентов сервера для дропдауна формы: только mode="primary" и не hidden.
// Возвращает Массив структур {id, name}; пусто при ошибке (форма поставит дефолт).
Функция ПолучитьАгенты(Знач АдресСервера) Экспорт

	Результат = Новый Массив;
	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = АдресСервераПоУмолчанию();
	КонецЕсли;

	ПараметрыАдреса = РазобратьАдресСервера(Адрес);
	ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "GET", "/api/agent", "");
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		// Диагностика: показываем код HTTP и тело ответа — без этого форма
		// молча возвращает пустой список, а баннер лишь говорит «пусто».
		// Конструктор Массива не принимает аргументы (8.3) — собираем Добавить.
		МассивДиагностики = Новый Массив;
		МассивДиагностики.Добавить(СтрШаблон(
			"HTTP %1: %2", ОтветHTTP.КодСостояния, Лев(ТелоОтвета(ОтветHTTP), 300)));
		Возврат МассивДиагностики;
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Или ТипЗнч(Данные.data) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Агент Из Данные.data Цикл
		Попытка
			Если Агент.Свойство("mode") И Агент.mode = "primary"
				И (Не Агент.Свойство("hidden") Или Не Агент.hidden)
				И Агент.Свойство("id") И ЗначениеЗаполнено(Агент.id) Тогда
				Строка = Новый Структура;
				Строка.Вставить("id", Агент.id);
				Строка.Вставить("name", ?(Агент.Свойство("name") И ЗначениеЗаполнено(Агент.name), Агент.name, Агент.id));
				Результат.Добавить(Строка);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Понятный пользователю текст ошибки сервера. На осмысленные сбои OpenCode
// отдаёт JSON {"_tag": ..., "message": "..."} — показываем message; иначе общий
// текст с кодом HTTP. Стек и адреса в чат не выводятся.
Функция ТекстОшибкиСервера(Знач КодСостояния, Знач ТелоОтвета) Экспорт

	Текст = "";
	Если Не ПустаяСтрока(ТелоОтвета) Тогда
		Попытка
			Данные = ПрочитатьСтрокуJSON(ТелоОтвета);
			Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("message")
				И ТипЗнч(Данные.message) = Тип("Строка") Тогда
				Текст = СокрЛП(Данные.message);
			КонецЕсли;
		Исключение
			// Тело не JSON (прокси, шлюз) — покажем общий текст ниже.
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Текст = СтрШаблон(
			НСтр("ru = 'Сервер OpenCode вернул ошибку (HTTP %1). Попробуйте ещё раз; если повторяется — сообщите администратору.'"),
			КодСостояния);
	КонецЕсли;

	Возврат Текст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Модель по умолчанию для новых сессий: первый non-opencode провайдер из
// GET /api/provider и первая его модель. Неопределено при ошибке — тогда сервер
// выберет сам (риск free-limit, но запрос не падает на нашей стороне).
Функция ПолучитьМодельПоУмолчанию(Знач АдресСервера)

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = АдресСервераПоУмолчанию();
	КонецЕсли;

	ПараметрыАдреса = РазобратьАдресСервера(Адрес);
	ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "GET", "/api/provider", "");
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Или ТипЗнч(Данные.data) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Провайдер Из Данные.data Цикл
		Попытка
			Если Не (Провайдер.Свойство("id") И НРег(Провайдер.id) = "opencode")
				И Провайдер.Свойство("models") И ТипЗнч(Провайдер.models) = Тип("Массив")
				И Провайдер.models.Количество() > 0 Тогда
				ПерваяМодель = Провайдер.models[0];
				Если ПерваяМодель.Свойство("id") И ЗначениеЗаполнено(ПерваяМодель.id) Тогда
					Результат = Новый Структура;
					Результат.Вставить("ProviderID", Провайдер.id);
					Результат.Вставить("ModelID", ПерваяМодель.id);
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Единая точка отправки запроса на сервер OpenCode с Basic auth и таймаутами.
// Таймаут по умолчанию 300 с — для длинных ожиданий; опрос состояния хода
// передаёт короткий таймаут, чтобы форма не «замирала» на минуты.
Функция ОтправитьНаСервер(Знач ПараметрыАдреса, Знач Метод, Знач Путь, СтрокаJSON, Знач Таймаут = 300)

	Заголовки = Новый Соответствие;
	Если Не ПустаяСтрока(СтрокаJSON) Тогда
		Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;

	// Токен доступа 1С (per-user RLS): BSL не может переопределить заголовок
	// Authorization (он занят Basic-конструктором HTTPСоединения), поэтому шлём
	// токен query-параметром — шлюз читает ?onec_token= наравне с Bearer.
	// Без кэша: HS256-подпись дешёвая, а переменные модуля в этом общем
	// модуле платформа не компилирует (см. bsl-pitfalls).
	ТокенДоступа = a1c_ЧатФоновый.СформироватьТокенДоступа();
	Если ЗначениеЗаполнено(ТокенДоступа) Тогда
		// HTTPЗапрос не имеет коллекции query-параметров — дописываем к URI
		// вручную (разделитель ? или & в зависимости от того, есть ли уже
		// параметры в пути). JWT (base64url + точка) безопасен в query без
		// экранирования: нет встроенной функции URL-кодирования в 8.3.
		Если СтрНайти(Путь, "?") > 0 Тогда
			Путь = Путь + "&onec_token=" + ТокенДоступа;
		Иначе
			Путь = Путь + "?onec_token=" + ТокенДоступа;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(Путь, Заголовки);

	Если Метод <> "GET" Тогда
		Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	КонецЕсли;

	// Basic auth: имя и пароль передаются в конструкторе HTTPСоединения —
	// платформа сама формирует заголовок Authorization (проверено на живом
	// сервере OpenCode; вариант со строкой "user:pass" в 4-м аргументе
	// заголовок не отправлял).
	Если ПараметрыАдреса.Защищенное Тогда
		Соединение = Новый HTTPСоединение(ПараметрыАдреса.Сервер, ПараметрыАдреса.Порт, "opencode", "123", , Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(ПараметрыАдреса.Сервер, ПараметрыАдреса.Порт, "opencode", "123", , Таймаут);
	КонецЕсли;

	Если Метод = "GET" Тогда
		Возврат Соединение.Получить(Запрос);
	Иначе
		Возврат Соединение.ОтправитьДляОбработки(Запрос);
	КонецЕсли;

КонецФункции

Функция ТелоОтвета(Знач ОтветHTTP)
	Попытка
		Возврат ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ЗаписатьСтрокуJSON(Знач Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ПрочитатьСтрокуJSON(Знач СтрокаJSON)
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Данные;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Прогресс в окне ожидания БСП (ДлительныеОперацииКлиент.ОжидатьЗавершение).
// Вызов защищён: если подсистема БСП не подключена, запрос просто идёт без прогресса.
Процедура СообщитьПрогрессБСП(Знач Процент, Знач Текст)

	Если Метаданные.ОбщиеМодули.Найти("ДлительныеОперации") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДлительныеОперации.СообщитьПрогресс(Процент, Текст);
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция НовыйРезультат(ЭтоОшибка, ТекстОшибки, ТекстОтвета)

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", ЭтоОшибка);
	Результат.Вставить("ТекстОшибки", ТекстОшибки);
	Результат.Вставить("ТекстОтвета", ТекстОтвета);
	Результат.Вставить("ВсегоТокенов", 0);
	Результат.Вставить("ВремяОтветаСекунд", 0);
	Результат.Вставить("МодельОтвета", "");
	Результат.Вставить("ВложенияОтвета", Новый Массив);
	Результат.Вставить("ИдентификаторСессии", "");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область V2_АсинхронныйХод

// V2: отправить промпт без ожидания ответа (без wait). Возвращает структуру
// {ЭтоОшибка, ТекстОшибки, ИдентификаторСессии, ВремяНачала} — сессию создаёт
// при первом вопросе. ВремяНачала — момент создания сообщения пользователя на
// сервере (по нему форма отбирает сообщения текущего хода при опросе).
Функция ОтправитьПромптБезОжидания(Знач ТекстПромпта, Знач АдресСервера, Знач ИдСессииСтрокой = "", Знач АгентСтрокой = "assistant") Экспорт

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = АдресСервераПоУмолчанию();
	КонецЕсли;

	ПараметрыАдреса = РазобратьАдресСервера(Адрес);

	Если ПустаяСтрока(ИдСессииСтрокой) Тогда
		НоваяСессия = СоздатьСессию(ПараметрыАдреса, Адрес, АгентСтрокой, ТекстПромпта);
		Если НоваяСессия.ЭтоОшибка Тогда
			Возврат НовыйРезультат(Истина, НоваяСессия.ТекстОшибки, "");
		КонецЕсли;
		ИдСессииСтрокой = НоваяСессия.ИдентификаторСессии;
	КонецЕсли;

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("text", ТекстПромпта);
	СтрокаJSON = ЗаписатьСтрокуJSON(ТелоЗапроса);

	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/session/" + ИдСессииСтрокой + "/prompt", СтрокаJSON);
	Исключение
		Возврат НовыйРезультат(Истина, ТекстОшибкиСоединения(), "");
	КонецПопытки;

	// 404 — сессия исчезла (перезапуск сервера). Создаём новую и повторяем один раз.
	Если ОтветHTTP.КодСостояния = 404 И Не ПустаяСтрока(ИдСессииСтрокой) Тогда
		НоваяСессия = СоздатьСессию(ПараметрыАдреса, Адрес, АгентСтрокой, ТекстПромпта);
		Если НоваяСессия.ЭтоОшибка Тогда
			Возврат НовыйРезультат(Истина, НоваяСессия.ТекстОшибки, "");
		КонецЕсли;
		ИдСессииСтрокой = НоваяСессия.ИдентификаторСессии;

		Попытка
			ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST", "/api/session/" + ИдСессииСтрокой + "/prompt", СтрокаJSON);
		Исключение
			Возврат НовыйРезультат(Истина, ТекстОшибкиСоединения(), "");
		КонецПопытки;
	КонецЕсли;

	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат НовыйРезультат(Истина, ТекстОшибкиСервера(ОтветHTTP.КодСостояния, ТелоОтвета(ОтветHTTP)), "");
	КонецЕсли;

	// Квитанция prompt — объект Session.Inbox.User с time.created. Это время
	// начала хода: по нему отбираем сообщения ассистента при опросе.
	ВремяНачала = 0;
	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные <> Неопределено И ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("data") И ТипЗнч(Данные.data) = Тип("Структура")
		И Данные.data.Свойство("time") И ТипЗнч(Данные.data.time) = Тип("Структура")
		И Данные.data.time.Свойство("created") Тогда
		Попытка
			ВремяНачала = Число(Данные.data.time.created);
		Исключение
			ВремяНачала = 0;
		КонецПопытки;
	КонецЕсли;
	Если ВремяНачала = 0 Тогда
		ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;

	Результат = НовыйРезультат(Ложь, "", "");
	Результат.Вставить("ИдентификаторСессии", ИдСессииСтрокой);
	Результат.Вставить("ВремяНачала", ВремяНачала);
	Возврат Результат;

КонецФункции

// V2: состояние текущего хода — опрос вместо событий (в форме нет push).
// Возвращает структуру:
//   ЭтоОшибка, ТекстОшибки — ошибка транспорта/сервера при опросе;
//   Текст        — накопленный текст ответа модели за текущий ход;
//   Завершено    — цикл агента завершён (сообщение idle) и нет ожидающих форм;
//   ОшибкаМодели — текст ошибки модели/провайдера (пусто, если не было);
//   Модель, Токены, Секунды — метаинформация ответа;
//   Вопрос       — Неопределено или структура из ПолучитьОжидающиеВопросы:
//                  {id, title, Поля[] {key, title, description, Варианты[]}}.
Функция ПолучитьСостояниеХода(Знач АдресСервера, Знач ИдСессииСтрокой, Знач ВремяНачала) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Текст", "");
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("ОшибкаМодели", "");
	Результат.Вставить("Модель", "");
	Результат.Вставить("Токены", 0);
	Результат.Вставить("Секунды", 0);
	Результат.Вставить("Вопрос", Неопределено);
	Результат.Вставить("Ретраит", Ложь);
	Результат.Вставить("СтатусРетрая", "");

	Если ПустаяСтрока(ИдСессииСтрокой) Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Сессия не создана — отправьте запрос ещё раз.'");
		Возврат Результат;
	КонецЕсли;

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = АдресСервераПоУмолчанию();
	КонецЕсли;
	ПараметрыАдреса = РазобратьАдресСервера(Адрес);

	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "GET",
			"/api/session/" + ИдСессииСтрокой + "/message?order=desc&limit=50", "", 15);
	Исключение
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ТекстОшибкиСоединения();
		Возврат Результат;
	КонецПопытки;

	Если ОтветHTTP.КодСостояния = 404 Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Сессия на сервере не найдена (сервер перезапускался). Отправьте запрос ещё раз.'");
		Возврат Результат;
	КонецЕсли;

	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = ТекстОшибкиСервера(ОтветHTTP.КодСостояния, ТелоОтвета(ОтветHTTP));
		Возврат Результат;
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Или ТипЗнч(Данные.data) <> Тип("Массив") Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Сервер OpenCode вернул некорректный список сообщений.'");
		Возврат Результат;
	КонецЕсли;

	Состояние = СобратьСостояниеХода(Данные.data, ВремяНачала);
	Результат.Текст = Состояние.Текст;
	Результат.Завершено = Состояние.Завершено;
	Результат.ОшибкаМодели = Состояние.ОшибкаМодели;
	Результат.Модель = Состояние.Модель;
	Результат.Токены = Состояние.Токены;
	Результат.Секунды = Состояние.Секунды;
	Результат.Ретраит = Состояние.Ретраит;
	Результат.СтатусРетрая = Состояние.СтатусРетрая;

	// Вопрос модели блокирует ход: пока он не отвечен, ход не завершён.
	Вопросы = ПолучитьОжидающиеВопросы(Адрес, ИдСессииСтрокой);
	Если Вопросы.Количество() > 0 Тогда
		Результат.Вопрос = Вопросы[0];
		Результат.Завершено = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сборка состояния хода из списка сообщений сессии (GET /message, desc).
// В отличие от СобратьОтветАссистента пустой текст ошибкой не считается:
// во время генерации это нормальное состояние.
// Возвращает {Текст, Завершено, ОшибкаМодели, Модель, Токены, Секунды}.
Функция СобратьСостояниеХода(Знач МассивСообщений, Знач ВремяНачала)

	Результат = Новый Структура;
	Результат.Вставить("Текст", "");
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("ОшибкаМодели", "");
	Результат.Вставить("Модель", "");
	Результат.Вставить("Токены", 0);
	Результат.Вставить("Секунды", 0);
	// Пока модель ретраит подключение к провайдеру, OpenCode пишет в текст
	// последнего assistant-сообщения «⚠ Retrying in Ns • attempt K • ...».
	// Вытаскиваем это отдельно: форма показывает живой статус, а не молчит.
	Результат.Вставить("Ретраит", Ложь);
	Результат.Вставить("СтатусРетрая", "");

	Если ТипЗнч(МассивСообщений) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	// Список приходит новыми первыми — разворачиваем, чтобы текст шёл по порядку.
	Сообщения = Новый Массив;
	Индекс = МассивСообщений.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Сообщения.Добавить(МассивСообщений[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

	ЧастиТекста = Новый Массив;
	ВремяОкончания = 0;
	ТекстОшибки = "";

	Для Каждого Сообщение Из Сообщения Цикл
		Попытка
			ВремяСоздания = 0;
			Если Сообщение.Свойство("time") И ТипЗнч(Сообщение.time) = Тип("Структура")
				И Сообщение.time.Свойство("created") Тогда
				ВремяСоздания = Число(Сообщение.time.created);
			КонецЕсли;
			Если ВремяНачала > 0 И ВремяСоздания < ВремяНачала Тогда
				Продолжить;
			КонецЕсли;

			ТипСообщения = ?(Сообщение.Свойство("type"), Сообщение.type, "");

			Если ТипСообщения = "idle" Тогда
				// Маркер конца хода цикла агента.
				Результат.Завершено = Истина;
				Если Сообщение.Свойство("error") И Сообщение.error <> Неопределено Тогда
					Попытка
						Если Сообщение.error.Свойство("message") И ЗначениеЗаполнено(Сообщение.error.message) Тогда
							ТекстОшибки = СокрЛП(Сообщение.error.message);
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Если ТипСообщения <> "assistant" Тогда
				Продолжить;
			КонецЕсли;

			// Ошибка модели/провайдера (finish="error" / error.message).
			Если Сообщение.Свойство("error") И Сообщение.error <> Неопределено Тогда
				Попытка
					Если Сообщение.error.Свойство("message") И ЗначениеЗаполнено(Сообщение.error.message) Тогда
						ТекстОшибки = СокрЛП(Сообщение.error.message);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			// Текстовые части сообщения (content[].type="text").
			ТекстСообщения = "";
			Если Сообщение.Свойство("content") И ТипЗнч(Сообщение.content) = Тип("Массив") Тогда
				Для Каждого Часть Из Сообщение.content Цикл
					Попытка
						Если Часть.Свойство("type") И Часть.type = "text"
							И Часть.Свойство("text") И ЗначениеЗаполнено(Часть.text) Тогда
							ТекстСообщения = ТекстСообщения + Часть.text;
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			Если Не ПустаяСтрока(ТекстСообщения) Тогда
				ЧастиТекста.Добавить(ТекстСообщения);
			КонецЕсли;

			// Токены суммируются по всем сообщениям ответа.
			Если Сообщение.Свойство("tokens") И ТипЗнч(Сообщение.tokens) = Тип("Структура") Тогда
				Попытка
					Результат.Токены = Результат.Токены + Число(Сообщение.tokens.input) + Число(Сообщение.tokens.output);
				Исключение
				КонецПопытки;
			КонецЕсли;

			// Модель берём из последнего сообщения (по времени создания).
			Если Сообщение.Свойство("model") И ТипЗнч(Сообщение.model) = Тип("Структура") Тогда
				Попытка
					Если Сообщение.model.Свойство("id") И ЗначениеЗаполнено(Сообщение.model.id) Тогда
						Результат.Модель = Сообщение.model.id;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			// Время окончания — из последнего сообщения с completed.
			Если Сообщение.Свойство("time") И ТипЗнч(Сообщение.time) = Тип("Структура")
				И Сообщение.time.Свойство("completed") Тогда
				Попытка
					ВремяОкончания = Число(Сообщение.time.completed);
				Исключение
					ВремяОкончания = 0;
				КонецПопытки;
			КонецЕсли;
		Исключение
		// Ошибка разбора сообщения — пропускаем.
		КонецПопытки;
	КонецЦикла;

	Если ЧастиТекста.Количество() > 0 Тогда
		Результат.Текст = СтрСоединить(ЧастиТекста, Символы.ПС + Символы.ПС);
	КонецЕсли;

	Если ВремяОкончания > 0 И ВремяНачала > 0 И ВремяОкончания > ВремяНачала Тогда
		Результат.Секунды = (ВремяОкончания - ВремяНачала) / 1000;
	КонецЕсли;

	Результат.ОшибкаМодели = ТекстОшибки;

	// Ретраи видим, только пока ход не завершён: после idle текст «Retrying»
	// в сообщении остаётся, но это уже финальная ошибка (в ОшибкаМодели).
	Если Не Результат.Завершено И ЧастиТекста.Количество() > 0 Тогда
		ПоследнийТекст = ЧастиТекста[ЧастиТекста.Количество() - 1];
		Если СтрНайти(ПоследнийТекст, "Retrying in") > 0 Тогда
			Результат.Ретраит = Истина;
			Результат.СтатусРетрая = СокрЛП(ПоследнийТекст);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// V2: список ожидающих вопросов модели (pending-форм) сессии.
// Возвращает Массив структур {id, title, Поля[]}, где Поля — Массив структур
// {key, title, description, Варианты[] {value, label, description}}.
Функция ПолучитьОжидающиеВопросы(Знач АдресСервера, Знач ИдСессииСтрокой) Экспорт

	Результат = Новый Массив;
	Если ПустаяСтрока(ИдСессииСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	ПараметрыАдреса = РазобратьАдресСервера(Адрес);

	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "GET", "/api/session/" + ИдСессииСтрокой + "/form", "");
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = ПрочитатьСтрокуJSON(ТелоОтвета(ОтветHTTP));
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("data") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Форма Из Данные.data Цикл
		Попытка
			Вопрос = Новый Структура;
			Вопрос.Вставить("id", Форма.id);
			Вопрос.Вставить("title", ?(Форма.Свойство("title"), Форма.title, ""));

			Поля = Новый Массив;
			Если Форма.Свойство("fields") И ТипЗнч(Форма.fields) = Тип("Массив") Тогда
				Для Каждого Поле Из Форма.fields Цикл
					Попытка
						СтруктураПоля = Новый Структура;
						СтруктураПоля.Вставить("key", ?(Поле.Свойство("key"), Поле.key, ""));
						СтруктураПоля.Вставить("title", ?(Поле.Свойство("title"), Поле.title, ""));
						СтруктураПоля.Вставить("description", ?(Поле.Свойство("description"), Поле.description, ""));

						Варианты = Новый Массив;
						Если Поле.Свойство("options") И ТипЗнч(Поле.options) = Тип("Массив") Тогда
							Для Каждого Вариант Из Поле.options Цикл
								Попытка
									СтруктураВарианта = Новый Структура;
									СтруктураВарианта.Вставить("value", ?(Вариант.Свойство("value"), Вариант.value, ""));
									СтруктураВарианта.Вставить("label", ?(Вариант.Свойство("label"), Вариант.label, ""));
									СтруктураВарианта.Вставить("description", ?(Вариант.Свойство("description"), Вариант.description, ""));
									Варианты.Добавить(СтруктураВарианта);
								Исключение
								КонецПопытки;
							КонецЦикла;
						КонецЕсли;
						СтруктураПоля.Вставить("Варианты", Варианты);
						Поля.Добавить(СтруктураПоля);
					Исключение
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			Вопрос.Вставить("Поля", Поля);
			Результат.Добавить(Вопрос);
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// V2: ответить на вопрос модели (pending-форму). ОтветСтрокой — текст ответа
// (один из вариантов или свой текст). Ключи — Массив ключей полей формы
// (q0, q1, ...) или один ключ строкой: в форме V2 одно поле ввода, поэтому
// все поля получают один и тот же текст (иначе форма останется неотвеченной
// и ход не продолжится). Возвращает Булево.
// Ответ одной строкой на все поля формы — совместимость с прежним вызовом.
Функция ОтветитьНаВопрос(Знач АдресСервера, Знач ИдСессииСтрокой, Знач ИдФормы, Знач Ключи, Знач ОтветСтрокой) Экспорт

	Ответы = Новый Соответствие;
	Если ТипЗнч(Ключи) = Тип("Массив") Тогда
		Для Каждого Ключ Из Ключи Цикл
			Если Не ПустаяСтрока(Ключ) Тогда
				Ответы.Вставить(Ключ, ОтветСтрокой);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Ключи) = Тип("Строка") И Не ПустаяСтрока(Ключи) Тогда
		Ответы.Вставить(Ключи, ОтветСтрокой);
	КонецЕсли;
	Если Ответы.Количество() = 0 Тогда
		Ответы.Вставить("q0", ОтветСтрокой);
	КонецЕсли;

	Возврат ОтветитьНаВопросСОтветами(АдресСервера, ИдСессииСтрокой, ИдФормы, Ответы);

КонецФункции

// Ответ на форму-вопрос по полям: Ответы — Соответствие «ключ поля → текст».
// Если у формы несколько полей (q0, q1, …), ответить нужно всем сразу: иначе
// форма остаётся pending и ход застревает.
Функция ОтветитьНаВопросСОтветами(Знач АдресСервера, Знач ИдСессииСтрокой, Знач ИдФормы, Знач Ответы) Экспорт

	Если ТипЗнч(Ответы) <> Тип("Соответствие") И ТипЗнч(Ответы) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Адрес = СокрЛП(АдресСервера);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	ПараметрыАдреса = РазобратьАдресСервера(Адрес);

	// Структура вместо Соответствия: сериализуется в JSON-объект без сюрпризов
	// независимо от версии платформы.
	ОтветОбъект = Новый Структура;
	Для Каждого Элемент Из Ответы Цикл
		ОтветОбъект.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Если ОтветОбъект.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("answer", ОтветОбъект);
	СтрокаJSON = ЗаписатьСтрокуJSON(ТелоЗапроса);

	Попытка
		ОтветHTTP = ОтправитьНаСервер(ПараметрыАдреса, "POST",
			"/api/session/" + ИдСессииСтрокой + "/form/" + ИдФормы + "/reply", СтрокаJSON);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат ОтветHTTP.КодСостояния = 200 Или ОтветHTTP.КодСостояния = 204;

КонецФункции

#КонецОбласти

// Поддерживает http://host:port и https://host:port
Функция РазобратьАдресСервера(Знач Адрес)

	Результат = Новый Структура("Сервер, Порт, Защищенное", "localhost", 9020, Ложь);
	Стр = СокрЛП(Адрес);
	Защищенное = Ложь;
	Если СтрНачинаетсяС(НРег(Стр), "https://") Тогда
		Защищенное = Истина;
		Стр = Сред(Стр, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Стр), "http://") Тогда
		Стр = Сред(Стр, 8);
	КонецЕсли;

	// Отрезать путь
	ПозицияСлэша = СтрНайти(Стр, "/");
	Если ПозицияСлэша > 0 Тогда
		Стр = Лев(Стр, ПозицияСлэша - 1);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Стр, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(Стр, ПозицияДвоеточия - 1);
		ПортСтрокой = Сред(Стр, ПозицияДвоеточия + 1);
		Попытка
			Результат.Порт = Число(ПортСтрокой);
		Исключение
			Результат.Порт = ?(Защищенное, 443, 80);
		КонецПопытки;
	Иначе
		Результат.Сервер = Стр;
		Результат.Порт = ?(Защищенное, 443, 80);
	КонецЕсли;
	Результат.Защищенное = Защищенное;

	Возврат Результат;

КонецФункции

