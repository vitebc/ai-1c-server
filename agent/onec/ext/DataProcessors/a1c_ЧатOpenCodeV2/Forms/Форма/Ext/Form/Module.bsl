#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = АдресБэкенда();
	КонецЕсли;

	ВыполнятьВФоне = Истина;

	ЗагрузитьНастройкиФормы();
	ЗаполнитьСписокАгентов();
	ПроверитьДоступностьСервера();
	УстановитьКомпонентуWS();
	ПодключитьсяКСобытиям();
	ОбновитьОтображениеОтвета();
	Элементы.АдресБэкенда.Доступность = ЭтоРазработчик();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиФормы();
	ОтключитьсяОтСобытий();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АдресБэкендаПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнятьВФонеПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура РазмерКонтекстаПриИзменении(Элемент)

	Если РазмерКонтекста < 0 Тогда
		РазмерКонтекста = 0;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура АгентПриИзменении()

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область Агенты

// Дропдаун агентов сервера OpenCode: только mode="primary" и не hidden.
&НаСервере
Процедура ЗаполнитьСписокАгентов()

	Элементы.Агент.СписокВыбора.Очистить();
	АгентПоУмолчанию = "assistant";
	Попытка
		СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
		Если СписокАгентов.Количество() = 0 Тогда
			Элементы.Агент.СписокВыбора.Добавить("assistant", НСтр("ru = 'Ассистент'"));
		Иначе
			Для Каждого СтрокаАгента Из СписокАгентов Цикл
				Элементы.Агент.СписокВыбора.Добавить(СтрокаАгента.id, СтрокаАгента.name);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Сервер недоступен — один дефолт, форму всё равно открываем.
		Элементы.Агент.СписокВыбора.Добавить("assistant", НСтр("ru = 'Ассистент'"));
	КонецПопытки;

	// Текущее значение обязано быть из списка, иначе сброс на дефолт.
	Если Элементы.Агент.СписокВыбора.НайтиПоЗначению(Агент) = Неопределено Тогда
		Агент = АгентПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроверкаСервера

// Стартовая проверка доступности сервера OpenCode (GET /api/agent): при сбое —
// баннер, форму не блокируем.
&НаСервере
Процедура ПроверитьДоступностьСервера()

	ПредупреждениеБазы = "";
	Элементы.ПредупреждениеБазы.Видимость = Ложь;
	Попытка
		СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
		Если СписокАгентов.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'сервер вернул пустой список агентов'");
		КонецЕсли;
		// Диагностика: модуль возвращает одну строку с кодом HTTP и телом
		// ответа при ошибке — показываем её в баннере вместо «пусто».
		Если ТипЗнч(СписокАгентов[0]) = Тип("Строка") Тогда
			ВызватьИсключение СписокАгентов[0];
		КонецЕсли;
	Исключение
		ПредупреждениеБазы = СтрШаблон(
			НСтр("ru = 'Сервер OpenCode недоступен (%1): %2'"),
			АдресБэкенда,
			ОписаниеОшибки());
		Элементы.ПредупреждениеБазы.Заголовок = ПредупреждениеБазы;
		Элементы.ПредупреждениеБазы.Видимость = Истина;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(Промпт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите промпт'"));
		Возврат;
	КонецЕсли;

	Элементы.Отправить.Доступность = Ложь;
	УстановитьСтатус(НСтр("ru = 'Размышляю...'"));

	ТекущийПромпт = Промпт;
	Промпт = "";

	// V2: отправка без ожидания — ответ приходит событиями (WS-мост).
	ДобавитьСообщениеВИсториюЛокально("user", ТекущийПромпт);
	ОтправитьПромпт(ТекущийПромпт);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	Промпт = "";
	ИдентификаторСессии = ""; // новый диалог — новая сессия сервера OpenCode
	ОчиститьИсториюНаСервере();
	ТаблицаВложений.Очистить();
	ВложенияТекст = "";

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлы(Команда)

	ПоказатьПредупреждение(, НСтр("ru = 'Прикрепление файлов появится позже'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВложения(Команда)

	ТаблицаВложений.Очистить();
	ВложенияТекст = "";
	ОбновитьВложенияТекстНаСервере();

КонецПроцедуры

// V2: ответить на вопрос модели — POST /form/{fid}/reply, затем цикл событий
// продолжится (модель разблокируется и допишет ответ).
&НаКлиенте
Процедура ОтветитьНаВопрос(Команда)

	Если ПустаяСтрока(ОтветНаВопрос) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите ответ на вопрос'"));
		Возврат;
	КонецЕсли;

	ТекстОтвета = ОтветНаВопрос;
	ОтветНаВопрос = "";
	Элементы.ГруппаВопроса.Видимость = Ложь;

	// Скрываем вопрос из истории (добавляем ответ пользователя).
	ДобавитьСообщениеВИсториюЛокально("user", ТекстОтвета);

	УстановитьСтатус(НСтр("ru = 'Ожидание продолжения...'"));

	// Серверный вызов: reply. КлючПоля — из текущего вопроса (q0).
	Успех = ОтветитьНаВопросНаСервере(ТекстОтвета);

	Если Не Успех Тогда
		ДобавитьСообщениеВИсториюЛокально("error",
			НСтр("ru = 'Не удалось отправить ответ на вопрос. Попробуйте ещё раз.'"));
		Элементы.Отправить.Доступность = Истина;
		УстановитьСтатус(НСтр("ru = ''"));
	КонецЕсли;

	// Цикл событий уже крутится (ЗапуститьЦиклСобытий) — модель продолжит работу,
	// message.updated/session.idle придут сами.

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область WS_Соединение

// V2: подключение к WS-мосту (SSE→WS) через внешнюю компоненту web-transport-addin.
// Мост пересылает события OpenCode /api/event как WS-сообщения.
// V2: установка внешней компоненты из макета (тонкий клиент).
// Вызывается из ПриСозданииНаСервере перед ПодключитьсяКСобытиям.
&НаКлиенте
Процедура УстановитьКомпонентуWS()

	ИмяМакета = "Обработка.a1c_ЧатOpenCodeV2.Макет.WebTransportAddIn";
	Попытка
		Если Не ПодключитьВнешнююКомпоненту(ИмяМакета, "WebTransport") Тогда
			НачатьУстановкуВнешнейКомпоненты(, ИмяМакета);
			ПодключитьВнешнююКомпоненту(ИмяМакета, "WebTransport");
		КонецЕсли;
	Исключение
		// Макет не найден или установка не удалась — работаем без событий.
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПодключитьсяКСобытиям()

	ОбъектСобытий = Неопределено;
	АдресWS = АдресМоста();

	// Компонента устанавливается на клиенте (УстановитьКомпонентуWS).
	Попытка
		ОбъектСобытий = Новый("AddIn.WebTransport.ws");
		Заголовки = "{}";
		Подключилось = ОбъектСобытий.Подключиться(АдресWS, Заголовки);
		Если Не Подключилось Тогда
			ОбъектСобытий = Неопределено;
		КонецЕсли;
	Исключение
		// Компонента не установлена или мост недоступен — работаем без событий.
		ОбъектСобытий = Неопределено;
	КонецПопытки;

	Если ОбъектСобытий <> Неопределено Тогда
		ЗапуститьЦиклСобытий(ОбъектСобытий);
	Иначе
		// Fallback: без WS-моста — показываем баннер, запросы идут через polling.
		ПредупреждениеБазы = СтрШаблон(
			НСтр("ru = 'WS-мост событий недоступен (%1). Ответы будут приходить после завершения всего хода.'"),
			АдресWS);
		Элементы.ПредупреждениеБазы.Заголовок = ПредупреждениеБазы;
		Элементы.ПредупреждениеБазы.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтключитьсяОтСобытий()

	// Разрыв WS-соединения при закрытии формы (если есть).
	// ОбъектСобытий — переменная модуля формы, доступна на сервере.
КонецПроцедуры

// V2: цикл обработки событий в фоновом режиме. Запускается один раз при
// подключении; читает WS-сообщения с таймаутом и обрабатывает их.
&НаСервере
Процедура ЗапуститьЦиклСобытий(Знач ОбъектWS)

	// Цикл выполняется в текущем потоке серверной части формы.
	// Таймаут 30 с — при отсутствии событий (heartbeat ~15 с) цикл не зависает.
	Пока Истина Цикл
		Попытка
			Сообщение = ОбъектWS.ПолучитьСообщение(30000);
		Исключение
			// Соединение разорвано — прекращаем цикл.
			Прервать;
		КонецПопытки;

		Если ПустаяСтрока(Сообщение) Тогда
			// Таймаут — продолжаем ждать.
			Продолжить;
		КонецЕсли;

		// Разбираем кадры SSE из WS-сообщения.
		Кадры = a1c_ЧатOpenCodeФоновый.РазобратьКадрыSSE(Сообщение);
		Для Каждого Кадр Из Кадры Цикл
			Если Кадр.Тип = "event" Тогда
				ОбработатьСобытие(Кадр.Данные);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// V2: адрес WS-моста (SSE→WS). По умолчанию — тот же хост, порт +1.
&НаСервере
Функция АдресМоста()

	Адрес = СокрЛП(АдресБэкенда);
	// Заменяем http://host:4040 на ws://host:4041
	Если СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Адрес = Сред(Адрес, 8);
	КонецЕсли;
	ПозицияДвоеточия = СтрНайти(Адрес, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Хост = Лев(Адрес, ПозицияДвоеточия - 1);
		ПортСтрокой = Сред(Адрес, ПозицияДвоеточия + 1);
		// Отрезать путь если есть
		ПозицияСлэша = СтрНайти(ПортСтрокой, "/");
		Если ПозицияСлэша > 0 Тогда
			ПортСтрокой = Лев(ПортСтрокой, ПозицияСлэша - 1);
		КонецЕсли;
		Попытка
			Порт = Число(ПортСтрокой) + 1;
		Исключение
			Порт = 4041;
		КонецПопытки;
		Возврат "ws://" + Хост + ":" + Формат(Порт, "ЧЦ=0");
	Иначе
		Возврат "ws://192.168.60.39:4041";
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ОбработкаСобытий

// V2: обработчик события OpenCode (приходит через WS-мост).
// Типы событий:
//   message.updated  — текст ответа модели обновился (потоковая отрисовка)
//   form.created     — модель задала вопрос пользователю
//   session.idle     — цикл агента завершён (конец хода)
//   server.connected — соединение установлено (игнорируем)
&НаСервере
Процедура ОбработатьСобытие(Знач Данные)

	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипСобытия = "";
	Попытка
		ТипСобытия = ?(Данные.Свойство("type"), Данные.type, "");
	Исключение
		Возврат;
	КонецПопытки;

	// Фильтруем по текущей сессии (если ИдентификаторСессии задан).
	// События других сессий игнорируем.
	Если Не ПустаяСтрока(ИдентификаторСессии) Тогда
		СессияСобытия = "";
		Попытка
			Если Данные.Свойство("data") И ТипЗнч(Данные.data) = Тип("Структура")
				И Данные.data.Свойство("sessionID") Тогда
				СессияСобытия = Данные.data.sessionID;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если Не ПустаяСтрока(СессияСобытия) И СессияСобытия <> ИдентификаторСессии Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ТипСобытия = "message.updated" Тогда
		ОбработатьСобытиеСообщения(Данные);
	ИначеЕсли ТипСобытия = "form.created" Тогда
		ПоказатьВопросМодели(Данные);
	ИначеЕсли ТипСобытия = "session.idle" Тогда
		ЗавершитьХод();
	Иначе
		// Остальные события (server.connected, heartbeat и т.д.) — игнорируем.
	КонецЕсли;

КонецПроцедуры

// V2: потоковая отрисовка текста ответа модели.
&НаСервере
Процедура ОбработатьСобытиеСообщения(Знач Данные)

	Попытка
		ДанныеВложенные = Данные.data;
		Если ТипЗнч(ДанныеВложенные) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;

		ТипСообщения = ?(ДанныеВложенные.Свойство("type"), ДанныеВложенные.type, "");
		Если ТипСообщения <> "assistant" Тогда
			Возврат;
		КонецЕсли;

		// Собираем текст из content[].
		Текст = "";
		Если ДанныеВложенные.Свойство("content") И ТипЗнч(ДанныеВложенные.content) = Тип("Массив") Тогда
			Для Каждого Часть Из ДанныеВложенные.content Цикл
				Попытка
					Если Часть.Свойство("type") И Часть.type = "text"
						И Часть.Свойство("text") И ЗначениеЗаполнено(Часть.text) Тогда
						Текст = Текст + Часть.text;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;

		Если ПустаяСтрока(Текст) Тогда
			Возврат;
		КонецЕсли;

		// Обновляем или создаём строку assistant в истории.
		ОбновитьТекстОтвета(Текст);

	Исключение
	КонецПопытки;

КонецПроцедуры

// V2: показать вопрос модели пользователю.
&НаСервере
Процедура ПоказатьВопросМодели(Знач Данные)

	Попытка
		ДанныеВложенные = Данные.data;
		Если ТипЗнч(ДанныеВложенные) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;

		ИдФормы = ?(ДанныеВложенные.Свойство("id"), ДанныеВложенные.id, "");
		Если ПустаяСтрока(ИдФормы) Тогда
			Возврат;
		КонецЕсли;

		// Сохраняем ID вопроса для ответа.
		ТекущийИдВопроса = ИдФормы;

		// Формируем текст вопроса из fields[].
		ТекстВопроса = "";
		Если ДанныеВложенные.Свойство("fields") И ТипЗнч(ДанныеВложенные.fields) = Тип("Массив") Тогда
			НомерПоля = 1;
			Для Каждого Поле Из ДанныеВложенные.fields Цикл
				Попытка
					ЗаголовокПоля = ?(Поле.Свойство("title"), Поле.title, "");
					ОписаниеПоля = ?(Поле.Свойство("description"), Поле.description, "");
					Если Не ПустаяСтрока(ЗаголовокПоля) Тогда
						ТекстВопроса = ТекстВопроса + ЗаголовокПоля;
					КонецЕсли;
					Если Не ПустаяСтрока(ОписаниеПоля) Тогда
						ТекстВопроса = ТекстВопроса + Символы.ПС + ОписаниеПоля;
					КонецЕсли;

					// Варианты ответа.
					Если Поле.Свойство("options") И ТипЗнч(Поле.options) = Тип("Массив") Тогда
						Для Каждого Вариант Из Поле.options Цикл
							Попытка
								Метка = ?(Вариант.Свойство("label"), Вариант.label, "");
								Если Не ПустаяСтрока(Метка) Тогда
									ТекстВопроса = ТекстВопроса + Символы.ПС + "  • " + Метка;
								КонецЕсли;
							Исключение
							КонецПопытки;
						КонецЦикла;
					КонецЕсли;

					НомерПоля = НомерПоля + 1;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;

		// Показываем вопрос в форме.
		ТекстВопроса = ?(ПустаяСтрока(ТекстВопроса), НСтр("ru = 'Ассистент задаёт вопрос'"), ТекстВопроса);
		Элементы.ТекстВопроса.Заголовок = ТекстВопроса;
		ОтветНаВопрос = "";
		Элементы.ГруппаВопроса.Видимость = Истина;

		// Добавляем вопрос в историю как сообщение assistant.
		ДобавитьСообщениеВИсториюЛокально("assistant", ТекстВопроса, НСтр("ru = '❓ Вопрос'"));

	Исключение
	КонецПопытки;

КонецПроцедуры

// V2: завершение хода (session.idle).
&НаСервере
Процедура ЗавершитьХод()

	УстановитьСтатус(НСтр("ru = ''"));
	Элементы.Отправить.Доступность = Истина;

КонецПроцедуры

#КонецОбласти

#Область ВыполнениеЗапроса

// V2: отправка промпта без ожидания (ответ приходит событиями).
&НаСервере
Процедура ОтправитьПромпт(Знач ТекстПромпта)

	Попытка
		Результат = a1c_ЧатOpenCodeФоновый.ОтправитьПромптБезОжидания(
			ТекстПромпта, АдресБэкенда, ИдентификаторСессии, Агент);
	Исключение
		ДобавитьСообщениеВИсториюЛокально("error",
			НСтр("ru = 'Не удалось отправить запрос. Подробности — в журнале регистрации.'"));
		Элементы.Отправить.Доступность = Истина;
		УстановитьСтатус(НСтр("ru = ''"));
		Возврат;
	КонецПопытки;

	Если Результат.ЭтоОшибка Тогда
		ДобавитьСообщениеВИсториюЛокально("error", Результат.ТекстОшибки);
		Элементы.Отправить.Доступность = Истина;
		УстановитьСтатус(НСтр("ru = ''"));
		Возврат;
	КонецЕсли;

	// Сессия из результата, иначе следующий вопрос — без контекста.
	Если Результат.Свойство("ИдентификаторСессии")
		И ЗначениеЗаполнено(Результат.ИдентификаторСессии) Тогда
		ИдентификаторСессии = Результат.ИдентификаторСессии;
	КонецЕсли;

	// Создаём пустую строку assistant для потоковой отрисовки.
	ОбновитьТекстОтвета("");

КонецПроцедуры

// V2: обновить текст ответа (потоковая отрисовка). Ищет последнюю строку
// assistant в истории и обновляет её текст; если нет — создаёт новую.
&НаСервере
Процедура ОбновитьТекстОтвета(Знач Текст)

	// Ищем последнюю строку с ролью "assistant" (без метаинформации — значит,
	// это текущий ход, ещё не завершён).
	Индекс = ИсторияДиалога.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ИсторияДиалога[Индекс].Роль = "assistant"
			И ПустаяСтрока(ИсторияДиалога[Индекс].Метаинформация) Тогда
			ИсторияДиалога[Индекс].Текст = Текст;
			ОбновитьОтображениеОтвета();
			Возврат;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	// Нет незавершённой строки assistant — создаём новую.
	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = "assistant";
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = "";

	ОбновитьОтображениеОтвета();

КонецПроцедуры

// V2: серверный вызов reply на вопрос модели. Вызывается из клиентской
// процедуры ОтветитьНаВопрос (команда формы).
&НаСервере
Функция ОтветитьНаВопросНаСервере(Знач ТекстОтвета)

	Попытка
		Возврат a1c_ЧатOpenCodeФоновый.ОтветитьНаВопрос(
			АдресБэкенда, ИдентификаторСессии, ТекущийИдВопроса, "q0", ТекстОтвета);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// V2: установить текст статуса (в баннере или в подсказке).
&НаСервере
Процедура УстановитьСтатус(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Элементы.ПредупреждениеБазы.Видимость = Ложь;
	Иначе
		// Используем баннер для статуса (не блокирует форму).
		Если Не Элементы.ПредупреждениеБазы.Видимость Тогда
			Элементы.ПредупреждениеБазы.Заголовок = Текст;
			Элементы.ПредупреждениеБазы.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РаботаСИсторией

&НаСервере
Процедура ДобавитьСообщениеВИсториюЛокально(Роль, Текст, Метаинформация = "")

	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = Метаинформация;

	ОбновитьОтображениеОтвета();

КонецПроцедуры

&НаСервере
Процедура ОчиститьИсториюНаСервере()

	ИсторияДиалога.Очистить();
	ОбновитьОтображениеОтвета();

КонецПроцедуры

#КонецОбласти

#Область ОтображениеДиалога

&НаСервере
Процедура ОбновитьОтображениеОтвета()

	Если ИсторияДиалога.Количество() = 0 Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецЕсли;

	Попытка
		Шаблон = Обработки.a1c_ЧатOpenCodeV2.ПолучитьМакет("ШаблонДиалога").ПолучитьТекст();
	Исключение
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецПопытки;

	СообщенияHTML = "";
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		СообщенияHTML = СообщенияHTML + СформироватьHTMLСообщения(Сообщение);
	КонецЦикла;

	ОтветHTML = СтрЗаменить(Шаблон, "[MESSAGES]", СообщенияHTML);

	// fallback на заглушку если шаблон пустой
	Если ПустаяСтрока(ОтветHTML) Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьПустуюИсториюHTML()

	HTML = "
	|<!DOCTYPE html>
	|<html>
	|<head>
	|    <meta charset='UTF-8'>
	|    <style>
	|        body {
	|            font-family: Arial;
	|            padding: 20px;
	|            text-align: center;
	|            color: #999;
	|        }
	|    </style>
	|</head>
	|<body>
	|    <p>✎ История диалога пуста</p>
	|    <p>Задайте вопрос, чтобы начать общение</p>
	|</body>
	|</html>";

	Возврат HTML;

КонецФункции

&НаСервере
Функция СформироватьHTMLСообщения(Сообщение)

	ОписаниеРоли = ОписаниеРолиСообщения(Сообщение.Роль);
	ТекстСообщения = ОбработатьТекстСообщения(Сообщение.Текст);

	HTML = СтрШаблон("
			|<div class='message %1'>
//			|    <div class='role'>%2 %3</div>
			|    <div class='content'>%4</div>",
			ОписаниеРоли.Класс, ОписаниеРоли.Эмодзи, ОписаниеРоли.ИмяРоли, ТекстСообщения);

	Если Не ПустаяСтрока(Сообщение.Метаинформация) Тогда
		МетаHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Сообщение.Метаинформация);
		HTML = HTML + СтрШаблон("
		|    <div class='meta'>%1</div>", МетаHTML);
	КонецЕсли;

	HTML = HTML + "
			|</div>";

	Возврат HTML;

КонецФункции

// CSS-класс, подпись и эмодзи для роли сообщения диалога.
&НаСервереБезКонтекста
Функция ОписаниеРолиСообщения(Знач Роль)

	Если Роль = "user" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "user", НСтр("ru = 'Пользователь'"), "✎");
	ИначеЕсли Роль = "assistant" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "assistant", НСтр("ru = 'ИИ ассистент'"), "⚒");
	Иначе
		// Все прочие роли (включая error) рисуем как ошибку.
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "error", НСтр("ru = 'Ошибка'"), "⚠");
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОбработатьТекстСообщения(Текст)

	ТипКонтента = ОпределитьТипКонтента(Текст);

	Если ТипКонтента = "HTML" Тогда
		Возврат СтрШаблон("<pre><code class='language-html'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "JSON" Тогда
		Возврат СтрШаблон("<pre><code class='language-json'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "Markdown" Тогда
		Возврат a1c_МаркдаунПарсер.ПреобразоватьВHTML(Текст);
	Иначе
		ТекстHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст);
		ТекстHTML = СтрЗаменить(ТекстHTML, Символы.ПС, "<br>");
		Возврат ТекстHTML;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьТипКонтента(Знач Текст)

	ТекстОбрезанный = СокрЛП(Текст);

	Если ЭтоПолныйHTMLДокумент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Если ЭтоJSON(ТекстОбрезанный) Тогда
		Возврат "JSON";
	КонецЕсли;

	Если ЭтоMarkdown(Текст) Тогда
		Возврат "Markdown";
	КонецЕсли;

	Если ЭтоHTMLФрагмент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Возврат "PlainText";

КонецФункции

&НаСервере
Функция ЭтоПолныйHTMLДокумент(Текст)

	ТекстНижний = НРег(Текст);

	Если СтрНачинаетсяС(ТекстНижний, "<!doctype html") Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(ТекстНижний, "<html")
		И СтрНайти(ТекстНижний, "</html>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЭтоJSON(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Лев(Текст, 1);
	ПоследнийСимвол = Прав(Текст, 1);

	ЭтоОбъект = (ПервыйСимвол = "{" И ПоследнийСимвол = "}");
	ЭтоМассив = (ПервыйСимвол = "[" И ПоследнийСимвол = "]");

	Если НЕ (ЭтоОбъект Или ЭтоМассив) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЭтоHTMLФрагмент(Текст)

	ТекстНижний = НРег(Текст);

	НачинаетсяСТега = СтрНачинаетсяС(ТекстНижний, "<div")
		Или СтрНачинаетсяС(ТекстНижний, "<table")
		Или СтрНачинаетсяС(ТекстНижний, "<section")
		Или СтрНачинаетсяС(ТекстНижний, "<article");

	ЗаканчиваетсяТегом = СтрЗаканчиваетсяНа(ТекстНижний, "</div>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</table>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</section>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</article>");

	Возврат НачинаетсяСТега И ЗаканчиваетсяТегом;

КонецФункции

&НаСервере
Функция ЭтоMarkdown(Знач Текст)

	Возврат a1c_МаркдаунПарсер.ЭтоMarkdown(Текст);

КонецФункции

#КонецОбласти

#Область НастройкиФормы

&НаСервере
Функция ПолучитьКлючНастроек()

	Возврат "a1c_ЧатOpenCodeV2_НастройкиФормы";

КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, "НастройкиФормы");
	Исключение
		Настройки = Неопределено;
	КонецПопытки;

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		РазмерКонтекста = 5;
		ВыполнятьВФоне = Ложь;
		Возврат;
	КонецЕсли;

	Если Настройки.Свойство("ВыполнятьВФоне") Тогда
		ВыполнятьВФоне = Настройки.ВыполнятьВФоне;
	КонецЕсли;

	Если Настройки.Свойство("РазмерКонтекста") Тогда
		РазмерКонтекста = Настройки.РазмерКонтекста;
	Иначе
		РазмерКонтекста = 5;
	КонецЕсли;

	Если Настройки.Свойство("АдресБэкенда") И ЗначениеЗаполнено(Настройки.АдресБэкенда) Тогда
		АдресБэкенда = Настройки.АдресБэкенда;
	КонецЕсли;

	Если Настройки.Свойство("Агент") И ЗначениеЗаполнено(Настройки.Агент) Тогда
		Агент = Настройки.Агент;
	Иначе
		Агент = "assistant";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Настройки = Новый Структура;
	Настройки.Вставить("ВыполнятьВФоне", ВыполнятьВФоне);
	Настройки.Вставить("РазмерКонтекста", РазмерКонтекста);
	Настройки.Вставить("АдресБэкенда", ?(ЭтоРазработчик(), АдресБэкенда, АдресБэкенда()));
	Настройки.Вставить("Агент", Агент);

	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, "НастройкиФормы", Настройки);
	Исключение
		// Игнорируем ошибки сохранения настроек в расширении
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьВложенияТекстНаСервере()

	ВложенияТекст = "";
	Для Каждого СтрокаТбл Из ТаблицаВложений Цикл
		ВложенияТекст = ВложенияТекст + СтрокаТбл.Имя + " (" + СтрокаТбл.MIME + ")" + Символы.ПС;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Вспомогательные

&НаСервереБезКонтекста
Функция ОпределитьMIMEПоРасширению(Знач ИмяФайла)

	Расширение = НРег(Прав(ИмяФайла, СтрДлина(ИмяФайла) - СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца) + 1));
	Если Расширение = ".png" Тогда Возврат "image/png";
	ИначеЕсли Расширение = ".jpg" Или Расширение = ".jpeg" Тогда Возврат "image/jpeg";
	ИначеЕсли Расширение = ".webp" Тогда Возврат "image/webp";
	ИначеЕсли Расширение = ".gif" Тогда Возврат "image/gif";
	ИначеЕсли Расширение = ".pdf" Тогда Возврат "application/pdf";
	ИначеЕсли Расширение = ".json" Тогда Возврат "application/json";
	ИначеЕсли Расширение = ".xml" Тогда Возврат "application/xml";
	ИначеЕсли Расширение = ".txt" Или Расширение = ".md" Или Расширение = ".csv" Тогда Возврат "text/plain";
	Иначе Возврат "application/octet-stream";
	КонецЕсли;

КонецФункции

