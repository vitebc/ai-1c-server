// V2: асинхронный ход через опрос состояния (без внешних компонент и WS).
// Клиентское состояние опроса хранится в переменных модуля: в управляемой форме
// переменные модуля у клиента и сервера свои, поэтому на сервер всё передаётся
// явными параметрами (Form.xml менять не нужно).
// В модуле управляемой формы переменные модуля объявляются ТОЛЬКО с директивой
// компиляции (&НаКлиенте / &НаСервере): без неё платформа их не видит и падает
// с «Переменная не определена».
&НаКлиенте
Перем ОжиданиеХода;            // Истина, пока идёт ход и работает опрос
&НаКлиенте
Перем ВремяНачалаХода;         // время начала хода (мс, из квитанции prompt)
&НаКлиенте
Перем НачалоОпроса;            // локальное время старта опроса (мс) — страховка
&НаКлиенте
Перем ТекущийИдВопросаКлиент;  // id вопроса, показанного пользователю
&НаКлиенте
Перем ТекущийКлючПоля;         // ключ поля ответа (q0, q1, ...)
&НаКлиенте
Перем ТекущиеКлючиПолей;       // все ключи полей вопроса — отвечаем каждому

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = АдресБэкенда();
	КонецЕсли;

	ВыполнятьВФоне = Истина;

	ЗагрузитьНастройкиФормы();

	// Список агентов и проверка доступности сервера — одним запросом:
	// при сбое ЗаполнитьСписокАгентов сам показывает баннер.
	ЗаполнитьСписокАгентов();

	ОбновитьОтображениеОтвета();
	Элементы.АдресБэкенда.Доступность = ЭтоРазработчик();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОстановитьОпроса();

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АдресБэкендаПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнятьВФонеПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура РазмерКонтекстаПриИзменении(Элемент)

	Если РазмерКонтекста < 0 Тогда
		РазмерКонтекста = 0;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура АгентПриИзменении()

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область Агенты

// Дропдаун агентов сервера OpenCode: только mode="primary" и не hidden.
&НаСервере
Процедура ЗаполнитьСписокАгентов()

	Элементы.Агент.СписокВыбора.Очистить();
	АгентПоУмолчанию = "assistant";
	СписокАгентов = Неопределено;
	ТекстОшибки = "";

	// Первый HTTP-запрос в холодном сеансе иногда не доходит до сервера —
	// вторая попытка лечит это без перезапуска формы.
	Для НомерПопытки = 1 По 2 Цикл
		Попытка
			СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
			// При ошибке модуль возвращает массив с одной строкой диагностики
			// (код HTTP и тело ответа) — не глотаем её молча.
			Если СписокАгентов.Количество() > 0 И ТипЗнч(СписокАгентов[0]) = Тип("Строка") Тогда
				ТекстОшибки = СписокАгентов[0];
				СписокАгентов = Неопределено;
			Иначе
				ТекстОшибки = "";
				Прервать;
			КонецЕсли;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			СписокАгентов = Неопределено;
		КонецПопытки;
	КонецЦикла;

	Если СписокАгентов = Неопределено Или СписокАгентов.Количество() = 0 Тогда
		// Сервер недоступен — один дефолт, форму всё равно открываем.
		Элементы.Агент.СписокВыбора.Добавить("assistant", НСтр("ru = 'Ассистент'"));
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ПредупреждениеБазы = СтрШаблон(
				НСтр("ru = 'Сервер OpenCode недоступен (%1): %2'"),
				АдресБэкенда, ТекстОшибки);
			Элементы.ПредупреждениеБазы.Заголовок = ПредупреждениеБазы;
			Элементы.ПредупреждениеБазы.Видимость = Истина;
		КонецЕсли;
	Иначе
		Для Каждого СтрокаАгента Из СписокАгентов Цикл
			Элементы.Агент.СписокВыбора.Добавить(СтрокаАгента.id, СтрокаАгента.name);
		КонецЦикла;
	КонецЕсли;

	// Текущее значение обязано быть из списка, иначе сброс на дефолт.
	Если Элементы.Агент.СписокВыбора.НайтиПоЗначению(Агент) = Неопределено Тогда
		Агент = АгентПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(Промпт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите промпт'"));
		Возврат;
	КонецЕсли;

	Если ОжиданиеХода Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"));
		Возврат;
	КонецЕсли;

	Элементы.Отправить.Доступность = Ложь;

	ТекущийПромпт = Промпт;
	Промпт = "";

	ДобавитьСообщениеВИсториюЛокально("user", ТекущийПромпт);
	УстановитьСтатусНаКлиенте(НСтр("ru = 'Размышляю...'"));

	Результат = НачатьХодНаСервере(ТекущийПромпт);
	Если Результат.ЭтоОшибка Тогда
		ОстановитьОпроса();
		УстановитьСтатусНаКлиенте("");
		Элементы.Отправить.Доступность = Истина;
		ДобавитьСообщениеВИсториюЛокально("error", Результат.ТекстОшибки);
		Возврат;
	КонецЕсли;

	// Ход запущен: опрашиваем состояние, пока сервер не скажет «завершено».
	ВремяНачалаХода = Результат.ВремяНачала;
	НачалоОпроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОжиданиеХода = Истина;
	ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	ОстановитьОпроса();
	Элементы.Отправить.Доступность = Истина;

	Промпт = "";
	ИдентификаторСессии = ""; // новый диалог — новая сессия сервера OpenCode
	ОтветНаВопрос = "";
	Элементы.ГруппаВопроса.Видимость = Ложь;
	ТекущийИдВопросаКлиент = "";
	ТекущийКлючПоля = "";
	ТекущиеКлючиПолей = Новый Массив;

	УстановитьСтатусНаКлиенте("");
	ОчиститьИсториюНаСервере();
	ТаблицаВложений.Очистить();
	ВложенияТекст = "";

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлы(Команда)

	ПоказатьПредупреждение(, НСтр("ru = 'Прикрепление файлов появится позже'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВложения(Команда)

	ТаблицаВложений.Очистить();
	ВложенияТекст = "";
	ОбновитьВложенияТекстНаСервере();

КонецПроцедуры

// V2: ответить на вопрос модели — POST /form/{fid}/reply, после чего опрос
// возобновляется и модель дописывает ответ.
&НаКлиенте
Процедура ОтветитьНаВопрос(Команда)

	Если ПустаяСтрока(ОтветНаВопрос) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите ответ на вопрос'"));
		Возврат;
	КонецЕсли;

	ТекстОтвета = ОтветНаВопрос;
	УстановитьСтатусНаКлиенте(НСтр("ru = 'Ожидание продолжения...'"));

	Успех = ОтветитьНаВопросНаСервере(ТекущийИдВопросаКлиент, ТекущиеКлючиПолей, ТекстОтвета);
	Если Не Успех Тогда
		// Ответ не ушёл: вопрос остаётся на экране, ответ можно повторить —
		// опрос не трогаем, он и так ждёт ввода.
		УстановитьСтатусНаКлиенте(НСтр("ru = 'Ассистент ждёт ответа на вопрос'"));
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось отправить ответ на вопрос. Попробуйте ещё раз.'"));
		Возврат;
	КонецЕсли;

	// Ответ ушёл: вопрос отвечен, опрос возобновляется и продлевает таймаут.
	ОтветНаВопрос = "";
	Элементы.ГруппаВопроса.Видимость = Ложь;
	ТекущийИдВопросаКлиент = "";
	ТекущийКлючПоля = "";
	ТекущиеКлючиПолей = Новый Массив;

	ДобавитьСообщениеВИсториюЛокально("user", ТекстОтвета);

	Если ОжиданиеХода Тогда
		НачалоОпроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОпросХода

// V2: один шаг опроса. 1С не умеет пушить данные в открытую форму, поэтому
// клиент по таймеру запрашивает состояние хода на сервере.
&НаКлиенте
Процедура ОбработчикОпросаХода()

	Если Не ОжиданиеХода Тогда
		// Ход уже завершён или форму очистили — не перевзводим таймер.
		Возврат;
	КонецЕсли;

	// Страховка: 10 минут без завершения — прекращаем опрос, чтобы кнопка
	// «Отправить» не осталась заблокированной навсегда.
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОпроса > 600000 Тогда
		ОстановитьОпроса();
		УстановитьСтатусНаКлиенте("");
		Элементы.Отправить.Доступность = Истина;
		ДобавитьСообщениеВИсториюЛокально("error",
			НСтр("ru = 'Превышено время ожидания ответа (10 минут). Опрос остановлен.'"));
		Возврат;
	КонецЕсли;

	Состояние = ОбновитьХодНаСервере(ВремяНачалаХода);

	Если Состояние.ЭтоОшибка Тогда
		ОстановитьОпроса();
		УстановитьСтатусНаКлиенте("");
		Элементы.Отправить.Доступность = Истина;
		ДобавитьСообщениеВИсториюЛокально("error", Состояние.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Если Состояние.ЕстьВопрос Тогда
		ТекущийИдВопросаКлиент = Состояние.ИдВопроса;
		ТекущийКлючПоля = Состояние.КлючПоля;
		ТекущиеКлючиПолей = Состояние.Ключи;
		УстановитьСтатусНаКлиенте(НСтр("ru = 'Ассистент ждёт ответа на вопрос'"));
		// Ждём ответа пользователя: опрос возобновится из ОтветитьНаВопрос.
		Возврат;
	КонецЕсли;

	Если Состояние.Завершено Тогда
		ОстановитьОпроса();
		УстановитьСтатусНаКлиенте("");
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);

КонецПроцедуры

// V2: остановить опрос (закрытие формы, очистка диалога, ошибка).
&НаКлиенте
Процедура ОстановитьОпроса()

	ОжиданиеХода = Ложь;
	ОтключитьОбработчикОжидания("ОбработчикОпросаХода");

КонецПроцедуры

// V2: статус в баннере (клиент — чтобы не делать лишний серверный вызов).
&НаКлиенте
Процедура УстановитьСтатусНаКлиенте(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Элементы.ПредупреждениеБазы.Видимость = Ложь;
	Иначе
		Элементы.ПредупреждениеБазы.Заголовок = Текст;
		Элементы.ПредупреждениеБазы.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

// V2: начать ход — отправить промпт без ожидания (wait не нужен).
// Возвращает {ЭтоОшибка, ТекстОшибки, ВремяНачала}.
&НаСервере
Функция НачатьХодНаСервере(Знач ТекстПромпта)

	Результат = Новый Структура("ЭтоОшибка, ТекстОшибки, ВремяНачала", Истина, "", 0);

	Попытка
		Ответ = a1c_ЧатOpenCodeФоновый.ОтправитьПромптБезОжидания(
			ТекстПромпта, АдресБэкенда, ИдентификаторСессии, Агент);
	Исключение
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось отправить запрос: '") + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если Ответ.ЭтоОшибка Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ответ.ИдентификаторСессии) Тогда
		ИдентификаторСессии = Ответ.ИдентификаторСессии;
	КонецЕсли;

	Результат.ЭтоОшибка = Ложь;
	Результат.ВремяНачала = Ответ.ВремяНачала;

	Возврат Результат;

КонецФункции

// V2: шаг опроса на сервере — текст ответа, вопрос модели, завершение хода.
// Возвращает {ЭтоОшибка, ТекстОшибки, Завершено, ЕстьВопрос, ИдВопроса, КлючПоля}.
&НаСервере
Функция ОбновитьХодНаСервере(Знач ВремяНачала)

	ПустыеКлючи = Новый Массив;
	Результат = Новый Структура("ЭтоОшибка, ТекстОшибки, Завершено, ЕстьВопрос, ИдВопроса, КлючПоля, Ключи",
		Ложь, "", Ложь, Ложь, "", "", ПустыеКлючи);

	Попытка
		Состояние = a1c_ЧатOpenCodeФоновый.ПолучитьСостояниеХода(
			АдресБэкенда, ИдентификаторСессии, ВремяНачала);
	Исключение
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ошибка опроса состояния хода: '") + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если Состояние.ЭтоОшибка Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = Состояние.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	// Пустой пузырь не создаём: строка assistant появляется с первым текстом.
	Если Не ПустаяСтрока(Состояние.Текст) Тогда
		ОбновитьТекстОтвета(Состояние.Текст);
	КонецЕсли;

	Если Состояние.Вопрос <> Неопределено Тогда
		КлючПоля = "";
		Ключи = Новый Массив;
		Для Каждого Поле Из Состояние.Вопрос.Поля Цикл
			Если Не ПустаяСтрока(Поле.key) Тогда
				Ключи.Добавить(Поле.key);
			КонецЕсли;
		КонецЦикла;
		Если Ключи.Количество() > 0 Тогда
			КлючПоля = Ключи[0];
		КонецЕсли;
		// Показываем вопрос один раз — повторный опрос его не дублирует.
		Если Состояние.Вопрос.id <> ТекущийИдВопроса Тогда
			ПоказатьВопрос(Состояние.Вопрос);
		КонецЕсли;
		Результат.ЕстьВопрос = Истина;
		Результат.ИдВопроса = Состояние.Вопрос.id;
		Результат.КлючПоля = КлючПоля;
		Результат.Ключи = Ключи;
	КонецЕсли;

	Если Состояние.Завершено Тогда
		ЗавершитьХодНаСервере(Состояние);
		Результат.Завершено = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// V2: показать вопрос модели (pending-форма) и запомнить его id для ответа.
&НаСервере
Процедура ПоказатьВопрос(Знач Вопрос)

	ИдВопроса = ?(Вопрос.Свойство("id"), Вопрос.id, "");
	Если ПустаяСтрока(ИдВопроса) Тогда
		Возврат;
	КонецЕсли;

	ТекущийИдВопроса = ИдВопроса;

	Текст = "";
	ЗаголовокФормы = ?(Вопрос.Свойство("title"), Вопрос.title, "");
	// «Questions» — служебный заголовок формы, пользователю он не нужен.
	Если Не ПустаяСтрока(ЗаголовокФормы) И НРег(ЗаголовокФормы) <> "questions" Тогда
		Текст = ЗаголовокФормы;
	КонецЕсли;

	Для Каждого Поле Из Вопрос.Поля Цикл
		ЗаголовокПоля = ?(Поле.Свойство("title"), Поле.title, "");
		ОписаниеПоля = ?(Поле.Свойство("description"), Поле.description, "");
		Если Не ПустаяСтрока(ЗаголовокПоля) Тогда
			Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС) + ЗаголовокПоля;
		КонецЕсли;
		Если Не ПустаяСтрока(ОписаниеПоля) Тогда
			Текст = Текст + Символы.ПС + ОписаниеПоля;
		КонецЕсли;
		Для Каждого Вариант Из Поле.Варианты Цикл
			МеткаВарианта = ?(Вариант.Свойство("label"), Вариант.label, "");
			Если Не ПустаяСтрока(МеткаВарианта) Тогда
				Текст = Текст + Символы.ПС + "  • " + МеткаВарианта;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ПустаяСтрока(Текст) Тогда
		Текст = НСтр("ru = 'Ассистент задаёт вопрос'");
	КонецЕсли;

	Элементы.ТекстВопроса.Заголовок = Текст;
	ОтветНаВопрос = "";
	Элементы.ГруппаВопроса.Видимость = Истина;

	// Вопрос попадает в историю как сообщение ассистента с пометкой.
	ДобавитьСообщениеВИсториюЛокально("assistant", Текст, НСтр("ru = '❓ Вопрос'"));

КонецПроцедуры

// V2: финал хода — метаинформация в пузырь ответа, ошибка модели отдельным
// пузырём, сброс текущего вопроса.
&НаСервере
Процедура ЗавершитьХодНаСервере(Знач Состояние)

	ТекущийИдВопроса = "";
	ОтветНаВопрос = "";
	Элементы.ГруппаВопроса.Видимость = Ложь;

	Если Не ПустаяСтрока(Состояние.ОшибкаМодели) Тогда
		ДобавитьСообщениеВИсториюЛокально("error", Состояние.ОшибкаМодели);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Состояние.Текст) Тогда
		ДобавитьСообщениеВИсториюЛокально("error",
			НСтр("ru = 'Модель не вернула текстового ответа (только служебные шаги). Попробуйте ещё раз.'"));
		Возврат;
	КонецЕсли;

	Метаинформация = СформироватьМетаинформацию(Состояние);
	Если ПустаяСтрока(Метаинформация) Тогда
		Возврат;
	КонецЕсли;

	// Метаинформация ставится последнему пузырю ответа текущего хода.
	Индекс = ИсторияДиалога.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ИсторияДиалога[Индекс].Роль = "assistant"
			И ПустаяСтрока(ИсторияДиалога[Индекс].Метаинформация) Тогда
			ИсторияДиалога[Индекс].Метаинформация = Метаинформация;
			ОбновитьОтображениеОтвета();
			Возврат;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// V2: «модель • токены • секунды» для подписи пузыря ответа.
&НаСервереБезКонтекста
Функция СформироватьМетаинформацию(Знач Состояние)

	Части = Новый Массив;
	Если Не ПустаяСтрока(Состояние.Модель) Тогда
		Части.Добавить(Состояние.Модель);
	КонецЕсли;
	Если Состояние.Токены > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 токенов'"), Строка(Состояние.Токены)));
	КонецЕсли;
	Если Состояние.Секунды > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 с'"), Формат(Состояние.Секунды, "ЧДЦ=1")));
	КонецЕсли;

	Возврат СтрСоединить(Части, " • ");

КонецФункции

#КонецОбласти

#Область ВыполнениеЗапроса

// V2: обновить текст ответа (потоковая отрисовка). Ищет последнюю строку
// assistant в истории и обновляет её текст; если нет — создаёт новую.
&НаСервере
Процедура ОбновитьТекстОтвета(Знач Текст)

	// Ищем последнюю строку с ролью "assistant" (без метаинформации — значит,
	// это текущий ход, ещё не завершён).
	Индекс = ИсторияДиалога.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ИсторияДиалога[Индекс].Роль = "assistant"
			И ПустаяСтрока(ИсторияДиалога[Индекс].Метаинформация) Тогда
			// Текст не изменился — не перерисовываем HTML: полная перерисовка
			// каждые 0.5 с сбрасывает прокрутку и зря грузит сервер.
			Если ИсторияДиалога[Индекс].Текст = Текст Тогда
				Возврат;
			КонецЕсли;
			ИсторияДиалога[Индекс].Текст = Текст;
			ОбновитьОтображениеОтвета();
			Возврат;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	// Нет незавершённой строки assistant — создаём новую.
	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = "assistant";
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = "";

	ОбновитьОтображениеОтвета();

КонецПроцедуры

// V2: серверный вызов reply на вопрос модели.
&НаСервере
Функция ОтветитьНаВопросНаСервере(Знач ИдФормы, Знач Ключи, Знач ТекстОтвета)

	Если ПустаяСтрока(ИдФормы) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Ключи) = Тип("Массив") И Ключи.Количество() = 0 Тогда
		Ключи = "q0";
	КонецЕсли;
	Если Ключи = Неопределено Тогда
		Ключи = "q0";
	КонецЕсли;

	Успех = Ложь;
	Попытка
		Успех = a1c_ЧатOpenCodeФоновый.ОтветитьНаВопрос(
			АдресБэкенда, ИдентификаторСессии, ИдФормы, Ключи, ТекстОтвета);
	Исключение
		Успех = Ложь;
	КонецПопытки;

	Если Успех Тогда
		// Вопрос отвечен: скрываем группу и на сервере, иначе её состояние
		// «видима» вернётся на клиент при следующем серверном вызове.
		ОтветНаВопрос = "";
		Элементы.ГруппаВопроса.Видимость = Ложь;
	КонецЕсли;

	Возврат Успех;

КонецФункции

#КонецОбласти

#Область РаботаСИсторией

&НаСервере
Процедура ДобавитьСообщениеВИсториюЛокально(Роль, Текст, Метаинформация = "")

	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = Метаинформация;

	ОбновитьОтображениеОтвета();

КонецПроцедуры

&НаСервере
Процедура ОчиститьИсториюНаСервере()

	ИсторияДиалога.Очистить();
	// Состояние вопроса живёт и на сервере: без сброса группа снова станет
	// видимой после ближайшего серверного вызова.
	ТекущийИдВопроса = "";
	ОтветНаВопрос = "";
	Элементы.ГруппаВопроса.Видимость = Ложь;
	ОбновитьОтображениеОтвета();

КонецПроцедуры

#КонецОбласти

#Область ОтображениеДиалога

&НаСервере
Процедура ОбновитьОтображениеОтвета()

	Если ИсторияДиалога.Количество() = 0 Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецЕсли;

	Попытка
		Шаблон = Обработки.a1c_ЧатOpenCodeV2.ПолучитьМакет("ШаблонДиалога").ПолучитьТекст();
	Исключение
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецПопытки;

	СообщенияHTML = "";
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		СообщенияHTML = СообщенияHTML + СформироватьHTMLСообщения(Сообщение);
	КонецЦикла;

	ОтветHTML = СтрЗаменить(Шаблон, "[MESSAGES]", СообщенияHTML);

	// fallback на заглушку если шаблон пустой
	Если ПустаяСтрока(ОтветHTML) Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьПустуюИсториюHTML()

	HTML = "
	|<!DOCTYPE html>
	|<html>
	|<head>
	|    <meta charset='UTF-8'>
	|    <style>
	|        body {
	|            font-family: Arial;
	|            padding: 20px;
	|            text-align: center;
	|            color: #999;
	|        }
	|    </style>
	|</head>
	|<body>
	|    <p>✎ История диалога пуста</p>
	|    <p>Задайте вопрос, чтобы начать общение</p>
	|</body>
	|</html>";

	Возврат HTML;

КонецФункции

&НаСервере
Функция СформироватьHTMLСообщения(Сообщение)

	ОписаниеРоли = ОписаниеРолиСообщения(Сообщение.Роль);
	ТекстСообщения = ОбработатьТекстСообщения(Сообщение.Текст);

	HTML = СтрШаблон("
			|<div class='message %1'>
//			|    <div class='role'>%2 %3</div>
			|    <div class='content'>%4</div>",
			ОписаниеРоли.Класс, ОписаниеРоли.Эмодзи, ОписаниеРоли.ИмяРоли, ТекстСообщения);

	Если Не ПустаяСтрока(Сообщение.Метаинформация) Тогда
		МетаHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Сообщение.Метаинформация);
		HTML = HTML + СтрШаблон("
		|    <div class='meta'>%1</div>", МетаHTML);
	КонецЕсли;

	HTML = HTML + "
			|</div>";

	Возврат HTML;

КонецФункции

// CSS-класс, подпись и эмодзи для роли сообщения диалога.
&НаСервереБезКонтекста
Функция ОписаниеРолиСообщения(Знач Роль)

	Если Роль = "user" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "user", НСтр("ru = 'Пользователь'"), "✎");
	ИначеЕсли Роль = "assistant" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "assistant", НСтр("ru = 'ИИ ассистент'"), "⚒");
	Иначе
		// Все прочие роли (включая error) рисуем как ошибку.
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "error", НСтр("ru = 'Ошибка'"), "⚠");
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОбработатьТекстСообщения(Текст)

	ТипКонтента = ОпределитьТипКонтента(Текст);

	Если ТипКонтента = "HTML" Тогда
		Возврат СтрШаблон("<pre><code class='language-html'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "JSON" Тогда
		Возврат СтрШаблон("<pre><code class='language-json'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "Markdown" Тогда
		Возврат a1c_МаркдаунПарсер.ПреобразоватьВHTML(Текст);
	Иначе
		ТекстHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст);
		ТекстHTML = СтрЗаменить(ТекстHTML, Символы.ПС, "<br>");
		Возврат ТекстHTML;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьТипКонтента(Знач Текст)

	ТекстОбрезанный = СокрЛП(Текст);

	Если ЭтоПолныйHTMLДокумент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Если ЭтоJSON(ТекстОбрезанный) Тогда
		Возврат "JSON";
	КонецЕсли;

	Если ЭтоMarkdown(Текст) Тогда
		Возврат "Markdown";
	КонецЕсли;

	Если ЭтоHTMLФрагмент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Возврат "PlainText";

КонецФункции

&НаСервере
Функция ЭтоПолныйHTMLДокумент(Текст)

	ТекстНижний = НРег(Текст);

	Если СтрНачинаетсяС(ТекстНижний, "<!doctype html") Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(ТекстНижний, "<html")
		И СтрНайти(ТекстНижний, "</html>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЭтоJSON(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Лев(Текст, 1);
	ПоследнийСимвол = Прав(Текст, 1);

	ЭтоОбъект = (ПервыйСимвол = "{" И ПоследнийСимвол = "}");
	ЭтоМассив = (ПервыйСимвол = "[" И ПоследнийСимвол = "]");

	Если НЕ (ЭтоОбъект Или ЭтоМассив) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЭтоHTMLФрагмент(Текст)

	ТекстНижний = НРег(Текст);

	НачинаетсяСТега = СтрНачинаетсяС(ТекстНижний, "<div")
		Или СтрНачинаетсяС(ТекстНижний, "<table")
		Или СтрНачинаетсяС(ТекстНижний, "<section")
		Или СтрНачинаетсяС(ТекстНижний, "<article");

	ЗаканчиваетсяТегом = СтрЗаканчиваетсяНа(ТекстНижний, "</div>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</table>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</section>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</article>");

	Возврат НачинаетсяСТега И ЗаканчиваетсяТегом;

КонецФункции

&НаСервере
Функция ЭтоMarkdown(Знач Текст)

	Возврат a1c_МаркдаунПарсер.ЭтоMarkdown(Текст);

КонецФункции

#КонецОбласти

#Область НастройкиФормы

&НаСервере
Функция ПолучитьКлючНастроек()

	Возврат "a1c_ЧатOpenCodeV2_НастройкиФормы";

КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, "НастройкиФормы");
	Исключение
		Настройки = Неопределено;
	КонецПопытки;

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		РазмерКонтекста = 5;
		ВыполнятьВФоне = Ложь;
		Возврат;
	КонецЕсли;

	Если Настройки.Свойство("ВыполнятьВФоне") Тогда
		ВыполнятьВФоне = Настройки.ВыполнятьВФоне;
	КонецЕсли;

	Если Настройки.Свойство("РазмерКонтекста") Тогда
		РазмерКонтекста = Настройки.РазмерКонтекста;
	Иначе
		РазмерКонтекста = 5;
	КонецЕсли;

	Если Настройки.Свойство("АдресБэкенда") И ЗначениеЗаполнено(Настройки.АдресБэкенда) Тогда
		АдресБэкенда = Настройки.АдресБэкенда;
	КонецЕсли;

	Если Настройки.Свойство("Агент") И ЗначениеЗаполнено(Настройки.Агент) Тогда
		Агент = Настройки.Агент;
	Иначе
		Агент = "assistant";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Настройки = Новый Структура;
	Настройки.Вставить("ВыполнятьВФоне", ВыполнятьВФоне);
	Настройки.Вставить("РазмерКонтекста", РазмерКонтекста);
	Настройки.Вставить("АдресБэкенда", ?(ЭтоРазработчик(), АдресБэкенда, АдресБэкенда()));
	Настройки.Вставить("Агент", Агент);

	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, "НастройкиФормы", Настройки);
	Исключение
		// Игнорируем ошибки сохранения настроек в расширении
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьВложенияТекстНаСервере()

	ВложенияТекст = "";
	Для Каждого СтрокаТбл Из ТаблицаВложений Цикл
		ВложенияТекст = ВложенияТекст + СтрокаТбл.Имя + " (" + СтрокаТбл.MIME + ")" + Символы.ПС;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Вспомогательные

&НаСервереБезКонтекста
Функция ОпределитьMIMEПоРасширению(Знач ИмяФайла)

	Расширение = НРег(Прав(ИмяФайла, СтрДлина(ИмяФайла) - СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца) + 1));
	Если Расширение = ".png" Тогда Возврат "image/png";
	ИначеЕсли Расширение = ".jpg" Или Расширение = ".jpeg" Тогда Возврат "image/jpeg";
	ИначеЕсли Расширение = ".webp" Тогда Возврат "image/webp";
	ИначеЕсли Расширение = ".gif" Тогда Возврат "image/gif";
	ИначеЕсли Расширение = ".pdf" Тогда Возврат "application/pdf";
	ИначеЕсли Расширение = ".json" Тогда Возврат "application/json";
	ИначеЕсли Расширение = ".xml" Тогда Возврат "application/xml";
	ИначеЕсли Расширение = ".txt" Или Расширение = ".md" Или Расширение = ".csv" Тогда Возврат "text/plain";
	Иначе Возврат "application/octet-stream";
	КонецЕсли;

КонецФункции

