#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = АдресБэкенда();
	КонецЕсли;

	ВыполнятьВФоне = Истина;

	ЗагрузитьНастройкиФормы();
	ЗаполнитьСписокАгентов();
	ПроверитьДоступностьСервера();
	ОбновитьОтображениеОтвета();
	Элементы.АдресБэкенда.Доступность = ЭтоРазработчик();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АдресБэкендаПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнятьВФонеПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура РазмерКонтекстаПриИзменении(Элемент)

	Если РазмерКонтекста < 0 Тогда
		РазмерКонтекста = 0;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура АгентПриИзменении()

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область Агенты

// Дропдаун агентов сервера OpenCode: только mode="primary" и не hidden.
&НаСервере
Процедура ЗаполнитьСписокАгентов()

	Элементы.Агент.СписокВыбора.Очистить();
	АгентПоУмолчанию = "assistant";
	Попытка
		СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
		Если СписокАгентов.Количество() = 0 Тогда
			Элементы.Агент.СписокВыбора.Добавить("assistant", НСтр("ru = 'Ассистент'"));
		Иначе
			Для Каждого СтрокаАгента Из СписокАгентов Цикл
				Элементы.Агент.СписокВыбора.Добавить(СтрокаАгента.id, СтрокаАгента.name);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Сервер недоступен — один дефолт, форму всё равно открываем.
		Элементы.Агент.СписокВыбора.Добавить("assistant", НСтр("ru = 'Ассистент'"));
	КонецПопытки;

	// Текущее значение обязано быть из списка, иначе сброс на дефолт.
	Если Элементы.Агент.СписокВыбора.НайтиПоЗначению(Агент) = Неопределено Тогда
		Агент = АгентПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроверкаСервера

// Стартовая проверка доступности сервера OpenCode (GET /api/agent): при сбое —
// баннер, форму не блокируем.
&НаСервере
Процедура ПроверитьДоступностьСервера()

	ПредупреждениеБазы = "";
	Элементы.ПредупреждениеБазы.Видимость = Ложь;
	Попытка
		СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
		Если СписокАгентов.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'сервер вернул пустой список агентов'");
		КонецЕсли;
	Исключение
		ПредупреждениеБазы = СтрШаблон(
			НСтр("ru = 'Сервер OpenCode недоступен (%1): %2'"),
			АдресБэкенда,
			ОписаниеОшибки());
		Элементы.ПредупреждениеБазы.Заголовок = ПредупреждениеБазы;
		Элементы.ПредупреждениеБазы.Видимость = Истина;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(Промпт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите промпт'"));
		Возврат;
	КонецЕсли;

	Элементы.Отправить.Доступность = Ложь;

	ТекущийПромпт = Промпт;
	Промпт = "";

	ЗапуститьЗапросВФоне(ТекущийПромпт);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	Промпт = "";
	ИдентификаторСессии = ""; // новый диалог — новая сессия сервера OpenCode
	ОчиститьИсториюНаСервере();
	ТаблицаВложений.Очистить();
	ВложенияТекст = "";

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлы(Команда)

	ПоказатьПредупреждение(, НСтр("ru = 'Прикрепление файлов появится позже'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВложения(Команда)

	ТаблицаВложений.Очистить();
	ВложенияТекст = "";
	ОбновитьВложенияТекстНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыполнениеЗапроса

&НаКлиенте
Процедура ЗапуститьЗапросВФоне(ТекстПромпта)

	ДобавитьСообщениеВИсториюЛокально("user", ТекстПромпта);

	Попытка
		ДлительнаяОперация = ЗапуститьЗапросВФонеНаСервере(ТекстПромпта);
	Исключение
		// Платформенная ошибка запуска: пользователю — короткий текст, детали — в журнал.
		ЗаписьЖурналаРегистрации(
			"ИИ-чат",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстОшибки = НСтр("ru = 'Не удалось запустить фоновое задание. Подробности — в журнале регистрации.'");

		ДобавитьСообщениеВИсториюЛокально("error", ТекстОшибки);

		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецПопытки;

	Если ДлительнаяОперация = Неопределено Тогда
		ДобавитьСообщениеВИсториюЛокально("error", НСтр("ru = 'Не удалось запустить фоновое задание'"));
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецЕсли;

	// Неблокирующее ожидание: стандартное окно ожидания БСП с прогрессом,
	// результат приходит в А1c_ПослеЗапроса (ОписаниеОповещения).
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Размышляю...";

	ОповещениеОЗавершении = Новый ОписаниеОповещения("А1c_ПослеЗапроса", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура А1c_ПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт

	// Обработчик завершения длительной операции (ДлительныеОперацииКлиент.ОжидатьЗавершение).
	Элементы.Отправить.Доступность = Истина;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ПодробноеПредставлениеОшибки(Результат.ИнформацияОбОшибке);
		Исключение
		КонецПопытки;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = НСтр(
				"ru = 'Не удалось получить ответ: сервер OpenCode вернул ошибку. Попробуйте ещё раз или сообщите администратору.'");
		КонецЕсли;
		ДобавитьСообщениеВИсториюЛокально("error", ТекстОшибки);
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Отменено" Тогда
		ДобавитьСообщениеВИсториюЛокально("error", НСтр("ru = 'Запрос отменён'"));
		Возврат;
	КонецЕсли;

	Попытка
		РезультатЗапроса = ПолучитьРезультатИзХранилища(Результат.АдресРезультата);
	Исключение
		РезультатЗапроса = Неопределено;
	КонецПопытки;

	Если РезультатЗапроса <> Неопределено Тогда
		// Сессия из фонового результата, иначе следующий вопрос — без контекста.
		Если ТипЗнч(РезультатЗапроса) = Тип("Структура")
			И РезультатЗапроса.Свойство("ИдентификаторСессии")
			И ЗначениеЗаполнено(РезультатЗапроса.ИдентификаторСессии) Тогда
			ИдентификаторСессии = РезультатЗапроса.ИдентификаторСессии;
		КонецЕсли;
		ПроцессИтогиЗапроса(РезультатЗапроса);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗапуститьЗапросВФонеНаСервере(Знач ТекстПромпта)

	// БСП ДлительныеОперации: запуск функции общего модуля в фоновом задании.
	// Возвращает структуру ДлительнаяОперация (Статус/ИдентификаторЗадания/
	// АдресРезультата) — сериализуется в XDTO и передаётся на клиент, в отличие
	// от объекта ФоновоеЗадание.
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Размышляю...'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"a1c_ЧатOpenCodeФоновый.ВыполнитьЗапрос",
		ТекстПромпта,
		АдресБэкенда,
		ИдентификаторСессии,
		Агент);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРезультатИзХранилища(Знач АдресРезультата)

	Если ПустаяСтрока(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПроцессИтогиЗапроса(РезультатЗапроса)

	Если РезультатЗапроса = Неопределено Тогда
		ДобавитьСообщениеВИсториюЛокально("error", НСтр("ru = 'Пустой ответ сервера'"));
		Возврат;
	КонецЕсли;

	Если РезультатЗапроса.ЭтоОшибка Тогда
		ДобавитьСообщениеВИсториюЛокально("error", РезультатЗапроса.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Метаинформация = СформироватьМетаинформацию(РезультатЗапроса);
	ДобавитьСообщениеВИсториюЛокально("assistant", РезультатЗапроса.ТекстОтвета, Метаинформация);
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" Тогда
			СтрокаТаблицы.Отправлять = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РаботаСИсторией

&НаСервере
Процедура ДобавитьСообщениеВИсториюЛокально(Роль, Текст, Метаинформация = "")

	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = Метаинформация;

	ОбновитьОтображениеОтвета();

КонецПроцедуры

&НаКлиенте
Функция СформироватьМетаинформацию(РезультатЗапроса)

	МодельОтвета = ?(ПустаяСтрока(РезультатЗапроса.МодельОтвета),
		"N/A",
		РезультатЗапроса.МодельОтвета);

	Метаинформация = СтрШаблон(
		НСтр("ru = '⚡ Токены: %1 | ⏱ Время: %2с | ⚒ Модель: %3'"),
		РезультатЗапроса.ВсегоТокенов,
		Формат(РезультатЗапроса.ВремяОтветаСекунд, "ЧЦ=5; ЧДЦ=1"),
		МодельОтвета);

	Возврат Метаинформация;

КонецФункции

&НаСервере
Процедура ОчиститьИсториюНаСервере()

	ИсторияДиалога.Очистить();
	ОбновитьОтображениеОтвета();

КонецПроцедуры

#КонецОбласти

#Область ОтображениеДиалога

&НаСервере
Процедура ОбновитьОтображениеОтвета()

	Если ИсторияДиалога.Количество() = 0 Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецЕсли;

	Попытка
		Шаблон = Обработки.a1c_ЧатOpenCode.ПолучитьМакет("ШаблонДиалога").ПолучитьТекст();
	Исключение
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецПопытки;

	СообщенияHTML = "";
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		СообщенияHTML = СообщенияHTML + СформироватьHTMLСообщения(Сообщение);
	КонецЦикла;

	ОтветHTML = СтрЗаменить(Шаблон, "[MESSAGES]", СообщенияHTML);

	// fallback на заглушку если шаблон пустой
	Если ПустаяСтрока(ОтветHTML) Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьПустуюИсториюHTML()

	HTML = "
	|<!DOCTYPE html>
	|<html>
	|<head>
	|    <meta charset='UTF-8'>
	|    <style>
	|        body {
	|            font-family: Arial;
	|            padding: 20px;
	|            text-align: center;
	|            color: #999;
	|        }
	|    </style>
	|</head>
	|<body>
	|    <p>✎ История диалога пуста</p>
	|    <p>Задайте вопрос, чтобы начать общение</p>
	|</body>
	|</html>";

	Возврат HTML;

КонецФункции

&НаСервере
Функция СформироватьHTMLСообщения(Сообщение)

	ОписаниеРоли = ОписаниеРолиСообщения(Сообщение.Роль);
	ТекстСообщения = ОбработатьТекстСообщения(Сообщение.Текст);

	HTML = СтрШаблон("
			|<div class='message %1'>
//			|    <div class='role'>%2 %3</div>
			|    <div class='content'>%4</div>",
			ОписаниеРоли.Класс, ОписаниеРоли.Эмодзи, ОписаниеРоли.ИмяРоли, ТекстСообщения);

	Если Не ПустаяСтрока(Сообщение.Метаинформация) Тогда
		МетаHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Сообщение.Метаинформация);
		HTML = HTML + СтрШаблон("
		|    <div class='meta'>%1</div>", МетаHTML);
	КонецЕсли;

	HTML = HTML + "
			|</div>";

	Возврат HTML;

КонецФункции

// CSS-класс, подпись и эмодзи для роли сообщения диалога.
&НаСервереБезКонтекста
Функция ОписаниеРолиСообщения(Знач Роль)

	Если Роль = "user" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "user", НСтр("ru = 'Пользователь'"), "✎");
	ИначеЕсли Роль = "assistant" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "assistant", НСтр("ru = 'ИИ ассистент'"), "⚒");
	Иначе
		// Все прочие роли (включая error) рисуем как ошибку.
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "error", НСтр("ru = 'Ошибка'"), "⚠");
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОбработатьТекстСообщения(Текст)

	ТипКонтента = ОпределитьТипКонтента(Текст);

	Если ТипКонтента = "HTML" Тогда
		Возврат СтрШаблон("<pre><code class='language-html'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "JSON" Тогда
		Возврат СтрШаблон("<pre><code class='language-json'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "Markdown" Тогда
		Возврат a1c_МаркдаунПарсер.ПреобразоватьВHTML(Текст);
	Иначе
		ТекстHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст);
		ТекстHTML = СтрЗаменить(ТекстHTML, Символы.ПС, "<br>");
		Возврат ТекстHTML;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьТипКонтента(Знач Текст)

	ТекстОбрезанный = СокрЛП(Текст);

	Если ЭтоПолныйHTMLДокумент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Если ЭтоJSON(ТекстОбрезанный) Тогда
		Возврат "JSON";
	КонецЕсли;

	Если ЭтоMarkdown(Текст) Тогда
		Возврат "Markdown";
	КонецЕсли;

	Если ЭтоHTMLФрагмент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Возврат "PlainText";

КонецФункции

&НаСервере
Функция ЭтоПолныйHTMLДокумент(Текст)

	ТекстНижний = НРег(Текст);

	Если СтрНачинаетсяС(ТекстНижний, "<!doctype html") Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(ТекстНижний, "<html")
		И СтрНайти(ТекстНижний, "</html>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЭтоJSON(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Лев(Текст, 1);
	ПоследнийСимвол = Прав(Текст, 1);

	ЭтоОбъект = (ПервыйСимвол = "{" И ПоследнийСимвол = "}");
	ЭтоМассив = (ПервыйСимвол = "[" И ПоследнийСимвол = "]");

	Если НЕ (ЭтоОбъект Или ЭтоМассив) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЭтоHTMLФрагмент(Текст)

	ТекстНижний = НРег(Текст);

	НачинаетсяСТега = СтрНачинаетсяС(ТекстНижний, "<div")
		Или СтрНачинаетсяС(ТекстНижний, "<table")
		Или СтрНачинаетсяС(ТекстНижний, "<section")
		Или СтрНачинаетсяС(ТекстНижний, "<article");

	ЗаканчиваетсяТегом = СтрЗаканчиваетсяНа(ТекстНижний, "</div>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</table>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</section>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</article>");

	Возврат НачинаетсяСТега И ЗаканчиваетсяТегом;

КонецФункции

