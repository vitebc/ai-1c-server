// V3: весь чат — одна HTML-страница в поле HTML-документа.
// Страница рисуется один раз (ПриСозданииНаСервере) и дальше не перерисовывается:
// 1С зовёт её функции через Элементы.ПанельHTML.Документ.defaultView и передаёт
// готовый HTML одного блока. Поэтому прокрутка и уже отрисованные сообщения не
// сбрасываются, когда ответ модели дописывается.
// Обратно из страницы приходят только клики по ссылкам #act:... — их разбирает
// ПанельHTMLПриНажатии. Состояние страницы в JS не хранится (платформа не
// рекомендует скрипты с состоянием): все идентификаторы приходят из 1С.
// В модуле управляемой формы переменные модуля объявляются ТОЛЬКО с директивой
// компиляции (&НаКлиенте): без неё платформа их не видит.
&НаКлиенте
Перем ОжиданиеХода;           // Истина, пока идёт ход и работает опрос
&НаКлиенте
Перем ВремяНачалаХода;        // время начала хода (мс, из квитанции prompt)
&НаКлиенте
Перем НачалоОпроса;           // локальное время старта опроса (мс) — страховка
&НаКлиенте
Перем СтраницаГотова;         // документ страницы загружен, JS можно вызывать
&НаКлиенте
Перем ТекущийИдВопросаКлиент; // id вопроса, карточка которого сейчас на странице
&НаКлиенте
Перем ОтвеченныйИдВопроса;    // id вопроса, ответ на который уже отправлен
&НаКлиенте
Перем ТекущийHTMLВопроса;     // HTML карточки вопроса — для перерисовки страницы
&НаКлиенте
Перем СтатусТекст;            // статус в шапке — переживает перерисовку
&НаКлиенте
Перем СтатусВид;              // "", "warn", "err"
&НаКлиенте
Перем ПопыткиГотовности;      // шаги сторожа загрузки страницы

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = АдресБэкендаПоУмолчанию();
	КонецЕсли;

	ЗагрузитьНастройкиФормы();

	ТекущийИдВопроса = "";

	ТекстОшибки = ЗаполнитьСписокАгентов();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		НачальныйСтатус = СтрШаблон(
			НСтр("ru = 'Сервер OpenCode недоступен (%1): %2'"),
			АдресБэкенда, ТекстОшибки);
		НачальныйВид = "warn";
	Иначе
		НачальныйСтатус = "";
		НачальныйВид = "";
	КонецЕсли;

	// Страница рисуется один раз; дальше её меняют функции JS.
	ПанельHTML = СформироватьСтраницу(НачальныйСтатус, НачальныйВид);

КонецПроцедуры

// Клиентские переменные модуля формы не имеют начальных значений (Неопределено):
// без явной инициализации проверки вида «Если ОжиданиеХода» падают с ошибкой
// «Преобразование значения к типу Булево не может быть выполнено».
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Сравнение с Истиной, а не присваивание Лжи: ДокументСформирован может
	// теоретически сработать раньше, и тогда готовность страницы не теряется.
	ОжиданиеХода = (ОжиданиеХода = Истина);
	СтраницаГотова = (СтраницаГотова = Истина);
	ВремяНачалаХода = 0;
	НачалоОпроса = 0;
	ТекущийИдВопросаКлиент = "";
	ОтвеченныйИдВопроса = "";
	ТекущийHTMLВопроса = "";
	СтатусТекст = "";
	СтатусВид = "";
	ПопыткиГотовности = 0;

	// Сторож загрузки: ДокументСформирован приходит не во всех движках и не
	// всегда (например, при повторной отрисовке того же текста). Без страховки
	// чат молча остался бы с одной статичной страницей.
	Если Не СтраницаГотова Тогда
		ПодключитьОбработчикОжидания("ПроверитьГотовностьСтраницы", 1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОстановитьОпроса();
	ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Клик по ссылке #act:... внутри страницы. Платформа отдаёт Href уже
// раскодированным (decodeURI), поэтому кириллица и пробелы приходят как есть.
&НаКлиенте
Процедура ПанельHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Действие = "";
	Попытка
		Ссылка = "";
		Если ДанныеСобытия.Свойство("Href", Ссылка) И ТипЗнч(Ссылка) = Тип("Строка") Тогда
			Позиция = СтрНайти(Ссылка, "#act:");
			Если Позиция > 0 Тогда
				Действие = Сред(Ссылка, Позиция + СтрДлина("#act:"));
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Нажатие не по ссылке (или среда без DOM) — штатная обработка не нужна.
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(Действие) Тогда
		Возврат;
	КонецЕсли;

	// Иначе поле уйдёт по якорю #act:... и страница «прыгнет».
	СтандартнаяОбработка = Ложь;

	ВыполнитьДействиеСтраницы(Действие);

КонецПроцедуры

// Документ загружен: только теперь можно звать JS. До этого вызовы падают,
// поэтому все обёртки молчат, пока СтраницаГотова = Ложь, — иначе каждая
// попытка приводила бы к полной перерисовке страницы.
// Параметр Элемент платформа передаёт всем обработчикам событий элементов формы
// (так же подписаны обработчики ДокументСформирован в типовых конфигурациях).
&НаКлиенте
Процедура ПанельHTMLДокументСформирован(Элемент)

	СтраницаГотова = Истина;

	Если Не ПустаяСтрока(СтатусТекст) Тогда
		ОбновитьСтатусНаСтранице(СтатусТекст, СтатусВид);
	КонецЕсли;

	УстановитьЗанятостьНаСтранице(ОжиданиеХода);

	Если Не ПустаяСтрока(ТекущийHTMLВопроса) Тогда
		ПоказатьВопросНаСтранице(ТекущийHTMLВопроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияСтраницы

&НаКлиенте
Процедура ВыполнитьДействиеСтраницы(Знач Действие)

	Части = СтрРазделить(Действие, "|", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Команда = НРег(СокрЛП(Части[0]));

	Если Команда = "send" Тогда
		ОтправитьИзСтраницы();
	ИначеЕсли Команда = "stop" Тогда
		ПрерватьХод();
	ИначеЕсли Команда = "clear" Тогда
		ОчиститьДиалог();
	ИначеЕсли Команда = "backend" Тогда
		ИзменитьАдресСервера();
	ИначеЕсли Команда = "agent" Тогда
		Если Части.Количество() > 1 Тогда
			СменитьАгента(Части[1]);
		КонецЕсли;
	ИначеЕсли Команда = "opt" Тогда
		Если Части.Количество() > 2 Тогда
			ОтветитьВариантом(Число(Части[1]), Число(Части[2]));
		КонецЕсли;
	ИначеЕсли Команда = "answer" Тогда
		ОтветитьТекстом();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИзСтраницы()

	Если ОжиданиеХода Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"), "warn");
		Возврат;
	КонецЕсли;

	Текст = ПрочитатьИзСтраницы("prompt");
	Если Текст = Неопределено Тогда
		// DOM недоступен (страница ещё грузится или среда без document):
		// спрашиваем текст стандартным диалогом — чат продолжает работать.
		Оповещение = Новый ОписаниеОповещения("ПослеВводаПромпта", ЭтотОбъект);
		ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Введите промпт'"), 0, Истина);
		Возврат;
	КонецЕсли;

	ОтправитьТекст(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПромпта(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтправитьТекст(Строка);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТекст(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Введите промпт'"), "warn");
		Возврат;
	КонецЕсли;

	ОчиститьПолеВводаНаСтранице();
	УстановитьЗанятостьНаСтранице(Истина);
	ОбновитьСтатусНаСтранице(НСтр("ru = 'Размышляю...'"), "");

	Результат = НачатьХодНаСервере(Текст);

	Если ЗначениеЗаполнено(Результат.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Результат.Ид, Результат.HTML);
	КонецЕсли;

	Если Результат.ЭтоОшибка Тогда
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице(Результат.ТекстОшибки, "err");
		Возврат;
	КонецЕсли;

	ВремяНачалаХода = Результат.ВремяНачала;
	НачалоОпроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОжиданиеХода = Истина;
	ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтветитьВариантом(Знач ИндексПоля, Знач ИндексВарианта)

	Ответить(ИндексПоля, ИндексВарианта, "");

КонецПроцедуры

&НаКлиенте
Процедура ОтветитьТекстом()

	Текст = ПрочитатьИзСтраницы("qfree");
	Если Текст = Неопределено Или ПустаяСтрока(Текст) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВводаОтветаНаВопрос", ЭтотОбъект);
		ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Ответ на вопрос'"), 0, Истина);
		Возврат;
	КонецЕсли;

	Ответить(-1, -1, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаОтветаНаВопрос(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ответить(-1, -1, Строка);

КонецПроцедуры

&НаКлиенте
Процедура Ответить(Знач ИндексПоля, Знач ИндексВарианта, Знач Текст)

	УстановитьЗанятостьНаСтранице(Истина);
	ОбновитьСтатусНаСтранице(НСтр("ru = 'Ожидание продолжения...'"), "");

	Результат = ОтветитьНаВопросНаСервере(Текст, ИндексПоля, ИндексВарианта);

	Если Не Результат.Успех Тогда
		УстановитьЗанятостьНаСтранице(Истина);
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Не удалось отправить ответ. Попробуйте ещё раз.'"), "err");
		Возврат;
	КонецЕсли;

	СкрытьВопросНаСтранице();
	ТекущийHTMLВопроса = "";
	ТекущийИдВопросаКлиент = "";
	// Отвеченный id запоминаем: сервер может вернуть форму ещё раз, пока не
	// обработал ответ — второй раз карточку не показываем, но опрос не бросаем.
	ОтвеченныйИдВопроса = Результат.ИдФормы;

	Если ЗначениеЗаполнено(Результат.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Результат.Ид, Результат.HTML);
	КонецЕсли;

	Если ОжиданиеХода Тогда
		НачалоОпроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СменитьАгента(Знач ИдентификаторАгента)

	Если ОжиданиеХода Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"), "warn");
		Возврат;
	КонецЕсли;

	ШапкаHTML = СменитьАгентаНаСервере(ИдентификаторАгента);
	Если ПустаяСтрока(ШапкаHTML) Тогда
		Возврат;
	КонецЕсли;

	ОбновитьШапкуНаСтранице(ШапкаHTML);
	Если Не ПустаяСтрока(СтатусТекст) Тогда
		ОбновитьСтатусНаСтранице(СтатусТекст, СтатусВид);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАдресСервера()

	Если ОжиданиеХода Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"), "warn");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВводаАдресаСервера", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, АдресБэкенда, НСтр("ru = 'Адрес сервера OpenCode'"), 0, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаАдресаСервера(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ШапкаHTML = СменитьАдресНаСервере(СокрЛП(Строка));
	Если ПустаяСтрока(ШапкаHTML.Шапка) Тогда
		Возврат;
	КонецЕсли;

	ОбновитьШапкуНаСтранице(ШапкаHTML.Шапка);
	ОбновитьСтатусНаСтранице(ШапкаHTML.ТекстСтатуса, ШапкаHTML.ВидСтатуса);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДиалог()

	ОстановитьОпроса();
	УстановитьЗанятостьНаСтранице(Ложь);

	ОчиститьДиалогНаСервере();

	ОчиститьЛентуНаСтранице();
	СкрытьВопросНаСтранице();
	ОчиститьПолеВводаНаСтранице();

	ТекущийИдВопросаКлиент = "";
	ОтвеченныйИдВопроса = "";
	ТекущийHTMLВопроса = "";
	ВремяНачалаХода = 0;
	НачалоОпроса = 0;
	ИдентификаторСессии = "";

	ОбновитьСтатусНаСтранице("", "");

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьХод()

	Если Не ОжиданиеХода Тогда
		Возврат;
	КонецЕсли;

	ОстановитьОпроса();
	УстановитьЗанятостьНаСтранице(Ложь);
	ОбновитьСтатусНаСтранице(НСтр("ru = 'Запрос прерван'"), "warn");

	Результат = ПрерватьХодНаСервере();
	Если ЗначениеЗаполнено(Результат.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Результат.Ид, Результат.HTML);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОпросХода

// Один шаг опроса. Push в открытую форму платформа не умеет, поэтому клиент
// по таймеру спрашивает состояние хода и досыпает в страницу только изменения.
&НаКлиенте
Процедура ОбработчикОпросаХода()

	Если Не ОжиданиеХода Тогда
		Возврат;
	КонецЕсли;

	// Страховка: 10 минут без завершения — прекращаем опрос, чтобы кнопка
	// «Отправить» не осталась заблокированной навсегда.
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОпроса > 600000 Тогда
		ОстановитьОпроса();
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Превышено время ожидания ответа (10 минут).'"), "err");
		Возврат;
	КонецЕсли;

	Состояние = ОбновитьХодНаСервере(ВремяНачалаХода);

	Если ЗначениеЗаполнено(Состояние.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Состояние.Ид, Состояние.HTML);
	КонецЕсли;

	Если ЗначениеЗаполнено(Состояние.ИдМета) Тогда
		ПоказатьМетуНаСтранице(Состояние.ИдМета, Состояние.Мета);
	КонецЕсли;

	Если Состояние.ЭтоОшибка Тогда
		ОстановитьОпроса();
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице(Состояние.ТекстОшибки, "err");
		Возврат;
	КонецЕсли;

	Если Состояние.ЕстьВопрос Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Ассистент ждёт ответа на вопрос'"), "warn");

		Если Состояние.ИдВопроса = ТекущийИдВопросаКлиент Тогда
			// Эта карточка уже на странице — ждём клика пользователя,
			// опрос не крутим.
			Возврат;
		КонецЕсли;

		Если Состояние.ИдВопроса = ОтвеченныйИдВопроса Тогда
			// Ответ уже отправлен, а сервер ещё не убрал форму: второй раз
			// карточку не показываем, но опрос продолжаем — иначе ход
			// останется висеть в ожидании до таймаута.
			ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);
			Возврат;
		КонецЕсли;

		ОтвеченныйИдВопроса = "";
		ТекущийИдВопросаКлиент = Состояние.ИдВопроса;
		ТекущийHTMLВопроса = Состояние.ВопросHTML;
		ПоказатьВопросНаСтранице(ТекущийHTMLВопроса);
		Возврат;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекущийHTMLВопроса) Тогда
		ТекущийHTMLВопроса = "";
		СкрытьВопросНаСтранице();
	КонецЕсли;

	Если Состояние.Завершено Тогда
		ОстановитьОпроса();
		ТекущийИдВопросаКлиент = "";
		ОтвеченныйИдВопроса = "";
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице("", "");
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОпроса()

	ОжиданиеХода = Ложь;
	ОтключитьОбработчикОжидания("ОбработчикОпросаХода");

КонецПроцедуры

// Старт хода: промпт без ожидания (wait не нужен — ответ добираем опросом).
// Возвращает {ЭтоОшибка, ТекстОшибки, ВремяНачала, Ид, HTML}.
&НаСервере
Функция НачатьХодНаСервере(Знач ТекстПромпта)

	Результат = Новый Структура("ЭтоОшибка, ТекстОшибки, ВремяНачала, Ид, HTML", Истина, "", 0, "", "");

	Ответ = Неопределено;
	ТекстИсключения = "";
	Попытка
		Ответ = a1c_ЧатOpenCodeФоновый.ОтправитьПромптБезОжидания(
			ТекстПромпта, АдресБэкенда, ИдентификаторСессии, Агент);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось отправить запрос: '") + ТекстИсключения;
	ИначеЕсли Ответ.ЭтоОшибка Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
	Иначе
		Результат.ЭтоОшибка = Ложь;
		Результат.ВремяНачала = Ответ.ВремяНачала;
		Если ЗначениеЗаполнено(Ответ.ИдентификаторСессии) Тогда
			ИдентификаторСессии = Ответ.ИдентификаторСессии;
		КонецЕсли;
	КонецЕсли;

	Если Результат.ЭтоОшибка Тогда
		Индекс = ДобавитьСообщение("error", Результат.ТекстОшибки);
		Результат.Ид = ИдСообщения(Индекс);
		Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		Возврат Результат;
	КонецЕсли;

	// Промпт попал на сервер — теперь его можно показать в ленте.
	Индекс = ДобавитьСообщение("user", ТекстПромпта);
	Результат.Ид = ИдСообщения(Индекс);
	Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);

	Возврат Результат;

КонецФункции

// Шаг опроса на сервере: текст ответа, вопрос модели, завершение хода.
// Возвращает {ЭтоОшибка, ТекстОшибки, Завершено, ЕстьВопрос, ИдВопроса,
// ВопросHTML, Ид, HTML, ИдМета, Мета}.
&НаСервере
Функция ОбновитьХодНаСервере(Знач ВремяНачала)

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("ЕстьВопрос", Ложь);
	Результат.Вставить("ИдВопроса", "");
	Результат.Вставить("ВопросHTML", "");
	Результат.Вставить("Ид", "");
	Результат.Вставить("HTML", "");
	Результат.Вставить("ИдМета", "");
	Результат.Вставить("Мета", "");

	Состояние = Неопределено;
	ТекстИсключения = "";
	Попытка
		Состояние = a1c_ЧатOpenCodeФоновый.ПолучитьСостояниеХода(
			АдресБэкенда, ИдентификаторСессии, ВремяНачала);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	Если Состояние = Неопределено Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ошибка опроса состояния хода: '") + ТекстИсключения;
	ИначеЕсли Состояние.ЭтоОшибка Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = Состояние.ТекстОшибки;
	КонецЕсли;

	Если Результат.ЭтоОшибка Тогда
		Индекс = ДобавитьСообщение("error", Результат.ТекстОшибки);
		Результат.Ид = ИдСообщения(Индекс);
		Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		Возврат Результат;
	КонецЕсли;

	// Пустой пузырь не создаём: строка assistant появляется с первым текстом.
	Если Не ПустаяСтрока(Состояние.Текст) Тогда
		Индекс = ИндексТекущегоОтвета();
		Если Индекс < 0 Тогда
			Индекс = ДобавитьСообщение("assistant", Состояние.Текст);
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		ИначеЕсли ИсторияДиалога[Индекс].Текст <> Состояние.Текст Тогда
			// Текст не изменился — HTML не пересобираем: это лишняя работа
			// каждые полсекунды, а страница и так уже показывает этот текст.
			ИсторияДиалога[Индекс].Текст = Состояние.Текст;
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		КонецЕсли;
	КонецЕсли;

	// Вопрос модели блокирует ход: пока он не отвечен, ход не завершён.
	Если Состояние.Вопрос <> Неопределено Тогда
		Результат.ЕстьВопрос = Истина;
		Результат.ИдВопроса = ?(Состояние.Вопрос.Свойство("id"), Состояние.Вопрос.id, "");
		Результат.ВопросHTML = СформироватьHTMLВопроса(Состояние.Вопрос);
		ТекущийИдВопроса = Результат.ИдВопроса;
	КонецЕсли;

	Если Состояние.Завершено Тогда
		Результат.Завершено = Истина;

		Если Не ПустаяСтрока(Состояние.ОшибкаМодели) Тогда
			Индекс = ДобавитьСообщение("error", Состояние.ОшибкаМодели);
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		ИначеЕсли ПустаяСтрока(Состояние.Текст) Тогда
			Текст = НСтр("ru = 'Модель не вернула текстового ответа (только служебные шаги). Попробуйте ещё раз.'");
			Индекс = ДобавитьСообщение("error", Текст);
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		Иначе
			Индекс = ИндексТекущегоОтвета();
			Мета = СформироватьМетаинформацию(Состояние);
			Если Индекс >= 0 И Не ПустаяСтрока(Мета) Тогда
				ИсторияДиалога[Индекс].Метаинформация = Мета;
				Результат.ИдМета = ИдСообщения(Индекс);
				Результат.Мета = Мета;
			КонецЕсли;
		КонецЕсли;

		ТекущийИдВопроса = "";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ответ на вопрос модели. Либо вариант из списка (ИндексПоля/ИндексВарианта >= 0),
// либо свой текст. Форму перечитываем с сервера: в ней же лежат ключи полей,
// которым нужно ответить (иначе форма останется неотвеченной и ход застрянет).
// Возвращает {Успех, ИдФормы, Ид, HTML}.
&НаСервере
Функция ОтветитьНаВопросНаСервере(Знач Текст, Знач ИндексПоля, Знач ИндексВарианта)

	Результат = Новый Структура("Успех, ИдФормы, Ид, HTML", Ложь, "", "", "");

	Попытка
		Вопросы = a1c_ЧатOpenCodeФоновый.ПолучитьОжидающиеВопросы(АдресБэкенда, ИдентификаторСессии);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если Вопросы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Вопрос = Неопределено;
	Для Каждого Кандидат Из Вопросы Цикл
		Если Кандидат.id = ТекущийИдВопроса Тогда
			Вопрос = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Вопрос = Неопределено Тогда
		Вопрос = Вопросы[0];
	КонецЕсли;

	ТекстОтвета = Текст;
	Если ИндексПоля >= 0 И ИндексВарианта >= 0
		И ИндексПоля < Вопрос.Поля.Количество() Тогда
		Поле = Вопрос.Поля[ИндексПоля];
		Если ИндексВарианта < Поле.Варианты.Количество() Тогда
			ТекстОтвета = Поле.Варианты[ИндексВарианта].value;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(ТекстОтвета) Тогда
		Возврат Результат;
	КонецЕсли;

	Ключи = Новый Массив;
	Для Каждого Поле Из Вопрос.Поля Цикл
		Если Не ПустаяСтрока(Поле.key) Тогда
			Ключи.Добавить(Поле.key);
		КонецЕсли;
	КонецЦикла;

	Попытка
		Успех = a1c_ЧатOpenCodeФоновый.ОтветитьНаВопрос(
			АдресБэкенда, ИдентификаторСессии, Вопрос.id, Ключи, ТекстОтвета);
	Исключение
		Успех = Ложь;
	КонецПопытки;

	Если Не Успех Тогда
		Возврат Результат;
	КонецЕсли;

	ТекущийИдВопроса = "";

	Результат.Успех = Истина;
	Результат.ИдФормы = Вопрос.id;

	Индекс = ДобавитьСообщение("user", ТекстОтвета);
	Результат.Ид = ИдСообщения(Индекс);
	Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);

	Возврат Результат;

КонецФункции

// Прерывание хода: POST /interrupt, ошибка в ленту, опрос останавливает клиент.
&НаСервере
Функция ПрерватьХодНаСервере()

	Результат = Новый Структура("Ид, HTML", "", "");

	Попытка
		a1c_ЧатOpenCodeФоновый.ПрерватьСессиюПоАдресу(АдресБэкенда, ИдентификаторСессии);
	Исключение
		// Не критично: ход всё равно оборвётся по таймауту сервера.
	КонецПопытки;

	Индекс = ДобавитьСообщение("error", НСтр("ru = 'Ход прерван пользователем.'"));
	Результат.Ид = ИдСообщения(Индекс);
	Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ОчиститьДиалогНаСервере()

	ИсторияДиалога.Очистить();
	ТекущийИдВопроса = "";

КонецПроцедуры

// Смена агента: новый ход пойдёт новым агентом, текущая сессия сбрасывается —
// агент задаётся при создании сессии OpenCode.
&НаСервере
Функция СменитьАгентаНаСервере(Знач ИдентификаторАгента)

	Если Агенты.Найти(ИдентификаторАгента, "Идентификатор") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Агент = ИдентификаторАгента;
	ИдентификаторСессии = "";
	СохранитьНастройкиФормы();

	Возврат СформироватьШапкуHTML("", "");

КонецФункции

// Смена адреса сервера (только разработчик — как в V1/V2). Агенты
// перечитываются, сессия сбрасывается: это уже другой сервер.
// Возвращает {Шапка, ТекстСтатуса, ВидСтатуса}; пустая Шапка — менять нечего.
&НаСервере
Функция СменитьАдресНаСервере(Знач НовыйАдрес)

	Результат = Новый Структура("Шапка, ТекстСтатуса, ВидСтатуса", "", "", "");

	Если Не ЭтоРазработчик() Или ПустаяСтрока(НовыйАдрес) Тогда
		Возврат Результат;
	КонецЕсли;

	АдресБэкенда = НовыйАдрес;
	ИдентификаторСессии = "";
	ТекстОшибки = ЗаполнитьСписокАгентов();
	СохранитьНастройкиФормы();

	Результат.Шапка = СформироватьШапкуHTML("", "");
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.ТекстСтатуса = ТекстОшибки;
		Результат.ВидСтатуса = "warn";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Агенты

// Агенты сервера OpenCode: только mode="primary" и не hidden.
// Возвращает текст ошибки (пусто, если всё хорошо).
&НаСервере
Функция ЗаполнитьСписокАгентов()

	Агенты.Очистить();
	СписокАгентов = Неопределено;
	ТекстОшибки = "";

	// Первый HTTP-запрос в холодном сеансе иногда не доходит до сервера —
	// вторая попытка лечит это без перезапуска формы.
	Для НомерПопытки = 1 По 2 Цикл
		Попытка
			СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
			// При ошибке модуль возвращает массив с одной строкой диагностики
			// (код HTTP и тело ответа) — не глотаем её молча.
			Если СписокАгентов.Количество() > 0 И ТипЗнч(СписокАгентов[0]) = Тип("Строка") Тогда
				ТекстОшибки = СписокАгентов[0];
				СписокАгентов = Неопределено;
			Иначе
				ТекстОшибки = "";
				Прервать;
			КонецЕсли;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			СписокАгентов = Неопределено;
		КонецПопытки;
	КонецЦикла;

	Если СписокАгентов = Неопределено Или СписокАгентов.Количество() = 0 Тогда
		Строка = Агенты.Добавить();
		Строка.Идентификатор = "assistant";
		Строка.Имя = НСтр("ru = 'Ассистент'");
	Иначе
		Для Каждого СтрокаАгента Из СписокАгентов Цикл
			Строка = Агенты.Добавить();
			Строка.Идентификатор = СтрокаАгента.id;
			Строка.Имя = СтрокаАгента.name;
		КонецЦикла;
	КонецЕсли;

	// Текущее значение обязано быть из списка, иначе сброс на дефолт.
	Если Не ЗначениеЗаполнено(Агент) Или Агенты.Найти(Агент, "Идентификатор") = Неопределено Тогда
		Агент = "assistant";
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

#КонецОбласти

#Область ИсторияДиалога

&НаСервере
Функция ДобавитьСообщение(Знач Роль, Знач Текст)

	Строка = ИсторияДиалога.Добавить();
	Строка.Роль = Роль;
	Строка.Текст = Текст;
	Строка.Метаинформация = "";

	Возврат ИсторияДиалога.Индекс(Строка);

КонецФункции

// Последняя строка assistant без метаинформации — это пузырь текущего хода.
&НаСервере
Функция ИндексТекущегоОтвета()

	Индекс = ИсторияДиалога.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ИсторияДиалога[Индекс].Роль = "assistant"
			И ПустаяСтрока(ИсторияДиалога[Индекс].Метаинформация) Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат -1;

КонецФункции

// «модель • токены • секунды» для подписи пузыря ответа.
&НаСервереБезКонтекста
Функция СформироватьМетаинформацию(Знач Состояние)

	Части = Новый Массив;
	Если Не ПустаяСтрока(Состояние.Модель) Тогда
		Части.Добавить(Состояние.Модель);
	КонецЕсли;
	Если Состояние.Токены > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 токенов'"), Строка(Состояние.Токены)));
	КонецЕсли;
	Если Состояние.Секунды > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 с'"), Формат(Состояние.Секунды, "ЧДЦ=1; ЧГ=0")));
	КонецЕсли;

	Возврат СтрСоединить(Части, " • ");

КонецФункции

#КонецОбласти

#Область Страница

// Документ страницы или Неопределено, если поле ещё не отрисовано.
// Проверка готовности не нужна: метод работает и во время загрузки.
&НаКлиенте
Функция ПолучитьДокументСтраницы()

	Попытка
		Возврат Элементы.ПанельHTML.Документ;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Сторож загрузки страницы: раз в секунду проверяет, что в документе уже есть
// поле ввода, и только тогда включает штатную готовность (повторно применяя
// статус, занятость и карточку вопроса). Страховка от движков, где
// ДокументСформирован не приходит. Больше 30 секунд не ждём.
&НаКлиенте
Процедура ПроверитьГотовностьСтраницы()

	Если СтраницаГотова Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
		Возврат;
	КонецЕсли;

	ПопыткиГотовности = ПопыткиГотовности + 1;

	Документ = ПолучитьДокументСтраницы();
	Загружено = Ложь;
	Если Документ <> Неопределено Тогда
		Попытка
			Загружено = (Документ.getElementById("prompt") <> Неопределено);
		Исключение
			Загружено = Ложь;
		КонецПопытки;
	КонецЕсли;

	Если Загружено Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
		ПанельHTMLДокументСформирован(Элементы.ПанельHTML);
	ИначеЕсли ПопыткиГотовности >= 30 Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
	Иначе
		// Обработчик подключён как однократный — перевзводим до победы.
		ПодключитьОбработчикОжидания("ПроверитьГотовностьСтраницы", 1, Истина);
	КонецЕсли;

КонецПроцедуры

// Окно страницы (объект) — переменная ОкноСтраницы. В тонком клиенте под Windows поле рисует движок IE:
// у документа там нет defaultView, зато есть parentWindow; в веб-клиенте и
// клиенте на WebKit — наоборот. Пробуем оба, чтобы не зависеть от клиента.
&НаКлиенте
Функция ПолучитьОкноСтраницы()

	Если Не СтраницаГотова Тогда
		Возврат Неопределено;
	КонецЕсли;

	Документ = ПолучитьДокументСтраницы();
	Если Документ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ОкноСтраницы = Документ.defaultView;
		Если ОкноСтраницы <> Неопределено Тогда
			Возврат ОкноСтраницы;
		КонецЕсли;
	Исключение
		// Свойства нет — движок IE, ниже пробуем parentWindow.
	КонецПопытки;

	Попытка
		Возврат Документ.parentWindow;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПоказатьСообщениеНаСтранице(Знач Ид, Знач HTML)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.upsertMessage(Ид, HTML);
	Исключение
		// Страница ещё не загрузилась или DOM недоступен: рисуем заново целиком.
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМетуНаСтранице(Знач Ид, Знач Мета)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.setMeta(Ид, Мета);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросНаСтранице(Знач HTML)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.showQuestion(HTML);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СкрытьВопросНаСтранице()

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.hideQuestion();
	Исключение
