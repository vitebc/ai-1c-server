// V3: весь чат — одна HTML-страница в поле HTML-документа.
// Страница рисуется один раз (ПриСозданииНаСервере) и дальше не перерисовывается:
// 1С зовёт её функции через Элементы.ПанельHTML.Документ.defaultView и передаёт
// готовый HTML одного блока. Поэтому прокрутка и уже отрисованные сообщения не
// сбрасываются, когда ответ модели дописывается.
// Обратно из страницы приходят только клики по ссылкам #act:... — их разбирает
// ПанельHTMLПриНажатии. Состояние страницы в JS не хранится (платформа не
// рекомендует скрипты с состоянием): все идентификаторы приходят из 1С.
// В модуле управляемой формы переменные модуля объявляются ТОЛЬКО с директивой
// компиляции (&НаКлиенте): без неё платформа их не видит.
&НаКлиенте
Перем ОжиданиеХода;           // Истина, пока идёт ход и работает опрос
&НаКлиенте
Перем ВремяНачалаХода;        // время начала хода (мс, из квитанции prompt)
&НаКлиенте
Перем НачалоОпроса;           // локальное время старта опроса (мс) — страховка
&НаКлиенте
Перем СтраницаГотова;         // документ страницы загружен, JS можно вызывать
&НаКлиенте
Перем ПузырьОжиданияПоказан;  // «Агент думает…» в ленте (id=pending) на странице
&НаКлиенте
Перем ТекущийИдВопросаКлиент; // id вопроса, карточка которого сейчас на странице
&НаКлиенте
Перем ОтвеченныйИдВопроса;    // id вопроса, ответ на который уже отправлен
&НаКлиенте
Перем ТекущийHTMLВопроса;     // HTML карточки вопроса — для перерисовки страницы
&НаКлиенте
Перем ТекущийВопрос;          // структура вопроса с сервера: поля, варианты
&НаКлиенте
Перем ОтветыНаВопрос;         // Соответствие «ключ поля → выбранный текст»
&НаКлиенте
Перем ОчередьВводаОтветов;    // поля для ПоказатьВводСтроки, если DOM недоступен
&НаКлиенте
Перем СтатусТекст;            // статус в шапке — переживает перерисовку
&НаКлиенте
Перем СтатусВид;              // "", "warn", "err"
&НаКлиенте
Перем ПопыткиГотовности;      // шаги сторожа загрузки страницы

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = АдресБэкендаПоУмолчанию();
	КонецЕсли;

	ЗагрузитьНастройкиФормы();

	ТекущийИдВопроса = "";

	ТекстОшибки = ЗаполнитьСписокАгентов();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		НачальныйСтатус = СтрШаблон(
			НСтр("ru = 'Сервер OpenCode недоступен (%1): %2'"),
			АдресБэкенда, ТекстОшибки);
		НачальныйВид = "warn";
	Иначе
		НачальныйСтатус = "";
		НачальныйВид = "";
	КонецЕсли;

	// Страница рисуется один раз; дальше её меняют функции JS.
	ПанельHTML = СформироватьСтраницу(НачальныйСтатус, НачальныйВид);

КонецПроцедуры

// Клиентские переменные модуля формы не имеют начальных значений (Неопределено):
// без явной инициализации проверки вида «Если ОжиданиеХода» падают с ошибкой
// «Преобразование значения к типу Булево не может быть выполнено».
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Сравнение с Истиной, а не присваивание Лжи: ДокументСформирован может
	// теоретически сработать раньше, и тогда готовность страницы не теряется.
	ОжиданиеХода = (ОжиданиеХода = Истина);
	СтраницаГотова = (СтраницаГотова = Истина);
	ВремяНачалаХода = 0;
	НачалоОпроса = 0;
	ТекущийИдВопросаКлиент = "";
	ОтвеченныйИдВопроса = "";
	ТекущийHTMLВопроса = "";
	ТекущийВопрос = Неопределено;
	ОтветыНаВопрос = Новый Соответствие;
	ОчередьВводаОтветов = Новый Массив;
	СтатусТекст = "";
	СтатусВид = "";
	ПопыткиГотовности = 0;

	// Сторож загрузки: ДокументСформирован приходит не во всех движках и не
	// всегда (например, при повторной отрисовке того же текста). Без страховки
	// чат молча остался бы с одной статичной страницей.
	Если Не СтраницаГотова Тогда
		ПодключитьОбработчикОжидания("ПроверитьГотовностьСтраницы", 1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ОстановитьОпроса();
	ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Клик по ссылке #act:... внутри страницы. Платформа отдаёт Href уже
// раскодированным (decodeURI), поэтому кириллица и пробелы приходят как есть.
&НаКлиенте
Процедура ПанельHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Действие = "";
	Попытка
		Ссылка = "";
		Если ДанныеСобытия.Свойство("Href", Ссылка) И ТипЗнч(Ссылка) = Тип("Строка") Тогда
			Позиция = СтрНайти(Ссылка, "#act:");
			Если Позиция > 0 Тогда
				Действие = Сред(Ссылка, Позиция + СтрДлина("#act:"));
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Нажатие не по ссылке (или среда без DOM) — штатная обработка не нужна.
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(Действие) Тогда
		Возврат;
	КонецЕсли;

	// Иначе поле уйдёт по якорю #act:... и страница «прыгнет».
	СтандартнаяОбработка = Ложь;

	ВыполнитьДействиеСтраницы(Действие);

КонецПроцедуры

// Документ загружен: только теперь можно звать JS. До этого вызовы падают,
// поэтому все обёртки молчат, пока СтраницаГотова = Ложь, — иначе каждая
// попытка приводила бы к полной перерисовке страницы.
// Параметр Элемент платформа передаёт всем обработчикам событий элементов формы
// (так же подписаны обработчики ДокументСформирован в типовых конфигурациях).
&НаКлиенте
Процедура ПанельHTMLДокументСформирован(Элемент)

	СтраницаГотова = Истина;

	Если Не ПустаяСтрока(СтатусТекст) Тогда
		ОбновитьСтатусНаСтранице(СтатусТекст, СтатусВид);
	КонецЕсли;

	УстановитьЗанятостьНаСтранице(ОжиданиеХода);

	Если ТекущийВопрос <> Неопределено Тогда
		// После перерисовки карточку собираем заново: так на ней остаются
		// уже выбранные варианты.
		ТекущийHTMLВопроса = СформироватьHTMLВопроса(ТекущийВопрос, ОтветыНаВопрос);
		ПоказатьВопросНаСтранице(ТекущийHTMLВопроса);
	ИначеЕсли Не ПустаяСтрока(ТекущийHTMLВопроса) Тогда
		ПоказатьВопросНаСтранице(ТекущийHTMLВопроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияСтраницы

&НаКлиенте
Процедура ВыполнитьДействиеСтраницы(Знач Действие)

	Части = СтрРазделить(Действие, "|", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Команда = НРег(СокрЛП(Части[0]));

	Если Команда = "send" Тогда
		ОтправитьИзСтраницы();
	ИначеЕсли Команда = "stop" Тогда
		ПрерватьХод();
	ИначеЕсли Команда = "clear" Тогда
		ОчиститьДиалог();
	ИначеЕсли Команда = "backend" Тогда
		ИзменитьАдресСервера();
	ИначеЕсли Команда = "agent" Тогда
		Если Части.Количество() > 1 Тогда
			СменитьАгента(Части[1]);
		КонецЕсли;
	ИначеЕсли Команда = "opt" Тогда
		Если Части.Количество() > 2 Тогда
			ВыбратьВариантОтвета(Число(Части[1]), Число(Части[2]));
		КонецЕсли;
	ИначеЕсли Команда = "tab" Тогда
		// Переключение вкладки карточки вопроса: только навигация, сервер не трогаем.
		Если Части.Количество() > 1 И ТекущийВопрос <> Неопределено Тогда
			ПоказатьВкладкуВопроса(Число(Части[1]));
		КонецЕсли;
	ИначеЕсли Команда = "answer" Тогда
		ОтветитьНаВопросНаСтранице();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИзСтраницы()

	Если ОжиданиеХода Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"), "warn");
		Возврат;
	КонецЕсли;

	Текст = ПрочитатьИзСтраницы("prompt");
	Если Текст = Неопределено Тогда
		// DOM недоступен (страница ещё грузится или среда без document):
		// спрашиваем текст стандартным диалогом — чат продолжает работать.
		Оповещение = Новый ОписаниеОповещения("ПослеВводаПромпта", ЭтотОбъект);
		ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Введите промпт'"), 0, Истина);
		Возврат;
	КонецЕсли;

	ОтправитьТекст(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаПромпта(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтправитьТекст(Строка);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТекст(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Введите промпт'"), "warn");
		Возврат;
	КонецЕсли;

	ОчиститьПолеВводаНаСтранице();
	УстановитьЗанятостьНаСтранице(Истина);
	ОбновитьСтатусНаСтранице(НСтр("ru = 'Размышляю...'"), "");

	Результат = НачатьХодНаСервере(Текст);

	Если ЗначениеЗаполнено(Результат.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Результат.Ид, Результат.HTML);
	КонецЕсли;

	Если Результат.ЭтоОшибка Тогда
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице(Результат.ТекстОшибки, "err");
		Возврат;
	КонецЕсли;

	ВремяНачалаХода = Результат.ВремяНачала;
	НачалоОпроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОжиданиеХода = Истина;
	ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);

КонецПроцедуры

// Ошибка модели/провайдера из OpenCode — человекочитаемый текст. Служебные
// строки вида «⚠ Retrying in 9s • attempt 10 • ECONNREFUSED: Unable to
// connect...» превращаем в понятное сообщение с подсказкой; остальное
// показываем как есть (там уже свой текст).
&НаСервере
Функция ОформитьОшибкуМодели(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат НСтр("ru = 'Ошибка модели. Попробуйте ещё раз.'");
	КонецЕсли;

	// Служебные строки OpenCode: «⚠ Retrying in 9s • attempt N • <код>: <текст>».
	Если СтрНайти(Текст, "Retrying in") > 0 Тогда
		Части = СтрРазделить(Текст, "•", Ложь);
		КодОшибки = "";
		ТекстПричины = "";
		Для Каждого Часть Из Части Цикл
			ЧастьСокр = СокрЛП(Часть);
			// Код вида ECONNREFUSED — до первого двоеточия.
			Если СтрНайти(ЧастьСокр, ":") > 0 Тогда
				КандидатКода = СокрЛП(Лев(ЧастьСокр, СтрНайти(ЧастьСокр, ":") - 1));
				Если СтрДлина(КандидатКода) >= 4 И Не СтрНайти("0123456789", Лев(КандидатКода, 1)) > 0 Тогда
					КодОшибки = КандидатКода;
					ТекстПричины = СокрЛП(Сред(ЧастьСокр, СтрНайти(ЧастьСокр, ":") + 1));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Перевод = Новый Соответствие;
		Перевод.Вставить("ECONNREFUSED", НСтр("ru = 'Сервер OpenCode не отвечает (соединение отклонено). Проверьте, запущен ли сервер по адресу из шапки.'"));
		Перевод.Вставить("ETIMEDOUT", НСтр("ru = 'Тайм-аут соединения с сервером OpenCode.'"));
		Перевод.Вставить("ECONNRESET", НСтр("ru = 'Соединение с сервером OpenCode сброшено.'"));
		Перевод.Вставить("ENOTFOUND", НСтр("ru = 'Сервер OpenCode не найден (нет DNS-записи). Проверьте адрес в шапке.'"));
		Перевод.Вставить("EAI_AGAIN", НСтр("ru = 'Не удалось разрешить адрес сервера OpenCode (DNS).'"));

		Причина = Перевод.Получить(КодОшибки);
		Если Причина = Неопределено Тогда
			Причина = ?(ПустаяСтрока(ТекстПричины), КодОшибки, ТекстПричины);
		КонецЕсли;

		Возврат СтрШаблон(НСтр("ru = 'Модель недоступна: %1'"), СокрЛП(Причина));
	КонецЕсли;

	// Остальные тексты (429, 500 и т.п.) показываем как есть: у них уже
	// человекочитаемая формулировка.
	Возврат Текст;

КонецФункции

// Ключ поля формы: сервер отвечает по тем же ключам, что прислал.
&НаКлиенте
Функция КлючПоляВопроса(Знач Поле, Знач ИндексПоля)

	Если Не ПустаяСтрока(Поле.key) Тогда
		Возврат Поле.key;
	КонецЕсли;

	Возврат "q" + Строка(ИндексПоля);

КонецФункции

// Клик по варианту ничего не отправляет: ответ только запоминается и
// подсвечивается. У формы может быть несколько полей — отправить их нужно
// одним ответом, когда пользователь нажмёт «Ответить».
&НаКлиенте
Процедура ВыбратьВариантОтвета(Знач ИндексПоля, Знач ИндексВарианта)

	Если ТекущийВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ИндексПоля < 0 Или ИндексПоля >= ТекущийВопрос.Поля.Количество() Тогда
		Возврат;
	КонецЕсли;

	Поле = ТекущийВопрос.Поля[ИндексПоля];
	Если ИндексВарианта < 0 Или ИндексВарианта >= Поле.Варианты.Количество() Тогда
		Возврат;
	КонецЕсли;

	Вариант = Поле.Варианты[ИндексВарианта];
	ОтветыНаВопрос.Вставить(КлючПоляВопроса(Поле, ИндексПоля), Вариант.value);

	// Выбор варианта отменяет свой текст в этом же поле: иначе при отправке
	// текст перекрыл бы выбранный вариант.
	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы <> Неопределено Тогда
		Попытка
			ОкноСтраницы.selectOption(ИндексПоля, ИндексВарианта);
			ОкноСтраницы.setValue("qfree_" + Строка(ИндексПоля), "");
		Исключение
			// Страница уже не та — карточку покажет следующий шаг опроса.
		КонецПопытки;
	КонецЕсли;

	ОбновитьСчётчикВопросаНаСтранице();

КонецПроцедуры

// Счётчик «Осталось ответить: N» под кнопкой «Ответить». Текст передаётся в
// JS из BSL — макеты страницы остаются чистым ASCII.
&НаКлиенте
Процедура ОбновитьСчётчикВопросаНаСтранице()

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Осталось = КоличествоНезаполненныхОтветов(СобратьОтветыИзКарты());
	Попытка
		ОкноСтраницы.setLeftCount(
			Осталось,
			СтрШаблон(НСтр("ru = 'Осталось ответить: %1'"), Осталось),
			НСтр("ru = 'Все поля отвечены'"));
	Исключение
		// Страница уже не та — карточку покажет следующий шаг опроса.
	КонецПопытки;

КонецПроцедуры

// Переключение вкладки карточки вопроса: показываем выбранную панель и
// подсвечиваем вкладку. Состояние страницы не храним — при следующем действии
// (выбор варианта) карточка пересоберётся целиком, поэтому здесь достаточно
// одного JS-вызова.
&НаКлиенте
Процедура ПоказатьВкладкуВопроса(Знач ИндексВкладки)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.showTab(ИндексВкладки);
	Исключение
		// Страница уже не та — карточку покажет следующий шаг опроса.
	КонецПопытки;

КонецПроцедуры

// Нажата кнопка «Ответить»: отправляем ответы всех полей одним запросом.
&НаКлиенте
Процедура ОтветитьНаВопросНаСтранице()

	Если ТекущийВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// DOM может быть недоступен (чужой движок клиента) — тогда спрашиваем
	// строкой по каждому полю, но всё равно отправляем одним ответом.
	Если ПолучитьОкноСтраницы() = Неопределено Тогда
		НачатьВводОтветовПоОчереди();
		Возврат;
	КонецЕсли;

	ОтправитьОтветыНаВопрос(СобратьОтветыИзСтраницы());

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОтветыНаВопрос(Знач Ответы)

	Осталось = КоличествоНезаполненныхОтветов(Ответы);
	Если Осталось > 0 Тогда
		ОбновитьСтатусНаСтранице(
			СтрШаблон(НСтр("ru = 'Ответьте на все вопросы: осталось %1'"), Осталось), "warn");
		Возврат;
	КонецЕсли;

	УстановитьЗанятостьНаСтранице(Истина);
	ОбновитьСтатусНаСтранице(НСтр("ru = 'Ожидание продолжения...'"), "");

	Результат = ОтветитьНаВопросНаСервере(Ответы);

	Если Не Результат.Успех Тогда
		УстановитьЗанятостьНаСтранице(Истина);
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Не удалось отправить ответ. Попробуйте ещё раз.'"), "err");
		Возврат;
	КонецЕсли;

	СкрытьВопросНаСтранице();
	ТекущийHTMLВопроса = "";
	ТекущийВопрос = Неопределено;
	ОтветыНаВопрос = Новый Соответствие;
	ТекущийИдВопросаКлиент = "";
	// Отвеченный id запоминаем: сервер может вернуть форму ещё раз, пока не
	// обработал ответ — второй раз карточку не показываем, но опрос не бросаем.
	ОтвеченныйИдВопроса = Результат.ИдФормы;

	Если ЗначениеЗаполнено(Результат.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Результат.Ид, Результат.HTML);
	КонецЕсли;

	Если ОжиданиеХода Тогда
		НачалоОпроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);
	КонецЕсли;

КонецПроцедуры

// Ответы, уже выбранные вариантами (без чтения страницы).
&НаКлиенте
Функция СобратьОтветыИзКарты()

	Результат = Новый Соответствие;
	Если ТекущийВопрос = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИндексПоля = 0;
	Для Каждого Поле Из ТекущийВопрос.Поля Цикл
		Ключ = КлючПоляВопроса(Поле, ИндексПоля);
		Текст = ОтветыНаВопрос.Получить(Ключ);
		Результат.Вставить(Ключ, ?(Текст = Неопределено, "", Текст));
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ответы из карточки: свой текст в поле перекрывает выбранный вариант.
&НаКлиенте
Функция СобратьОтветыИзСтраницы()

	Результат = СобратьОтветыИзКарты();
	Если ТекущийВопрос = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИндексПоля = 0;
	Для Каждого Поле Из ТекущийВопрос.Поля Цикл
		СвойТекст = ПрочитатьИзСтраницы("qfree_" + Строка(ИндексПоля));
		Если СвойТекст <> Неопределено И Не ПустаяСтрока(СвойТекст) Тогда
			Результат.Вставить(КлючПоляВопроса(Поле, ИндексПоля), СокрЛП(СвойТекст));
		КонецЕсли;
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция КоличествоНезаполненныхОтветов(Знач Ответы)

	Осталось = 0;
	Если ТекущийВопрос = Неопределено Тогда
		Возврат Осталось;
	КонецЕсли;

	ИндексПоля = 0;
	Для Каждого Поле Из ТекущийВопрос.Поля Цикл
		Если ПустаяСтрока(Ответы.Получить(КлючПоляВопроса(Поле, ИндексПоля))) Тогда
			Осталось = Осталось + 1;
		КонецЕсли;
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;

	Возврат Осталось;

КонецФункции

// Резервный путь, если DOM прочитать нельзя: по одному полю через
// ПоказатьВводСтроки. Ответы копятся и уходят одним запросом.
&НаКлиенте
Процедура НачатьВводОтветовПоОчереди()

	ОчередьВводаОтветов = Новый Массив;
	Если ТекущийВопрос <> Неопределено Тогда
		ИндексПоля = 0;
		Для Каждого Поле Из ТекущийВопрос.Поля Цикл
			Ключ = КлючПоляВопроса(Поле, ИндексПоля);
			Если ПустаяСтрока(ОтветыНаВопрос.Получить(Ключ)) Тогда
				ОчередьВводаОтветов.Добавить(ИндексПоля);
			КонецЕсли;
			ИндексПоля = ИндексПоля + 1;
		КонецЦикла;
	КонецЕсли;

	ЗапроситьСледующийОтвет();

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьСледующийОтвет()

	Если ОчередьВводаОтветов.Количество() = 0 Тогда
		ОтправитьОтветыНаВопрос(СобратьОтветыИзКарты());
		Возврат;
	КонецЕсли;

	Заголовок = НСтр("ru = 'Ответ на вопрос'");
	ИндексПоля = ОчередьВводаОтветов[0];
	Если ТекущийВопрос <> Неопределено И ИндексПоля < ТекущийВопрос.Поля.Количество() Тогда
		Поле = ТекущийВопрос.Поля[ИндексПоля];
		Если Не ПустаяСтрока(Поле.title) Тогда
			Заголовок = Поле.title;
		КонецЕсли;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВводаОтветаНаВопрос", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", Заголовок, 0, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаОтветаНаВопрос(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Тогда
		// Отмена: карточка остаётся, ответы можно выбрать заново.
		ОчередьВводаОтветов = Новый Массив;
		Возврат;
	КонецЕсли;

	Если ОчередьВводаОтветов.Количество() = 0 Или ТекущийВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИндексПоля = ОчередьВводаОтветов[0];
	ОчередьВводаОтветов.Удалить(0);

	Если ИндексПоля < ТекущийВопрос.Поля.Количество() Тогда
		Поле = ТекущийВопрос.Поля[ИндексПоля];
		ОтветыНаВопрос.Вставить(КлючПоляВопроса(Поле, ИндексПоля), СокрЛП(Строка));
	КонецЕсли;

	ЗапроситьСледующийОтвет();

КонецПроцедуры

&НаКлиенте
Процедура СменитьАгента(Знач ИдентификаторАгента)

	Если ОжиданиеХода Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"), "warn");
		Возврат;
	КонецЕсли;

	ШапкаHTML = СменитьАгентаНаСервере(ИдентификаторАгента);
	Если ПустаяСтрока(ШапкаHTML) Тогда
		Возврат;
	КонецЕсли;

	ОбновитьШапкуНаСтранице(ШапкаHTML);
	Если Не ПустаяСтрока(СтатусТекст) Тогда
		ОбновитьСтатусНаСтранице(СтатусТекст, СтатусВид);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАдресСервера()

	Если ОжиданиеХода Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Дождитесь ответа на предыдущий запрос'"), "warn");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВводаАдресаСервера", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, АдресБэкенда, НСтр("ru = 'Адрес сервера OpenCode'"), 0, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаАдресаСервера(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ШапкаHTML = СменитьАдресНаСервере(СокрЛП(Строка));
	Если ПустаяСтрока(ШапкаHTML.Шапка) Тогда
		Возврат;
	КонецЕсли;

	ОбновитьШапкуНаСтранице(ШапкаHTML.Шапка);
	ОбновитьСтатусНаСтранице(ШапкаHTML.ТекстСтатуса, ШапкаHTML.ВидСтатуса);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДиалог()

	ОстановитьОпроса();
	УстановитьЗанятостьНаСтранице(Ложь);

	ОчиститьДиалогНаСервере();

	ОчиститьЛентуНаСтранице();
	СкрытьПузырьОжидания();
	СкрытьВопросНаСтранице();
	ОчиститьПолеВводаНаСтранице();

	ТекущийИдВопросаКлиент = "";
	ОтвеченныйИдВопроса = "";
	ТекущийHTMLВопроса = "";
	ТекущийВопрос = Неопределено;
	ОтветыНаВопрос = Новый Соответствие;
	ОчередьВводаОтветов = Новый Массив;
	ВремяНачалаХода = 0;
	НачалоОпроса = 0;
	ИдентификаторСессии = "";

	ОбновитьСтатусНаСтранице("", "");

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьХод()

	Если Не ОжиданиеХода Тогда
		Возврат;
	КонецЕсли;

	ОстановитьОпроса();
	УстановитьЗанятостьНаСтранице(Ложь);
	ОбновитьСтатусНаСтранице(НСтр("ru = 'Запрос прерван'"), "warn");

	СкрытьПузырьОжидания();
	СкрытьВопросНаСтранице();
	ТекущийHTMLВопроса = "";
	ТекущийВопрос = Неопределено;
	ОтветыНаВопрос = Новый Соответствие;
	ТекущийИдВопросаКлиент = "";

	Результат = ПрерватьХодНаСервере();
	Если ЗначениеЗаполнено(Результат.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Результат.Ид, Результат.HTML);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОпросХода

// Один шаг опроса. Push в открытую форму платформа не умеет, поэтому клиент
// по таймеру спрашивает состояние хода и досыпает в страницу только изменения.
&НаКлиенте
Процедура ОбработчикОпросаХода()

	Если Не ОжиданиеХода Тогда
		Возврат;
	КонецЕсли;

	// Страховка: 10 минут без завершения — прекращаем опрос, чтобы кнопка
	// «Отправить» не осталась заблокированной навсегда.
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОпроса > 600000 Тогда
		ОстановитьОпроса();
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Превышено время ожидания ответа (10 минут).'"), "err");
		Возврат;
	КонецЕсли;

	Состояние = ОбновитьХодНаСервере(ВремяНачалаХода);

	// Пузырь «Агент думает…»: показываем, пока нет ни текста, ни вопроса,
	// ни ошибки. При ретраях подключения текст обновляется на каждом опросе.
	Если Состояние.Ретраит Тогда
		ПоказатьПузырьОжидания(ТекстСтатусаРетрая(Состояние.СтатусРетрая));
	ИначеЕсли Не ПустаяСтрока(Состояние.Текст) Или Состояние.ЕстьВопрос
		Или Состояние.Завершено Тогда
		// Ответ начал приходить — пузырь больше не нужен (hidePending ещё и в
		// ПоказатьСообщениеНаСтранице, для страховки).
		СкрытьПузырьОжидания();
	ИначеЕсли ПузырьОжиданияПоказан = Ложь Тогда
		ПоказатьПузырьОжидания(НСтр("ru = 'Агент думает…'"));
	КонецЕсли;

	Если ЗначениеЗаполнено(Состояние.Ид) Тогда
		ПоказатьСообщениеНаСтранице(Состояние.Ид, Состояние.HTML);
	КонецЕсли;

	Если ЗначениеЗаполнено(Состояние.ИдМета) Тогда
		ПоказатьМетуНаСтранице(Состояние.ИдМета, Состояние.Мета);
	КонецЕсли;

	Если Состояние.ЭтоОшибка Тогда
		ОстановитьОпроса();
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице(Состояние.ТекстОшибки, "err");
		Возврат;
	КонецЕсли;

	Если Состояние.ЕстьВопрос Тогда
		ОбновитьСтатусНаСтранице(НСтр("ru = 'Ассистент ждёт ответа на вопрос'"), "warn");

		Если Состояние.ИдВопроса = ТекущийИдВопросаКлиент Тогда
			// Эта карточка уже на странице — ждём клика пользователя,
			// опрос не крутим.
			Возврат;
		КонецЕсли;

		Если Состояние.ИдВопроса = ОтвеченныйИдВопроса Тогда
			// Ответ уже отправлен, а сервер ещё не убрал форму: второй раз
			// карточку не показываем, но опрос продолжаем — иначе ход
			// останется висеть в ожидании до таймаута.
			ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);
			Возврат;
		КонецЕсли;

		ОтвеченныйИдВопроса = "";
		ТекущийИдВопросаКлиент = Состояние.ИдВопроса;
		ТекущийВопрос = Состояние.Вопрос;
		ОтветыНаВопрос = Новый Соответствие;
		ТекущийHTMLВопроса = Состояние.ВопросHTML;
		ПоказатьВопросНаСтранице(ТекущийHTMLВопроса);
		Возврат;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекущийHTMLВопроса) Тогда
		ТекущийHTMLВопроса = "";
		ТекущийВопрос = Неопределено;
		ОтветыНаВопрос = Новый Соответствие;
		СкрытьВопросНаСтранице();
	КонецЕсли;

	Если Состояние.Завершено Тогда
		ОстановитьОпроса();
		ТекущийИдВопросаКлиент = "";
		ОтвеченныйИдВопроса = "";
		ТекущийВопрос = Неопределено;
		ОтветыНаВопрос = Новый Соответствие;
		УстановитьЗанятостьНаСтранице(Ложь);
		ОбновитьСтатусНаСтранице("", "");
		СкрытьПузырьОжидания();
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ОбработчикОпросаХода", 0.5, Истина);

КонецПроцедуры

// Служебная строка ретрая OpenCode («⚠ Retrying in 9s • attempt 10 • ...») —
// короткий статус для пузыря ожидания и шапки.
&НаСервере
Функция ТекстСтатусаРетрая(Знач СтрокаРетрая)

	Части = СтрРазделить(СокрЛП(СтрокаРетрая), "•", Ложь);
	ТекстПопытки = "";
	Для Каждого Часть Из Части Цикл
		Если СтрНайти(Часть, "attempt") > 0 Тогда
			ТекстПопытки = СокрЛП(Часть);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(ТекстПопытки) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Переподключение к модели… %1'"), ТекстПопытки);
	КонецЕсли;

	Возврат НСтр("ru = 'Переподключение к модели…'");

КонецФункции

&НаКлиенте
Процедура ОстановитьОпроса()

	ОжиданиеХода = Ложь;
	ОтключитьОбработчикОжидания("ОбработчикОпросаХода");

КонецПроцедуры

// Старт хода: промпт без ожидания (wait не нужен — ответ добираем опросом).
// Возвращает {ЭтоОшибка, ТекстОшибки, ВремяНачала, Ид, HTML}.
&НаСервере
Функция НачатьХодНаСервере(Знач ТекстПромпта)

	Результат = Новый Структура("ЭтоОшибка, ТекстОшибки, ВремяНачала, Ид, HTML", Истина, "", 0, "", "");

	Ответ = Неопределено;
	ТекстИсключения = "";
	Попытка
		Ответ = a1c_ЧатOpenCodeФоновый.ОтправитьПромптБезОжидания(
			ТекстПромпта, АдресБэкенда, ИдентификаторСессии, Агент);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось отправить запрос: '") + ТекстИсключения;
	ИначеЕсли Ответ.ЭтоОшибка Тогда
		Результат.ТекстОшибки = Ответ.ТекстОшибки;
	Иначе
		Результат.ЭтоОшибка = Ложь;
		Результат.ВремяНачала = Ответ.ВремяНачала;
		Если ЗначениеЗаполнено(Ответ.ИдентификаторСессии) Тогда
			ИдентификаторСессии = Ответ.ИдентификаторСессии;
		КонецЕсли;
	КонецЕсли;

	Если Результат.ЭтоОшибка Тогда
		Индекс = ДобавитьСообщение("error", Результат.ТекстОшибки);
		Результат.Ид = ИдСообщения(Индекс);
		Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		Возврат Результат;
	КонецЕсли;

	// Промпт попал на сервер — теперь его можно показать в ленте.
	Индекс = ДобавитьСообщение("user", ТекстПромпта);
	Результат.Ид = ИдСообщения(Индекс);
	Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);

	Возврат Результат;

КонецФункции

// Шаг опроса на сервере: текст ответа, вопрос модели, завершение хода.
// Возвращает {ЭтоОшибка, ТекстОшибки, Завершено, ЕстьВопрос, ИдВопроса,
// ВопросHTML, Ид, HTML, ИдМета, Мета}.
&НаСервере
Функция ОбновитьХодНаСервере(Знач ВремяНачала)

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("ЕстьВопрос", Ложь);
	Результат.Вставить("ИдВопроса", "");
	Результат.Вставить("ВопросHTML", "");
	Результат.Вставить("Вопрос", Неопределено);
	Результат.Вставить("Ид", "");
	Результат.Вставить("HTML", "");
	Результат.Вставить("ИдМета", "");
	Результат.Вставить("Мета", "");
	Результат.Вставить("Текст", "");
	Результат.Вставить("Ретраит", Ложь);
	Результат.Вставить("СтатусРетрая", "");

	Состояние = Неопределено;
	ТекстИсключения = "";
	Попытка
		Состояние = a1c_ЧатOpenCodeФоновый.ПолучитьСостояниеХода(
			АдресБэкенда, ИдентификаторСессии, ВремяНачала);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
	КонецПопытки;

	Если Состояние = Неопределено Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = НСтр("ru = 'Ошибка опроса состояния хода: '") + ТекстИсключения;
	ИначеЕсли Состояние.ЭтоОшибка Тогда
		Результат.ЭтоОшибка = Истина;
		Результат.ТекстОшибки = Состояние.ТекстОшибки;
	Иначе
		// Поля, которые обработчик опроса читает из этого результата: без них
		// «Поле объекта не обнаружено» (например, на Ретраит/СтатусРетрая).
		Результат.Текст = Состояние.Текст;
		Результат.Ретраит = Состояние.Ретраит;
		Результат.СтатусРетрая = Состояние.СтатусРетрая;
	КонецЕсли;

	Если Результат.ЭтоОшибка Тогда
		Индекс = ДобавитьСообщение("error", Результат.ТекстОшибки);
		Результат.Ид = ИдСообщения(Индекс);
		Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		Возврат Результат;
	КонецЕсли;

	// Пустой пузырь не создаём: строка assistant появляется с первым текстом.
	Если Не ПустаяСтрока(Состояние.Текст) Тогда
		Индекс = ИндексТекущегоОтвета();
		Если Индекс < 0 Тогда
			Индекс = ДобавитьСообщение("assistant", Состояние.Текст);
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		ИначеЕсли ИсторияДиалога[Индекс].Текст <> Состояние.Текст Тогда
			// Текст не изменился — HTML не пересобираем: это лишняя работа
			// каждые полсекунды, а страница и так уже показывает этот текст.
			ИсторияДиалога[Индекс].Текст = Состояние.Текст;
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		КонецЕсли;
	КонецЕсли;

	// Вопрос модели блокирует ход: пока он не отвечен, ход не завершён.
	Если Состояние.Вопрос <> Неопределено Тогда
		Результат.ЕстьВопрос = Истина;
		Результат.ИдВопроса = ?(Состояние.Вопрос.Свойство("id"), Состояние.Вопрос.id, "");
		Результат.Вопрос = Состояние.Вопрос;
		Результат.ВопросHTML = СформироватьHTMLВопроса(Состояние.Вопрос);
		ТекущийИдВопроса = Результат.ИдВопроса;
	КонецЕсли;

	Если Состояние.Завершено Тогда
		Результат.Завершено = Истина;

		Если Не ПустаяСтрока(Состояние.ОшибкаМодели) Тогда
			// OpenCode присылает служебные строки вида «⚠ Retrying in 9s •
			// attempt 10 • ECONNREFUSED: ...» — превращаем их в понятный текст.
			Индекс = ДобавитьСообщение("error", ОформитьОшибкуМодели(Состояние.ОшибкаМодели));
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		ИначеЕсли ПустаяСтрока(Состояние.Текст) Тогда
			Текст = НСтр("ru = 'Модель не вернула текстового ответа (только служебные шаги). Попробуйте ещё раз.'");
			Индекс = ДобавитьСообщение("error", Текст);
			Результат.Ид = ИдСообщения(Индекс);
			Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);
		Иначе
			Индекс = ИндексТекущегоОтвета();
			Мета = СформироватьМетаинформацию(Состояние);
			Если Индекс >= 0 И Не ПустаяСтрока(Мета) Тогда
				ИсторияДиалога[Индекс].Метаинформация = Мета;
				Результат.ИдМета = ИдСообщения(Индекс);
				Результат.Мета = Мета;
			КонецЕсли;
		КонецЕсли;

		ТекущийИдВопроса = "";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ответ на вопрос модели по всем полям сразу: Ответы — Соответствие
// «ключ поля → текст». Форму перечитываем с сервера: в ней же лежат ключи
// полей, которым нужно ответить (иначе форма останется неотвеченной и ход
// застрянет). Возвращает {Успех, ИдФормы, Ид, HTML}.
&НаСервере
Функция ОтветитьНаВопросНаСервере(Знач Ответы)

	Результат = Новый Структура("Успех, ИдФормы, Ид, HTML", Ложь, "", "", "");

	// На всякий случай принимаем и Структуру: клиент шлёт Соответствие.
	Если ТипЗнч(Ответы) = Тип("Структура") Тогда
		Карта = Новый Соответствие;
		Для Каждого Элемент Из Ответы Цикл
			Карта.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		Ответы = Карта;
	КонецЕсли;
	Если ТипЗнч(Ответы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Вопросы = a1c_ЧатOpenCodeФоновый.ПолучитьОжидающиеВопросы(АдресБэкенда, ИдентификаторСессии);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если Вопросы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Вопрос = Неопределено;
	Для Каждого Кандидат Из Вопросы Цикл
		Если Кандидат.id = ТекущийИдВопроса Тогда
			Вопрос = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Вопрос = Неопределено Тогда
		Вопрос = Вопросы[0];
	КонецЕсли;

	// Отвечать нужно всем полям формы сразу. Если хотя бы одно пустое —
	// не отправляем ничего: иначе форма останется pending и ход зависнет.
	ОтветыФормы = Новый Соответствие;
	СтрокиЛенты = Новый Массив;
	Для Каждого Поле Из Вопрос.Поля Цикл
		Если ПустаяСтрока(Поле.key) Тогда
			Продолжить;
		КонецЕсли;

		Текст = Ответы.Получить(Поле.key);
		Если Текст = Неопределено Или ПустаяСтрока(Текст) Тогда
			Возврат Результат;
		КонецЕсли;

		ОтветыФормы.Вставить(Поле.key, Текст);
		Заголовок = ?(ПустаяСтрока(Поле.title), Поле.key, Поле.title);
		СтрокиЛенты.Добавить(Заголовок + ": " + Текст);
	КонецЦикла;

	Если ОтветыФормы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Успех = a1c_ЧатOpenCodeФоновый.ОтветитьНаВопросСОтветами(
			АдресБэкенда, ИдентификаторСессии, Вопрос.id, ОтветыФормы);
	Исключение
		Успех = Ложь;
	КонецПопытки;

	Если Не Успех Тогда
		Возврат Результат;
	КонецЕсли;

	ТекущийИдВопроса = "";

	Результат.Успех = Истина;
	Результат.ИдФормы = Вопрос.id;

	Индекс = ДобавитьСообщение("user", СтрСоединить(СтрокиЛенты, "; "));
	Результат.Ид = ИдСообщения(Индекс);
	Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);

	Возврат Результат;

КонецФункции

// Прерывание хода: POST /interrupt, ошибка в ленту, опрос останавливает клиент.
&НаСервере
Функция ПрерватьХодНаСервере()

	Результат = Новый Структура("Ид, HTML", "", "");

	Попытка
		a1c_ЧатOpenCodeФоновый.ПрерватьСессиюПоАдресу(АдресБэкенда, ИдентификаторСессии);
	Исключение
		// Не критично: ход всё равно оборвётся по таймауту сервера.
	КонецПопытки;

	Индекс = ДобавитьСообщение("error", НСтр("ru = 'Ход прерван пользователем.'"));
	Результат.Ид = ИдСообщения(Индекс);
	Результат.HTML = СформироватьHTMLСообщения(ИсторияДиалога[Индекс], Результат.Ид);

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ОчиститьДиалогНаСервере()

	ИсторияДиалога.Очистить();
	ТекущийИдВопроса = "";

КонецПроцедуры

// Смена агента: новый ход пойдёт новым агентом, текущая сессия сбрасывается —
// агент задаётся при создании сессии OpenCode.
&НаСервере
Функция СменитьАгентаНаСервере(Знач ИдентификаторАгента)

	Если СтрокаАгентаПоИдентификатору(ИдентификаторАгента) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Агент = ИдентификаторАгента;
	ИдентификаторСессии = "";
	СохранитьНастройкиФормы();

	Возврат СформироватьШапкуHTML("", "");

КонецФункции

// Смена адреса сервера (только разработчик — как в V1/V2). Агенты
// перечитываются, сессия сбрасывается: это уже другой сервер.
// Возвращает {Шапка, ТекстСтатуса, ВидСтатуса}; пустая Шапка — менять нечего.
&НаСервере
Функция СменитьАдресНаСервере(Знач НовыйАдрес)

	Результат = Новый Структура("Шапка, ТекстСтатуса, ВидСтатуса", "", "", "");

	Если Не ЭтоРазработчик() Или ПустаяСтрока(НовыйАдрес) Тогда
		Возврат Результат;
	КонецЕсли;

	АдресБэкенда = НовыйАдрес;
	ИдентификаторСессии = "";
	ТекстОшибки = ЗаполнитьСписокАгентов();
	СохранитьНастройкиФормы();

	Результат.Шапка = СформироватьШапкуHTML("", "");
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.ТекстСтатуса = ТекстОшибки;
		Результат.ВидСтатуса = "warn";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Агенты

// Строка таблицы агентов по идентификатору. Обход циклом, а не
// ТаблицаЗначений.Найти: на живой базе метод давал «Метод объекта не
// обнаружен (Найти)» — лишний риск на ровном месте.
&НаСервере
Функция СтрокаАгентаПоИдентификатору(Знач Идентификатор)

	Искомый = СокрЛП(Идентификатор);
	Если ПустаяСтрока(Искомый) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого СтрокаАгента Из Агенты Цикл
		Если СокрЛП(СтрокаАгента.Идентификатор) = Искомый Тогда
			Возврат СтрокаАгента;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Агенты сервера OpenCode: только mode="primary" и не hidden.
// Возвращает текст ошибки (пусто, если всё хорошо).
&НаСервере
Функция ЗаполнитьСписокАгентов()

	Агенты.Очистить();
	СписокАгентов = Неопределено;
	ТекстОшибки = "";

	// Первый HTTP-запрос в холодном сеансе иногда не доходит до сервера —
	// вторая попытка лечит это без перезапуска формы.
	Для НомерПопытки = 1 По 2 Цикл
		Попытка
			СписокАгентов = a1c_ЧатOpenCodeФоновый.ПолучитьАгенты(АдресБэкенда);
			// При ошибке модуль возвращает массив с одной строкой диагностики
			// (код HTTP и тело ответа) — не глотаем её молча.
			Если СписокАгентов.Количество() > 0 И ТипЗнч(СписокАгентов[0]) = Тип("Строка") Тогда
				ТекстОшибки = СписокАгентов[0];
				СписокАгентов = Неопределено;
			Иначе
				ТекстОшибки = "";
				Прервать;
			КонецЕсли;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			СписокАгентов = Неопределено;
		КонецПопытки;
	КонецЦикла;

	Если СписокАгентов = Неопределено Или СписокАгентов.Количество() = 0 Тогда
		Строка = Агенты.Добавить();
		Строка.Идентификатор = "assistant";
		Строка.Имя = НСтр("ru = 'Ассистент'");
	Иначе
		Для Каждого СтрокаАгента Из СписокАгентов Цикл
			Строка = Агенты.Добавить();
			Строка.Идентификатор = СтрокаАгента.id;
			Строка.Имя = СтрокаАгента.name;
		КонецЦикла;
	КонецЕсли;

	// Дефолтный агент: один в списке — он; несколько и нет assistant — первый.
	ДефолтАгента = "";
	Если Агенты.Количество() > 0 Тогда
		ДефолтАгента = Агенты[0].Идентификатор;
		Для Каждого СтрокаАгента Из Агенты Цикл
			Если СтрокаАгента.Идентификатор = "assistant" Тогда
				ДефолтАгента = "assistant";
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Текущее значение обязано быть из списка, иначе сброс на дефолт.
	Если Не ЗначениеЗаполнено(Агент) Или СтрокаАгентаПоИдентификатору(Агент) = Неопределено Тогда
		Агент = ДефолтАгента;
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

#КонецОбласти

#Область ИсторияДиалога

&НаСервере
Функция ДобавитьСообщение(Знач Роль, Знач Текст)

	Строка = ИсторияДиалога.Добавить();
	Строка.Роль = Роль;
	Строка.Текст = Текст;
	Строка.Метаинформация = "";

	Возврат ИсторияДиалога.Количество() - 1;

КонецФункции

// Последняя строка assistant без метаинформации — это пузырь текущего хода.
&НаСервере
Функция ИндексТекущегоОтвета()

	Индекс = ИсторияДиалога.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ИсторияДиалога[Индекс].Роль = "assistant"
			И ПустаяСтрока(ИсторияДиалога[Индекс].Метаинформация) Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат -1;

КонецФункции

// «модель • токены • секунды» для подписи пузыря ответа.
&НаСервереБезКонтекста
Функция СформироватьМетаинформацию(Знач Состояние)

	Части = Новый Массив;
	Если Не ПустаяСтрока(Состояние.Модель) Тогда
		Части.Добавить(Состояние.Модель);
	КонецЕсли;
	Если Состояние.Токены > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 токенов'"), Строка(Состояние.Токены)));
	КонецЕсли;
	Если Состояние.Секунды > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 с'"), Формат(Состояние.Секунды, "ЧДЦ=1; ЧГ=0")));
	КонецЕсли;

	Возврат СтрСоединить(Части, " • ");

КонецФункции

#КонецОбласти

#Область Страница

// Документ страницы или Неопределено, если поле ещё не отрисовано.
// Проверка готовности не нужна: метод работает и во время загрузки.
&НаКлиенте
Функция ПолучитьДокументСтраницы()

	Попытка
		Возврат Элементы.ПанельHTML.Документ;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Сторож загрузки страницы: раз в секунду проверяет, что в документе уже есть
// поле ввода, и только тогда включает штатную готовность (повторно применяя
// статус, занятость и карточку вопроса). Страховка от движков, где
// ДокументСформирован не приходит. Больше 30 секунд не ждём.
&НаКлиенте
Процедура ПроверитьГотовностьСтраницы()

	Если СтраницаГотова Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
		Возврат;
	КонецЕсли;

	ПопыткиГотовности = ПопыткиГотовности + 1;

	Документ = ПолучитьДокументСтраницы();
	Загружено = Ложь;
	Если Документ <> Неопределено Тогда
		Попытка
			Загружено = (Документ.getElementById("prompt") <> Неопределено);
		Исключение
			Загружено = Ложь;
		КонецПопытки;
	КонецЕсли;

	Если Загружено Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
		ПанельHTMLДокументСформирован(Элементы.ПанельHTML);
	ИначеЕсли ПопыткиГотовности >= 30 Тогда
		ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
	Иначе
		// Обработчик подключён как однократный — перевзводим до победы.
		ПодключитьОбработчикОжидания("ПроверитьГотовностьСтраницы", 1, Истина);
	КонецЕсли;

КонецПроцедуры

// Окно страницы (объект) — переменная ОкноСтраницы. В тонком клиенте под Windows поле рисует движок IE:
// у документа там нет defaultView, зато есть parentWindow; в веб-клиенте и
// клиенте на WebKit — наоборот. Пробуем оба, чтобы не зависеть от клиента.
&НаКлиенте
Функция ПолучитьОкноСтраницы()

	Если Не СтраницаГотова Тогда
		Возврат Неопределено;
	КонецЕсли;

	Документ = ПолучитьДокументСтраницы();
	Если Документ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ОкноСтраницы = Документ.defaultView;
		Если ОкноСтраницы <> Неопределено Тогда
			Возврат ОкноСтраницы;
		КонецЕсли;
	Исключение
		// Свойства нет — движок IE, ниже пробуем parentWindow.
	КонецПопытки;

	Попытка
		Возврат Документ.parentWindow;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПоказатьСообщениеНаСтранице(Знач Ид, Знач HTML)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.upsertMessage(Ид, HTML);
		// Настоящее сообщение пришло — «Агент думает…» больше не нужен.
		Если Ид <> "pending" Тогда
			ОкноСтраницы.hidePending();
			ПузырьОжиданияПоказан = Ложь;
		КонецЕсли;
	Исключение
		// Страница ещё не загрузилась или DOM недоступен: рисуем заново целиком.
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

// Пузырь «Агент думает…» в ленте: показывается сразу после отправки и живёт,
// пока модель не начала отвечать (или не выдала ошибку). Текст обновляется на
// каждом опросе — при ретраях подключения показывает «Переподключение… N».
&НаКлиенте
Процедура ПоказатьПузырьОжидания(Знач Текст)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.showPending(Текст);
	Исключение
		// Страница ещё не загрузилась: пузырь покажет следующий шаг опроса.
	КонецПопытки;

	ПузырьОжиданияПоказан = Истина;

КонецПроцедуры

&НаКлиенте
Процедура СкрытьПузырьОжидания()

	Если ПузырьОжиданияПоказан = Ложь Тогда
		Возврат;
	КонецЕсли;

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.hidePending();
	Исключение
		// Страница ещё не загрузилась: пузырь и так не виден.
	КонецПопытки;

	ПузырьОжиданияПоказан = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМетуНаСтранице(Знач Ид, Знач Мета)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.setMeta(Ид, Мета);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросНаСтранице(Знач HTML)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.showQuestion(HTML);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СкрытьВопросНаСтранице()

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.hideQuestion();
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусНаСтранице(Знач Текст, Знач Вид)

	СтатусТекст = Текст;
	СтатусВид = Вид;

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.setStatus(Текст, Вид);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗанятостьНаСтранице(Знач Занято)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.setBusy(Занято);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьШапкуНаСтранице(Знач HTML)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.setHeader(HTML);
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛентуНаСтранице()

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.clearFeed();
		ОкноСтраницы.hidePending();
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

	ПузырьОжиданияПоказан = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПолеВводаНаСтранице()

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОкноСтраницы.clearPrompt();
	Исключение
		ПерерисоватьСтраницу();
	КонецПопытки;

КонецПроцедуры

// Значение поля страницы (prompt, qfree) или Неопределено, если прочитать
// не удалось: тогда вызывающий показывает обычный диалог ввода 1С.
&НаКлиенте
Функция ПрочитатьИзСтраницы(Знач ИдЭлемента)

	ОкноСтраницы = ПолучитьОкноСтраницы();
	Если ОкноСтраницы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ОкноСтраницы.document.getElementById(ИдЭлемента).value;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Полная перерисовка — только аварийный путь (страница ещё не загрузилась).
// Штатно страница не перерисовывается: иначе сбрасывается прокрутка.
&НаКлиенте
Процедура ПерерисоватьСтраницу()

	СтраницаГотова = Ложь;
	ПопыткиГотовности = 0;
	ПанельHTML = СформироватьСтраницу(СтатусТекст, СтатусВид);
	ОтключитьОбработчикОжидания("ПроверитьГотовностьСтраницы");
	ПодключитьОбработчикОжидания("ПроверитьГотовностьСтраницы", 1, Истина);

КонецПроцедуры

&НаСервере
Функция СформироватьСтраницу(Знач ТекстСтатуса = "", Знач ВидСтатуса = "")

	Каркас = МакетТекст("КаркасСтраницы");
	Если ПустаяСтрока(Каркас) Тогда
		Возврат "<html><body><p>" + НСтр("ru = 'Не найден макет страницы чата.'") + "</p></body></html>";
	КонецЕсли;

	Страница = СтрЗаменить(Каркас, "{{STYLES}}", МакетТекст("СтилиСтраницы"));
	Страница = СтрЗаменить(Страница, "{{SCRIPT}}", МакетТекст("СкриптСтраницы"));
	Страница = СтрЗаменить(Страница, "{{HEADER}}", СформироватьШапкуHTML(ТекстСтатуса, ВидСтатуса));
	Страница = СтрЗаменить(Страница, "{{FEED}}", СформироватьЛентуHTML());
	Страница = СтрЗаменить(Страница, "{{COMPOSER}}", СформироватьКомпозерHTML());

	Возврат Страница;

КонецФункции

// Короткий хеш сборки расширения (ExtVersion.txt → a1c_ИнструментДерево).
// Пусто, если объекта нет или ответ не разобрался — шапка без версии.
&НаСервереБезКонтекста
Функция ВерсияСборки()

	Попытка
		Данные = Обработки.a1c_ИнструментДерево.ВерсияРасширения();
	Исключение
		// Расширение без объекта версии — не повод ломать форму.
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	// Ответ — JSON {"version":"<хеш>"}; разбирать полноценно ради одного поля
	// не нужно.
	Двоеточие = СтрНайти(Данные, ":");
	Если Двоеточие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хеш = СтрЗаменить(Сред(Данные, Двоеточие + 1), """", "");
	Хеш = СокрЛП(СтрЗаменить(Хеш, "}", ""));
	Если СтрДлина(Хеш) > 7 Тогда
		Хеш = Лев(Хеш, 7);
	КонецЕсли;

	Возврат Хеш;

КонецФункции

&НаСервере
Функция СформироватьШапкуHTML(Знач ТекстСтатуса = "", Знач ВидСтатуса = "")

	Части = Новый Массив;

	Части.Добавить("<div>");
	Части.Добавить("<span class='title'>OpenCode</span>");

	Если ЭтоРазработчик() Тогда
		Части.Добавить("<a class='addr' href='#act:backend' title='"
			+ ЭкранироватьHTML(НСтр("ru = 'Изменить адрес сервера'")) + "'>"
			+ ЭкранироватьHTML(АдресБэкенда) + "</a>");
	Иначе
		Части.Добавить("<span class='addr'>" + ЭкранироватьHTML(АдресБэкенда) + "</span>");
	КонецЕсли;

	Если ПустаяСтрока(ТекстСтатуса) Тогда
		Части.Добавить("<span id='status' class='status' style='display:none'></span>");
	Иначе
		Части.Добавить("<span id='status' class='status " + ЭкранироватьHTML(ВидСтатуса) + "'>"
			+ ЭкранироватьHTML(ТекстСтатуса) + "</span>");
	КонецЕсли;

	// Сборка видна в шапке: по ней сразу понятно, загрузилось ли расширение.
	Версия = ВерсияСборки();
	Если Не ПустаяСтрока(Версия) Тогда
		Части.Добавить("<span class='ver' title='"
			+ ЭкранироватьHTML(НСтр("ru = 'Коммит, из которого собрано расширение'")) + "'>"
			+ ЭкранироватьHTML(Версия) + "</span>");
	КонецЕсли;

	Части.Добавить("</div>");

	Части.Добавить("<div class='row'>");
	Для Каждого СтрокаАгента Из Агенты Цикл
		Класс = ?(СтрокаАгента.Идентификатор = Агент, "pill on", "pill");
		Части.Добавить("<a class='" + Класс + "' href='#act:agent|"
			+ ЭкранироватьHTML(СтрокаАгента.Идентификатор) + "'>"
			+ ЭкранироватьHTML(СтрокаАгента.Имя) + "</a>");
	КонецЦикла;
	Части.Добавить("<a class='btn' href='#act:stop'>" + НСтр("ru = 'Остановить'") + "</a>");
	Части.Добавить("<a class='btn' href='#act:clear'>" + НСтр("ru = 'Очистить'") + "</a>");
	Части.Добавить("</div>");

	Возврат СтрСоединить(Части);

КонецФункции

&НаСервере
Функция СформироватьЛентуHTML()

	Части = Новый Массив;
	Индекс = 0;
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		Ид = ИдСообщения(Индекс);
		Части.Добавить(СформироватьHTMLСообщения(Сообщение, Ид));
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат СтрСоединить(Части);

КонецФункции

&НаСервере
Функция СформироватьКомпозерHTML()

	Подсказка = НСтр("ru = 'Спросите агента: Enter — отправить, Shift+Enter — новая строка'");

	Возврат "<textarea id='prompt' class='prompt' placeholder='" + ЭкранироватьHTML(Подсказка)
		+ "' onkeydown='onPromptKey(event)'></textarea>"
		+ "<a class='btn primary send' id='send' href='#act:send'>"
		+ НСтр("ru = 'Отправить'") + "</a>";

КонецФункции

&НаСервере
Функция СформироватьHTMLСообщения(Знач Сообщение, Знач Ид)

	Если Сообщение.Роль = "user" Тогда
		Класс = "user";
		Подпись = НСтр("ru = 'Вы'");
	ИначеЕсли Сообщение.Роль = "assistant" Тогда
		Класс = "assistant";
		Подпись = НСтр("ru = 'ИИ ассистент'");
	Иначе
		Класс = "error";
		Подпись = НСтр("ru = 'Ошибка'");
	КонецЕсли;

	МетаHTML = "";
	Если Не ПустаяСтрока(Сообщение.Метаинформация) Тогда
		МетаHTML = "<div class='meta'>" + ЭкранироватьHTML(Сообщение.Метаинформация) + "</div>";
	КонецЕсли;

	Возврат "<div class='msg " + Класс + "' id='" + Ид + "'>"
		+ "<div class='who'>" + Подпись + "</div>"
		+ "<div class='content'>" + ОбработатьТекстСообщения(Сообщение.Текст) + "</div>"
		+ МетаHTML
		+ "</div>";

КонецФункции

// Карточка вопроса: у каждого поля свои варианты и своё поле свободного
// ответа, кнопка «Ответить» одна — она отправляет ответы всех полей разом.
// Ответы (Соответствие «ключ → текст») нужны, чтобы после перерисовки страницы
// подсветить уже выбранное.
&НаСервере
// Карточка вопроса: одна вкладка на каждое поле формы (вкладки — только
// навигация, отправка ответов не меняется: один reply со всеми ключами).
// Точки на вкладках и счётчик «Осталось ответить» показывают, какие поля ещё
// не отвечены; пересобирается карточка целиком после каждого действия.
Функция СформироватьHTMLВопроса(Знач Вопрос, Знач Ответы = Неопределено)

	Если Ответы = Неопределено Или (ТипЗнч(Ответы) <> Тип("Соответствие")
		И ТипЗнч(Ответы) <> Тип("Структура")) Тогда
		Ответы = Новый Соответствие;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить("<div class='q-card'>");

	ЗаголовокФормы = ?(Вопрос.Свойство("title"), Вопрос.title, "");
	// «Questions» — служебный заголовок формы, пользователю он не нужен.
	Если Не ПустаяСтрока(ЗаголовокФормы) И НРег(ЗаголовокФормы) <> "questions" Тогда
		Части.Добавить("<div class='q-title'>" + ЭкранироватьHTML(ЗаголовокФормы) + "</div>");
	КонецЕсли;

	// Вкладки: метка — title поля, точка — поле ещё не отвечено.
	Части.Добавить("<div class='q-tabs'>");
	ИндексПоля = 0;
	Для Каждого Поле Из Вопрос.Поля Цикл
		Ключ = ?(ПустаяСтрока(Поле.key), "q" + Строка(ИндексПоля), Поле.key);
		Выбрано = Ответы.Получить(Ключ);
		Если Выбрано = Неопределено Тогда
			Выбрано = "";
		КонецЕсли;

		МеткаВкладки = ?(Не ПустаяСтрока(Поле.title), Поле.title, "q" + Строка(ИндексПоля));
		КлассВкладки = ?(ИндексПоля = 0, "q-tab on", "q-tab");
		Части.Добавить("<a class='" + КлассВкладки + "' href='#act:tab|" + Строка(ИндексПоля) + "'>"
			+ ЭкранироватьHTML(МеткаВкладки));
		Если ПустаяСтрока(Выбрано) Тогда
			Части.Добавить("<span class='q-dot'></span>");
		КонецЕсли;
		Части.Добавить("</a>");

		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;
	Части.Добавить("</div>");

	// Панели: одна на поле, видна только активная.
	ИндексПоля = 0;
	Для Каждого Поле Из Вопрос.Поля Цикл
		Ключ = ?(ПустаяСтрока(Поле.key), "q" + Строка(ИндексПоля), Поле.key);
		Выбрано = Ответы.Получить(Ключ);
		Если Выбрано = Неопределено Тогда
			Выбрано = "";
		КонецЕсли;

		Части.Добавить("<div class='q-panel" + ?(ИндексПоля = 0, " on", "") + "'>");

		Если Не ПустаяСтрока(Поле.title) Тогда
			Части.Добавить("<div class='q-label'>" + ЭкранироватьHTML(Поле.title) + "</div>");
		КонецЕсли;
		Если Не ПустаяСтрока(Поле.description) Тогда
			Части.Добавить("<div class='q-desc'>" + ЭкранироватьHTML(Поле.description) + "</div>");
		КонецЕсли;

		// Варианты — в столбик: каждая строка на всю ширину панели.
		Если Поле.Варианты.Количество() > 0 Тогда
			Части.Добавить("<div id='opts_" + Строка(ИндексПоля) + "'>");
			ИндексВарианта = 0;
			Для Каждого Вариант Из Поле.Варианты Цикл
				Метка = ?(Не ПустаяСтрока(Вариант.label), Вариант.label, Вариант.value);
				Класс = ?(Вариант.value = Выбрано, "opt on", "opt");
				Части.Добавить("<a class='" + Класс + "' href='#act:opt|" + Строка(ИндексПоля) + "|"
					+ Строка(ИндексВарианта) + "'>" + ЭкранироватьHTML(Метка) + "</a>");
				ИндексВарианта = ИндексВарианта + 1;
			КонецЦикла;
			Части.Добавить("</div>");
		КонецЕсли;

		Части.Добавить("<input id='qfree_" + Строка(ИндексПоля) + "' class='q-input' type='text'"
			+ " placeholder='" + ЭкранироватьHTML(НСтр("ru = 'Свой ответ'")) + "'"
			+ " onkeydown='onQuestionKey(event)'>");

		Части.Добавить("</div>");
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;

	// Одна кнопка на все поля: собирает ответы и шлёт один reply.
	Осталось = 0;
	ИндексПоля = 0;
	Для Каждого Поле Из Вопрос.Поля Цикл
		Ключ = ?(ПустаяСтрока(Поле.key), "q" + Строка(ИндексПоля), Поле.key);
		Текст = Ответы.Получить(Ключ);
		Если ПустаяСтрока(?(Текст = Неопределено, "", Текст)) Тогда
			Осталось = Осталось + 1;
		КонецЕсли;
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;

	Части.Добавить("<div class='q-free'>");
	Части.Добавить("<a class='btn primary' id='answer' href='#act:answer'>"
		+ НСтр("ru = 'Ответить'") + "</a>");
	Части.Добавить("<span id='qleft' class='status " + ?(Осталось > 0, "warn", "") + "' style='margin-left:8px'>");
	Если Осталось > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Осталось ответить: %1'"), Осталось));
	Иначе
		Части.Добавить(НСтр("ru = 'Все поля отвечены'"));
	КонецЕсли;
	Части.Добавить("</span>");
	Части.Добавить("</div>");

	Части.Добавить("</div>");

	Возврат СтрСоединить(Части);

КонецФункции

&НаСервере
Функция МакетТекст(Знач ИмяМакета)

	Попытка
		Возврат Обработки.a1c_ЧатOpenCodeV3.ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ИдСообщения(Знач Индекс)

	Возврат "m" + Строка(Индекс);

КонецФункции

#КонецОбласти

#Область ТекстСообщений

&НаСервере
Функция ОбработатьТекстСообщения(Текст)

	ТипКонтента = ОпределитьТипКонтента(Текст);

	Если ТипКонтента = "HTML" Тогда
		Возврат СтрШаблон("<pre><code class='language-html'>%1</code></pre>",
			ЭкранироватьHTML(Текст));
	ИначеЕсли ТипКонтента = "JSON" Тогда
		Возврат СтрШаблон("<pre><code class='language-json'>%1</code></pre>",
			ЭкранироватьHTML(Текст));
	ИначеЕсли ТипКонтента = "Markdown" Тогда
		Возврат a1c_МаркдаунПарсер.ПреобразоватьВHTML(Текст);
	Иначе
		ТекстHTML = ЭкранироватьHTML(Текст);
		Возврат СтрЗаменить(ТекстHTML, Символы.ПС, "<br>");
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьТипКонтента(Знач Текст)

	ТекстОбрезанный = СокрЛП(Текст);

	Если ЭтоПолныйHTMLДокумент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Если ЭтоJSON(ТекстОбрезанный) Тогда
		Возврат "JSON";
	КонецЕсли;

	Если ЭтоMarkdown(Текст) Тогда
		Возврат "Markdown";
	КонецЕсли;

	Если ЭтоHTMLФрагмент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Возврат "PlainText";

КонецФункции

&НаСервере
Функция ЭтоПолныйHTMLДокумент(Текст)

	ТекстНижний = НРег(Текст);

	Если СтрНачинаетсяС(ТекстНижний, "<!doctype html") Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(ТекстНижний, "<html")
		И СтрНайти(ТекстНижний, "</html>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЭтоJSON(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Лев(Текст, 1);
	ПоследнийСимвол = Прав(Текст, 1);

	ЭтоОбъект = (ПервыйСимвол = "{" И ПоследнийСимвол = "}");
	ЭтоМассив = (ПервыйСимвол = "[" И ПоследнийСимвол = "]");

	Если НЕ (ЭтоОбъект Или ЭтоМассив) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЭтоHTMLФрагмент(Текст)

	ТекстНижний = НРег(Текст);

	НачинаетсяСТега = СтрНачинаетсяС(ТекстНижний, "<div")
		Или СтрНачинаетсяС(ТекстНижний, "<table")
		Или СтрНачинаетсяС(ТекстНижний, "<section")
		Или СтрНачинаетсяС(ТекстНижний, "<article");

	ЗаканчиваетсяТегом = СтрЗаканчиваетсяНа(ТекстНижний, "</div>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</table>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</section>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</article>");

	Возврат НачинаетсяСТега И ЗаканчиваетсяТегом;

КонецФункции

&НаСервере
Функция ЭтоMarkdown(Знач Текст)

	Возврат a1c_МаркдаунПарсер.ЭтоMarkdown(Текст);

КонецФункции

#КонецОбласти

#Область НастройкиФормы

&НаСервере
Функция ПолучитьКлючНастроек()

	Возврат "a1c_ЧатOpenCodeV3_НастройкиФормы";

КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, "НастройкиФормы");
	Исключение
		Настройки = Неопределено;
	КонецПопытки;

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	// Настройки версионированы: при старой версии адрес не читаем — он мог
	// указывать на устаревший сервер (прямой :4040 вместо gateway :9020).
	ВерсияНастроек = 1;
	Если Настройки.Свойство("ВерсияНастроек") Тогда
		ВерсияНастроек = Число(Настройки.ВерсияНастроек);
	КонецЕсли;

	Если ВерсияНастроек >= 2 И Настройки.Свойство("АдресБэкенда")
		И ЗначениеЗаполнено(Настройки.АдресБэкенда) Тогда
		АдресБэкенда = Настройки.АдресБэкенда;
	КонецЕсли;

	Если Настройки.Свойство("Агент") И ЗначениеЗаполнено(Настройки.Агент) Тогда
		Агент = Настройки.Агент;
	Иначе
		Агент = "assistant";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Настройки = Новый Структура;
	Настройки.Вставить("ВерсияНастроек", 2);
	Настройки.Вставить("АдресБэкенда", ?(ЭтоРазработчик(), АдресБэкенда, АдресБэкендаПоУмолчанию()));
	Настройки.Вставить("Агент", Агент);

	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, "НастройкиФормы", Настройки);
	Исключение
		// Игнорируем ошибки сохранения настроек в расширении
	КонецПопытки;

КонецПроцедуры

